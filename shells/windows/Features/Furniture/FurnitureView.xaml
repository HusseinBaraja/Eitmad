<UserControl x:Class="Eitmad.WindowsShell.Features.Furniture.FurnitureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources></UserControl.Resources>
    <Grid>
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Title="الأثاث" Subtitle="منتجات ثابتة ومقاسات يحددها المدير">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Height="46" Click="AddFurnitureClick" automation:AutomationProperties.Name="إضافة منتج" Content="إضافة منتج" controls:ControlOptions.Icon="{StaticResource IconPlus}" />
                </StackPanel>
            </controls:PageHeader>
            <ScrollViewer Grid.Row="1" Padding="28,20,28,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,14">
                        <StackPanel>
                            <controls:FormField Label="البحث">
                                <TextBox x:Name="FurnitureSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن أثاث" Style="{StaticResource SearchInput}" />
                            </controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الفئة">
                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية فئة الأثاث" />
                            </controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الحالة">
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية حالة الأثاث" />
                            </controls:FormField>
                        </StackPanel>
                    </layout:AdaptiveFieldsPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:OperationsTable Grid.Row="1" ItemsSource="{Binding VisibleFurniture}" SelectedValuePath="Id" MaxHeight="460" automation:AutomationProperties.Name="الصورة">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="الصورة" Width="86" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <Border x:Name="ContrastCell1" Width="58" Height="50" CornerRadius="8" Background="#EFE2D4" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                            <Grid>
                                                                <Rectangle Fill="#F5EADF" />
                                                                <Canvas x:Name="WardrobeThumb" Width="44" Height="38" Visibility="Collapsed">
                                                                    <Rectangle Canvas.Left="7" Canvas.Top="3" Width="30" Height="31" RadiusX="2" Fill="#9A6237" />
                                                                    <Line X1="22" X2="22" Y1="5" Y2="32" Stroke="#F0D2AE" StrokeThickness="1" />
                                                                    <Ellipse Canvas.Left="18" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" />
                                                                    <Ellipse Canvas.Left="24" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" />
                                                                </Canvas>
                                                                <Canvas x:Name="BedThumb" Width="46" Height="36" Visibility="Collapsed">
                                                                    <Rectangle Canvas.Left="4" Canvas.Top="16" Width="38" Height="15" RadiusX="3" Fill="#B97843" />
                                                                    <Rectangle Canvas.Left="5" Canvas.Top="7" Width="8" Height="24" RadiusX="2" Fill="#7B421D" />
                                                                    <Rectangle Canvas.Left="14" Canvas.Top="12" Width="12" Height="8" RadiusX="3" Fill="#F6E7D6" />
                                                                </Canvas>
                                                                <Canvas x:Name="TableThumb" Width="46" Height="36" Visibility="Collapsed">
                                                                    <Ellipse Canvas.Left="5" Canvas.Top="6" Width="36" Height="14" Fill="#B87437" />
                                                                    <Rectangle Canvas.Left="11" Canvas.Top="17" Width="4" Height="15" Fill="#704019" />
                                                                    <Rectangle Canvas.Left="31" Canvas.Top="17" Width="4" Height="15" Fill="#704019" />
                                                                </Canvas>
                                                                <Canvas x:Name="DeskThumb" Width="46" Height="36" Visibility="Collapsed">
                                                                    <Rectangle Canvas.Left="4" Canvas.Top="8" Width="38" Height="8" RadiusX="2" Fill="#9E6537" />
                                                                    <Rectangle Canvas.Left="7" Canvas.Top="15" Width="4" Height="18" Fill="#663412" />
                                                                    <Rectangle Canvas.Left="35" Canvas.Top="15" Width="4" Height="18" Fill="#663412" />
                                                                    <Rectangle Canvas.Left="25" Canvas.Top="16" Width="11" Height="9" Fill="#C99564" />
                                                                </Canvas>
                                                                <Canvas x:Name="ChairThumb" Width="42" Height="38" Visibility="Collapsed">
                                                                    <Rectangle Canvas.Left="9" Canvas.Top="3" Width="24" Height="18" RadiusX="7" Fill="#B9773F" />
                                                                    <Rectangle Canvas.Left="7" Canvas.Top="19" Width="28" Height="9" RadiusX="3" Fill="#915224" />
                                                                    <Rectangle Canvas.Left="10" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" />
                                                                    <Rectangle Canvas.Left="29" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" />
                                                                </Canvas>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="Wardrobe">
                                                            <Setter TargetName="WardrobeThumb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="Bed">
                                                            <Setter TargetName="BedThumb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="Table">
                                                            <Setter TargetName="TableThumb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="Desk">
                                                            <Setter TargetName="DeskThumb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="Chair">
                                                            <Setter TargetName="ChairThumb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="اسم الأثاث" Width="2*" MinWidth="160" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <StackPanel Margin="16,8" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                            <TextBlock x:Name="ContrastCell1" Text="منتج أثاث ثابت" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الفئة" Width="1.1*" MinWidth="120" SortMemberPath="Category">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Category}" Style="{StaticResource TableBody}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="عدد المقاسات" Width="1.05*" MinWidth="120" SortMemberPath="VariantCount">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding VariantCountLabel}" Style="{StaticResource TableBody}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="سعر البيع" Width="1.2*" MinWidth="120" SortMemberPath="SellingPrice">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ContrastCell0" Text="من" Style="{StaticResource TableBody}" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="ContrastCell1" Text="{Binding SellingPriceAmountLabel}" Style="{StaticResource TableBody}" />
                                                            <TextBlock x:Name="ContrastCell2" Text="YER" Style="{StaticResource TableBody}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell2" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="0.8*" MinWidth="100" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <controls:StatusBadge x:Name="StatusPill" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Tone="Success"></controls:StatusBadge>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                            <Setter TargetName="StatusPill" Property="Background" Value="#EEEAE6" />
                                                            <Setter TargetName="StatusPill" Property="Foreground" Value="#625A54" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الإجراءات" Width="70" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                                                        <Button Style="{StaticResource RowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات الأثاث">
                                                            <Button.ContextMenu>
                                                                <ContextMenu Style="{StaticResource ActionMenu}" FlowDirection="LeftToRight" Placement="MousePoint" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" Padding="5">
                                                                    <MenuItem Header="تعديل" Style="{StaticResource ActionMenuItem}" Click="EditFurnitureClick" />
                                                                    <MenuItem Header="تكرار" Style="{StaticResource ActionMenuItem}" Click="DuplicateFurnitureClick" />
                                                                    <Separator Style="{StaticResource ActionMenuSeparator}" />
                                                                    <MenuItem Header="أرشفة" Style="{StaticResource ActionMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveFurnitureClick" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Opacity" Value="0.58" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                    <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="EditorSurface" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <StackPanel>
                    <controls:PageHeader Padding="0" FontSize="23" DescriptionFontSize="10" DescriptionMargin="0" Title="{Binding EditorTitle}" Subtitle="{Binding EditorStepDescription}">
                        <controls:FeedbackNotice Message="وضع المعاينة" Tone="Warning" />
                    </controls:PageHeader>
                    <controls:StepIndicator CurrentStep="{Binding CurrentStep}" Margin="-4,12,-4,0">
                        <controls:StepIndicator.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>المعلومات</sys:String>
                                <sys:String>الأجزاء</sys:String>
                                <sys:String>المقاسات</sys:String>
                                <sys:String>الخيارات</sys:String>
                                <sys:String>التسعير</sys:String>
                                <sys:String>المراجعة</sys:String>
                            </x:Array>
                        </controls:StepIndicator.ItemsSource>
                    </controls:StepIndicator>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="28,22" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStepTwo}" Value="True">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStepFour}" Value="True">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="MinWidth" Value="900" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStepTwo}" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStepFour}" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border x:Name="InformationStep" Visibility="{Binding IsStepOne, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource Card}" Padding="24">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                                <TextBlock Text="صورة المنتج" Style="{StaticResource FieldLabel}" />
                                <Border Height="360" Background="#F2E7DB" BorderBrush="#D6B997" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ProductImage}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProductImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProductImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Canvas Width="160" Height="155" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,42">
                                                <Rectangle Canvas.Left="20" Canvas.Top="12" Width="120" Height="126" RadiusX="8" Fill="#9A6237" />
                                                <Rectangle Canvas.Left="28" Canvas.Top="20" Width="50" Height="110" RadiusX="3" Fill="#B97D46" />
                                                <Rectangle Canvas.Left="82" Canvas.Top="20" Width="50" Height="110" RadiusX="3" Fill="#8B5026" />
                                                <Ellipse Canvas.Left="70" Canvas.Top="76" Width="7" Height="7" Fill="#4B260B" />
                                                <Ellipse Canvas.Left="84" Canvas.Top="76" Width="7" Height="7" Fill="#4B260B" />
                                                <Rectangle Canvas.Left="28" Canvas.Top="138" Width="12" Height="8" Fill="#623510" />
                                                <Rectangle Canvas.Left="120" Canvas.Top="138" Width="12" Height="8" Fill="#623510" />
                                            </Canvas>
                                            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,24">
                                                <TextBlock Text="اختر صورة واضحة للمنتج" FontWeight="SemiBold" TextAlignment="Center" />
                                                <TextBlock Text="تظهر هنا كمعاينة كبيرة قبل المتابعة" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding ProductImageName}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                <Button Content="اختيار صورة" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="ChooseImageClick" automation:AutomationProperties.Name="اختيار صورة المنتج" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" FlowDirection="RightToLeft">
                                <TextBlock Text="المعلومات الأساسية" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="عرّف المنتج كما سيظهر للمدير في قائمة الأثاث." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,20" />
                                <controls:FormField Label="اسم الأثاث">
                                    <TextBox x:Name="FurnitureNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم الأثاث" />
                                </controls:FormField>
                                <controls:FormField Label="الفئة" Margin="0,17,0,0">
                                    <ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="فئة الأثاث" />
                                </controls:FormField>
                                <controls:FormField Label="وصف قصير" Margin="0,17,0,0">
                                    <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الوصف القصير" />
                                </controls:FormField>
                                <controls:FormField Label="ملاحظات داخلية" Margin="0,17,0,0">
                                    <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الملاحظات الداخلية" />
                                </controls:FormField>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="PartsStep" Visibility="{Binding IsStepTwo, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="OpenPartPickerClick" automation:AutomationProperties.Name="إضافة جزء للأثاث" Content="إضافة جزء" controls:ControlOptions.Icon="{StaticResource IconPlus}" />
                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                <TextBlock Text="الأجزاء المستخدمة" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="اختر الجزء، ثم اضبط الكمية وشاهد التكلفة المحدثة." Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="230">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
