                                            <StackPanel Grid.Column="3" FlowDirection="RightToLeft" Margin="22,16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                                                <TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="ReviewStep" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E9F4E8" CornerRadius="10" Padding="13,7" VerticalAlignment="Center">
                                <TextBlock Text="للقراءة فقط" Foreground="#28733C" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                <TextBlock Text="مراجعة المنتج" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="راجع المعلومات والخيارات قبل الحفظ أو النشر." Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="168" Background="#F2E7DB" CornerRadius="11" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ProductImage}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProductImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Canvas Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Canvas.Left="14" Canvas.Top="8" Width="84" Height="88" RadiusX="6" Fill="#9A6237" />
                                            <Rectangle Canvas.Left="20" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#B97D46" />
                                            <Rectangle Canvas.Left="58" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#8B5026" />
                                            <Ellipse Canvas.Left="49" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" />
                                            <Ellipse Canvas.Left="59" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center">
                                    <TextBlock Text="المنتج" Foreground="#8B4D17" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EditorName}" FontSize="23" FontWeight="Bold" Margin="0,7,0,0" />
                                    <Border Background="#F3ECE5" CornerRadius="9" Padding="10,4" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding EditorCategory}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding ReviewDescription}" Foreground="#5D554E" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" MaxWidth="570" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="المقاسات والأسعار" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Variants}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel FlowDirection="RightToLeft" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="274" MinHeight="128" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" />
                                            <Separator Margin="0,12,0,9" Background="{StaticResource LineBrush}" />
                                            <controls:AmountDisplay HorizontalAlignment="Right" FontSize="17" FontWeight="Bold" Foreground="#6F3B0D" AmountText="{Binding SellingPriceLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="المقابض المتاحة" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="المقابض النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" />
                                    <ItemsControl ItemsSource="{Binding Handles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid FlowDirection="LeftToRight">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                                            <Border Width="48" Height="24" Background="#F7F1EB" CornerRadius="6" Margin="0,0,9,0">
                                                                <Rectangle Width="30" Height="5" RadiusX="2.5" Fill="{Binding HandleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="الألوان المتاحة" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="الألوان النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" />
                                    <ItemsControl ItemsSource="{Binding Colors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid FlowDirection="LeftToRight">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                                            <Border Width="24" Height="24" CornerRadius="12" Background="{Binding SwatchBrush}" BorderBrush="#CFC4B9" BorderThickness="1" Margin="0,0,9,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="إلغاء" Click="CancelEditorClick" automation:AutomationProperties.Name="إلغاء إنشاء الأثاث">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStepSix}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditorError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStepSix}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="السابق" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStepOne}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="108" Click="NextStepClick" automation:AutomationProperties.Name="الخطوة التالية">
                            <TextBlock Text="التالي" Foreground="White" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="السابق" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة من المراجعة" />
                        <Button Content="حفظ كمسودة" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="SaveDraftClick" automation:AutomationProperties.Name="حفظ الأثاث كمسودة" />
                        <Button Content="حفظ ونشر" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="126" Click="PublishClick" automation:AutomationProperties.Name="حفظ الأثاث ونشره" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <controls:DialogHost Panel.ZIndex="30" IsOpen="{Binding IsPartPickerOpen}" Title="اختر جزءاً" PreferredWidth="570" FlowDirection="RightToLeft" CloseRequested="ClosePartPickerClick" InitialFocusTarget="{Binding ElementName=PartSearchBox}">
            <controls:DialogHost.Footer>
                <Button Content="إغلاق" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ClosePartPickerClick" />
            </controls:DialogHost.Footer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="يُضاف الجزء بكمية أولية يمكنك تعديلها." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,35,0,0" />
                <TextBox x:Name="PartSearchBox" Text="{Binding PartSearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن جزء متاح" Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource SearchInput}" />
                <Border Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding FilteredParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8" Padding="14,11" Background="#FBF8F5" BorderBrush="#E4D9CF" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Style="{StaticResource ActionButton}" Click="SelectPartClick" automation:AutomationProperties.Name="اختيار الجزء">
                                    <Grid FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AmountDisplay Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" AmountText="{Binding UnitCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay>
                                        <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </controls:DialogHost>
        <controls:DialogHost Panel.ZIndex="31" IsOpen="{Binding IsVariantEditorOpen}" Title="{Binding VariantEditorTitle}" PreferredWidth="520" FlowDirection="RightToLeft" CloseRequested="CancelVariantClick" InitialFocusTarget="{Binding ElementName=VariantNameBox}">
            <controls:DialogHost.Footer>
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveVariantClick" automation:AutomationProperties.Name="حفظ المقاس">
                        <TextBlock Text="حفظ المقاس" Foreground="White" />
                    </Button>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelVariantClick" />
                </StackPanel>
            </controls:DialogHost.Footer>
            <StackPanel>
                <TextBlock Text="هذا مقاس ثابت يختاره موظف الاستقبال كما هو." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" />
                <controls:FormField Label="اسم المقاس">
                    <TextBox x:Name="VariantNameBox" Text="{Binding VariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم المقاس" />
                </controls:FormField>
                <UniformGrid Columns="3" Margin="-5,16,-5,0">
                    <StackPanel Margin="5,0">
                        <controls:FormField Label="العرض (cm)">
                            <TextBox Text="{Binding VariantWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" />
                        </controls:FormField>
                    </StackPanel>
                    <StackPanel Margin="5,0">
                        <controls:FormField Label="الارتفاع (cm)">
                            <TextBox Text="{Binding VariantHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" />
                        </controls:FormField>
                    </StackPanel>
                    <StackPanel Margin="5,0">
                        <controls:FormField Label="العمق (cm)">
                            <TextBox Text="{Binding VariantDepth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" />
                        </controls:FormField>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" />
            </StackPanel>
        </controls:DialogHost>
        <controls:DialogHost Panel.ZIndex="32" IsOpen="{Binding IsColorEditorOpen}" Title="إضافة لون" PreferredWidth="500" FlowDirection="RightToLeft" CloseRequested="CancelColorClick" InitialFocusTarget="{Binding ElementName=ColorNameBox}">
            <controls:DialogHost.Footer>
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveColorClick" automation:AutomationProperties.Name="حفظ اللون">
                        <TextBlock Text="حفظ اللون" Foreground="White" />
                    </Button>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelColorClick" />
                </StackPanel>
            </controls:DialogHost.Footer>
            <StackPanel FlowDirection="RightToLeft">
                <TextBlock Text="أضف خياراً واضحاً مع فرق السعر الذي سيظهر لاحقاً." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" />
                <controls:FormField Label="اسم اللون">
                    <TextBox x:Name="ColorNameBox" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم اللون" />
                </controls:FormField>
                <controls:FormField Label="تعديل السعر" Margin="0,17,0,0">
                    <TextBox Text="{Binding ColorPriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر اللون" />
                </controls:FormField>
                <controls:FormField Label="اللون المعروض" Margin="0,17,0,0" ErrorText="{Binding EditorError}">
                    <ComboBox ItemsSource="{Binding ColorSwatchOptions}" SelectedItem="{Binding ColorSwatchHex}" Style="{StaticResource SelectInput}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="درجة لون المنتج" />
                </controls:FormField>
            </StackPanel>
        </controls:DialogHost>
        <controls:DialogHost Panel.ZIndex="33" IsOpen="{Binding IsHandleEditorOpen}" Title="إضافة مقبض" PreferredWidth="500" FlowDirection="RightToLeft" CloseRequested="CancelHandleClick" InitialFocusTarget="{Binding ElementName=HandleNameBox}">
            <controls:DialogHost.Footer>
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveHandleClick" automation:AutomationProperties.Name="حفظ المقبض">
                        <TextBlock Text="حفظ المقبض" Foreground="White" />
                    </Button>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelHandleClick" />
                </StackPanel>
            </controls:DialogHost.Footer>
            <StackPanel FlowDirection="RightToLeft">
                <TextBlock Text="أضف المقبض مع فرق السعر الذي سيراه موظف الاستقبال." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" />
                <controls:FormField Label="اسم المقبض">
                    <TextBox x:Name="HandleNameBox" Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم المقبض" />
                </controls:FormField>
                <controls:FormField Label="تعديل السعر" Margin="0,17,0,0" HelpText="سيُختار الرسم المناسب تلقائياً في المعاينة.">
                    <TextBox Text="{Binding HandlePriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر المقبض" />
                </controls:FormField>
                <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" />
            </StackPanel>
        </controls:DialogHost>
        <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" IsFloating="True" FontSize="11" DisplayDuration="00:00:03" Dismissed="FeedbackDismissed" Margin="28" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}" Panel.ZIndex="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>