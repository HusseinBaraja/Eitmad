                        <ItemsControl ItemsSource="{Binding Variants}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="212" Style="{StaticResource Card}" Padding="18" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#F5E6D6" CornerRadius="9" Padding="9,4"><TextBlock Text="مقاس ثابت" Foreground="#7C410C" FontSize="9" /></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextAlignment="Right" /></Grid><StackPanel Grid.Row="1" Margin="0,20,0,18"><TextBlock Text="العرض × الارتفاع × العمق" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" /><Separator Margin="0,14" Background="{StaticResource LineBrush}" /><TextBlock Text="التكلفة المحسوبة" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding CalculatedCostLabel}" FontSize="16" FontWeight="Bold" /><TextBlock Text="YER" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,1" VerticalAlignment="Bottom" /></StackPanel></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft"><Button Content="تعديل" Style="{StaticResource FurnitureGhostButton}" Click="EditVariantClick" /><Button Content="تكرار" Style="{StaticResource FurnitureGhostButton}" Margin="7,0,0,0" Click="DuplicateVariantClick" /><Button Content="إزالة" Style="{StaticResource FurnitureGhostButton}" Foreground="#A13B27" BorderBrush="#D7A99F" Margin="7,0,0,0" Click="RemoveVariantClick" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border BorderBrush="#D8C9BA" BorderThickness="1" CornerRadius="12" Padding="24" Background="#FBF6F0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasVariants}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center"><TextBlock Text="لا توجد مقاسات بعد" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="أضف أول مقاس ثابت لتبدأ المقارنة." Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,4,0,0" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="OptionsStep" Visibility="{Binding IsStepFour, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="AddColorClick" automation:AutomationProperties.Name="إضافة لون"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="17" Height="17" Fill="White" /><TextBlock Text="إضافة لون" Foreground="White" Margin="8,0,0,0" /></StackPanel></Button><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="الألوان المتاحة" FontSize="24" FontWeight="Bold" /><TextBlock Text="اختر الألوان التي يمكن لموظف الاستقبال عرضها لاحقاً." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
