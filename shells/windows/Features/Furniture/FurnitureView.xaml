<UserControl x:Class="Eitmad.WindowsShell.Features.Furniture.FurnitureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="FurnitureFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="FurnitureTextInput" TargetType="TextBox">
            <Setter Property="MinHeight" Value="44" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DED6CE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputChrome" Background="{TemplateBinding BorderBrush}" CornerRadius="8" Margin="0,0,0,1"><Border x:Name="InputSurface" Background="{TemplateBinding Background}" CornerRadius="7" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" /></Border></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="#A35E1E" /><Setter TargetName="InputSurface" Property="Margin" Value="1.5" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="#C69A70" /></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="{StaticResource DangerBrush}" /><Setter TargetName="InputSurface" Property="Margin" Value="1.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FurnitureComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="3,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F3E5D7" /><Setter Property="Foreground" Value="#6C390D" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FBF2E9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FurnitureComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DED6CE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" /><Setter Property="ItemContainerStyle" Value="{StaticResource FurnitureComboBoxItem}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F6EEE6" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="Chevron" Data="M3,7 L8,12 L13,7" Stroke="#8B4D17" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" /></Border><ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" Margin="4,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="{TemplateBinding FlowDirection}" /></Grid></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6"><Border Width="{Binding ActualWidth, ElementName=InputChrome}" MaxHeight="260" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="4"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" /></Border.Effect><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M3,12 L8,7 L13,12" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FurnitureSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="43" /><Setter Property="Padding" Value="18,8" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#BBAA9A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#4A3525" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F7F0E8" /><Setter TargetName="Surface" Property="BorderBrush" Value="#98653D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FurnitureGhostButton" TargetType="Button" BasedOn="{StaticResource FurnitureSecondaryButton}"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="11,5" /><Setter Property="FontSize" Value="10" /></Style>
        <Style x:Key="FurnitureHeaderCell" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#675F59" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="FurnitureBodyCell" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style x:Key="FurnitureRowActionButton" TargetType="Button"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5E9DC" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="FurnitureMenuItem" TargetType="MenuItem"><Setter Property="FlowDirection" Value="RightToLeft" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="Padding" Value="13,9" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Right" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FBF0E5" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FurnitureStepBorder" TargetType="Border"><Setter Property="Background" Value="#F5F1ED" /><Setter Property="BorderBrush" Value="#E3DDD7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="4" /></Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,17">
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="46" Click="AddFurnitureClick" automation:AutomationProperties.Name="إضافة منتج"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="White" /><TextBlock Text="إضافة منتج" Foreground="White" FontSize="13" Margin="9,0,0,0" /></StackPanel></Button>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="الأثاث" FontSize="27" FontWeight="Bold" TextAlignment="Right" /><TextBlock Text="منتجات ثابتة ومقاسات يحددها المدير" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="28,20,28,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel MinWidth="880">
                    <UniformGrid Columns="3" Margin="-6,0,-6,14">
                        <StackPanel Margin="6,0"><TextBlock Text="البحث" Style="{StaticResource FurnitureFieldLabel}" /><Border Height="44" Background="White" BorderBrush="#DED6CE" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource IconSearch}" Style="{StaticResource ToolbarVectorIcon}" /><TextBox x:Name="FurnitureSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="9,10,2,8" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="13" automation:AutomationProperties.Name="البحث عن أثاث" /></Grid></Border></StackPanel>
                        <StackPanel Margin="6,0"><TextBlock Text="الفئة" Style="{StaticResource FurnitureFieldLabel}" /><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource FurnitureComboBox}" automation:AutomationProperties.Name="تصفية فئة الأثاث" /></StackPanel>
                        <StackPanel Margin="6,0"><TextBlock Text="الحالة" Style="{StaticResource FurnitureFieldLabel}" /><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource FurnitureComboBox}" automation:AutomationProperties.Name="تصفية حالة الأثاث" /></StackPanel>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الصورة" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="1" Text="اسم الأثاث" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="2" Text="الفئة" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="3" Text="عدد المقاسات" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="4" Text="سعر البيع" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="6" Text="الإجراءات" Style="{StaticResource FurnitureHeaderCell}" /></Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleFurniture}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="58" Height="50" CornerRadius="8" Background="#EFE2D4" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"><Grid><Rectangle Fill="#F5EADF" /><Canvas x:Name="WardrobeThumb" Width="44" Height="38" Visibility="Collapsed"><Rectangle Canvas.Left="7" Canvas.Top="3" Width="30" Height="31" RadiusX="2" Fill="#9A6237" /><Line X1="22" X2="22" Y1="5" Y2="32" Stroke="#F0D2AE" StrokeThickness="1" /><Ellipse Canvas.Left="18" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" /><Ellipse Canvas.Left="24" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" /></Canvas><Canvas x:Name="BedThumb" Width="46" Height="36" Visibility="Collapsed"><Rectangle Canvas.Left="4" Canvas.Top="16" Width="38" Height="15" RadiusX="3" Fill="#B97843" /><Rectangle Canvas.Left="5" Canvas.Top="7" Width="8" Height="24" RadiusX="2" Fill="#7B421D" /><Rectangle Canvas.Left="14" Canvas.Top="12" Width="12" Height="8" RadiusX="3" Fill="#F6E7D6" /></Canvas><Canvas x:Name="TableThumb" Width="46" Height="36" Visibility="Collapsed"><Ellipse Canvas.Left="5" Canvas.Top="6" Width="36" Height="14" Fill="#B87437" /><Rectangle Canvas.Left="11" Canvas.Top="17" Width="4" Height="15" Fill="#704019" /><Rectangle Canvas.Left="31" Canvas.Top="17" Width="4" Height="15" Fill="#704019" /></Canvas><Canvas x:Name="DeskThumb" Width="46" Height="36" Visibility="Collapsed"><Rectangle Canvas.Left="4" Canvas.Top="8" Width="38" Height="8" RadiusX="2" Fill="#9E6537" /><Rectangle Canvas.Left="7" Canvas.Top="15" Width="4" Height="18" Fill="#663412" /><Rectangle Canvas.Left="35" Canvas.Top="15" Width="4" Height="18" Fill="#663412" /><Rectangle Canvas.Left="25" Canvas.Top="16" Width="11" Height="9" Fill="#C99564" /></Canvas><Canvas x:Name="ChairThumb" Width="42" Height="38" Visibility="Collapsed"><Rectangle Canvas.Left="9" Canvas.Top="3" Width="24" Height="18" RadiusX="7" Fill="#B9773F" /><Rectangle Canvas.Left="7" Canvas.Top="19" Width="28" Height="9" RadiusX="3" Fill="#915224" /><Rectangle Canvas.Left="10" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" /><Rectangle Canvas.Left="29" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" /></Canvas></Grid></Border>
                                    <StackPanel Grid.Column="1" Margin="16,8" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" /><TextBlock Text="منتج أثاث ثابت" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource FurnitureBodyCell}" /><TextBlock Grid.Column="3" Text="{Binding VariantCountLabel}" Style="{StaticResource FurnitureBodyCell}" /><StackPanel Grid.Column="4" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="من" Style="{StaticResource FurnitureBodyCell}" Margin="0,0,6,0" /><TextBlock Text="{Binding SellingPriceAmountLabel}" Style="{StaticResource FurnitureBodyCell}" /><TextBlock Text="YER" Style="{StaticResource FurnitureBodyCell}" Margin="6,0,0,0" /></StackPanel><Border Grid.Column="5" x:Name="StatusPill" Background="#EAF7E9" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" Foreground="#28733C" FontSize="10" FontWeight="SemiBold" /></Border><Button Grid.Column="6" Style="{StaticResource FurnitureRowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات الأثاث"><Button.ContextMenu><ContextMenu FlowDirection="LeftToRight" Placement="MousePoint" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" Padding="5"><MenuItem Header="تعديل" Style="{StaticResource FurnitureMenuItem}" Click="EditFurnitureClick" /><MenuItem Header="تكرار" Style="{StaticResource FurnitureMenuItem}" Click="DuplicateFurnitureClick" /><Separator /><MenuItem Header="أرشفة" Style="{StaticResource FurnitureMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveFurnitureClick" /></ContextMenu></Button.ContextMenu></Button>
                                </Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding ThumbnailKind}" Value="Wardrobe"><Setter TargetName="WardrobeThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Bed"><Setter TargetName="BedThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Table"><Setter TargetName="TableThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Desk"><Setter TargetName="DeskThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Chair"><Setter TargetName="ChairThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.58" /><Setter TargetName="StatusPill" Property="Background" Value="#EEEAE6" /><Setter TargetName="StatusText" Property="Foreground" Value="#625A54" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorSurface" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <StackPanel><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="وضع المعاينة" Foreground="#8B4D17" Background="#F5E8DB" Padding="10,4" FontSize="9" VerticalAlignment="Center" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="{Binding EditorTitle}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding EditorStepDescription}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                    <UniformGrid Columns="6" Margin="-4,12,-4,0">
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="1" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" /></Border><TextBlock Text="المعلومات" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="2" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" FontWeight="Bold" /></Border><TextBlock Text="الأجزاء" Margin="7,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="3" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" FontWeight="Bold" /></Border><TextBlock Text="المقاسات" Margin="7,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepFour}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="4" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepFour}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="الخيارات" Margin="7,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepFour}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepFive}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="5" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepFive}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="التسعير" Margin="7,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepFive}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FurnitureStepBorder}"><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Background" Value="#6F3B0D" /><Setter Property="BorderBrush" Value="#6F3B0D" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5D5C5"><TextBlock Text="6" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="المراجعة" Margin="7,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="28,22" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="900">
                    <Border x:Name="InformationStep" Visibility="{Binding IsStepOne, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource Card}" Padding="24">
                        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
