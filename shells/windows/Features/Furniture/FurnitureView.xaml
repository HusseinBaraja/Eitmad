esource MutedBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /><Button Content="اختيار صورة" Style="{StaticResource FurnitureSecondaryButton}" Margin="0,10,0,0" Click="ChooseImageClick" automation:AutomationProperties.Name="اختيار صورة المنتج" /></StackPanel>
                            <StackPanel Grid.Column="2" FlowDirection="RightToLeft"><TextBlock Text="المعلومات الأساسية" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="عرّف المنتج كما سيظهر للمدير في قائمة الأثاث." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,20" /><TextBlock Text="اسم الأثاث" Style="{StaticResource FurnitureFieldLabel}" /><TextBox x:Name="FurnitureNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" automation:AutomationProperties.Name="اسم الأثاث" /><TextBlock Text="الفئة" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory}" Style="{StaticResource FurnitureComboBox}" automation:AutomationProperties.Name="فئة الأثاث" /><TextBlock Text="وصف قصير" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الوصف القصير" /><TextBlock Text="ملاحظات داخلية" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الملاحظات الداخلية" /></StackPanel>
