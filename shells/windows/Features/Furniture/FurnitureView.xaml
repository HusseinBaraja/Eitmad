<UserControl x:Class="Eitmad.WindowsShell.Features.Furniture.FurnitureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Title="الأثاث" Subtitle="منتجات ثابتة ومقاسات يحددها المدير"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Height="46" Click="AddFurnitureClick" automation:AutomationProperties.Name="إضافة منتج" Content="إضافة منتج" controls:ControlOptions.Icon="{StaticResource IconPlus}" /></StackPanel></controls:PageHeader>
            <ScrollViewer Grid.Row="1" Padding="28,20,28,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,14">
                        <StackPanel><controls:FormField Label="البحث"><TextBox x:Name="FurnitureSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن أثاث" Style="{StaticResource SearchInput}" /></controls:FormField></StackPanel>
                        <StackPanel><controls:FormField Label="الفئة"><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية فئة الأثاث" /></controls:FormField></StackPanel>
                        <StackPanel><controls:FormField Label="الحالة"><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية حالة الأثاث" /></controls:FormField></StackPanel>
                    </layout:AdaptiveFieldsPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Border MinWidth="880" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الصورة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="اسم الأثاث" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="الفئة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="عدد المقاسات" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="سعر البيع" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="6" Text="الإجراءات" Style="{StaticResource TableHeader}" /></Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleFurniture}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="78" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="58" Height="50" CornerRadius="8" Background="#EFE2D4" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"><Grid><Rectangle Fill="#F5EADF" /><Canvas x:Name="WardrobeThumb" Width="44" Height="38" Visibility="Collapsed"><Rectangle Canvas.Left="7" Canvas.Top="3" Width="30" Height="31" RadiusX="2" Fill="#9A6237" /><Line X1="22" X2="22" Y1="5" Y2="32" Stroke="#F0D2AE" StrokeThickness="1" /><Ellipse Canvas.Left="18" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" /><Ellipse Canvas.Left="24" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B" /></Canvas><Canvas x:Name="BedThumb" Width="46" Height="36" Visibility="Collapsed"><Rectangle Canvas.Left="4" Canvas.Top="16" Width="38" Height="15" RadiusX="3" Fill="#B97843" /><Rectangle Canvas.Left="5" Canvas.Top="7" Width="8" Height="24" RadiusX="2" Fill="#7B421D" /><Rectangle Canvas.Left="14" Canvas.Top="12" Width="12" Height="8" RadiusX="3" Fill="#F6E7D6" /></Canvas><Canvas x:Name="TableThumb" Width="46" Height="36" Visibility="Collapsed"><Ellipse Canvas.Left="5" Canvas.Top="6" Width="36" Height="14" Fill="#B87437" /><Rectangle Canvas.Left="11" Canvas.Top="17" Width="4" Height="15" Fill="#704019" /><Rectangle Canvas.Left="31" Canvas.Top="17" Width="4" Height="15" Fill="#704019" /></Canvas><Canvas x:Name="DeskThumb" Width="46" Height="36" Visibility="Collapsed"><Rectangle Canvas.Left="4" Canvas.Top="8" Width="38" Height="8" RadiusX="2" Fill="#9E6537" /><Rectangle Canvas.Left="7" Canvas.Top="15" Width="4" Height="18" Fill="#663412" /><Rectangle Canvas.Left="35" Canvas.Top="15" Width="4" Height="18" Fill="#663412" /><Rectangle Canvas.Left="25" Canvas.Top="16" Width="11" Height="9" Fill="#C99564" /></Canvas><Canvas x:Name="ChairThumb" Width="42" Height="38" Visibility="Collapsed"><Rectangle Canvas.Left="9" Canvas.Top="3" Width="24" Height="18" RadiusX="7" Fill="#B9773F" /><Rectangle Canvas.Left="7" Canvas.Top="19" Width="28" Height="9" RadiusX="3" Fill="#915224" /><Rectangle Canvas.Left="10" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" /><Rectangle Canvas.Left="29" Canvas.Top="27" Width="4" Height="8" Fill="#61310F" /></Canvas></Grid></Border>
                                    <StackPanel Grid.Column="1" Margin="16,8" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" /><TextBlock Text="منتج أثاث ثابت" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="3" Text="{Binding VariantCountLabel}" Style="{StaticResource TableBody}" /><StackPanel Grid.Column="4" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="من" Style="{StaticResource TableBody}" Margin="0,0,6,0" /><TextBlock Text="{Binding SellingPriceAmountLabel}" Style="{StaticResource TableBody}" /><TextBlock Text="YER" Style="{StaticResource TableBody}" Margin="6,0,0,0" /></StackPanel><controls:StatusBadge x:Name="StatusPill" Grid.Column="5" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Tone="Success"></controls:StatusBadge><Button Grid.Column="6" Style="{StaticResource RowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات الأثاث"><Button.ContextMenu><ContextMenu Style="{StaticResource ActionMenu}" FlowDirection="LeftToRight" Placement="MousePoint" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" Padding="5"><MenuItem Header="تعديل" Style="{StaticResource ActionMenuItem}" Click="EditFurnitureClick" /><MenuItem Header="تكرار" Style="{StaticResource ActionMenuItem}" Click="DuplicateFurnitureClick" /><Separator Style="{StaticResource ActionMenuSeparator}" /><MenuItem Header="أرشفة" Style="{StaticResource ActionMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveFurnitureClick" /></ContextMenu></Button.ContextMenu></Button>
                                </Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding ThumbnailKind}" Value="Wardrobe"><Setter TargetName="WardrobeThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Bed"><Setter TargetName="BedThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Table"><Setter TargetName="TableThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Desk"><Setter TargetName="DeskThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Chair"><Setter TargetName="ChairThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.58" /><Setter TargetName="StatusPill" Property="Background" Value="#EEEAE6" /><Setter TargetName="StatusPill" Property="Foreground" Value="#625A54" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border></ScrollViewer>
                    <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorSurface" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <StackPanel><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="وضع المعاينة" Foreground="#8B4D17" Background="#F5E8DB" Padding="10,4" FontSize="9" VerticalAlignment="Center" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="{Binding EditorTitle}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding EditorStepDescription}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                    <controls:StepIndicator CurrentStep="{Binding CurrentStep}" Margin="0,0,0,18"><controls:StepItem Label="المعلومات"/><controls:StepItem Label="الأجزاء"/><controls:StepItem Label="المقاسات"/><controls:StepItem Label="الخيارات"/><controls:StepItem Label="التسعير"/><controls:StepItem Label="المراجعة"/></controls:StepIndicator>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="28,22" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="900">
                    <Border x:Name="InformationStep" Visibility="{Binding IsStepOne, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource Card}" Padding="24">
                        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" FlowDirection="RightToLeft"><TextBlock Text="صورة المنتج" Style="{StaticResource FieldLabel}" /><Border Height="360" Background="#F2E7DB" BorderBrush="#D6B997" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><Image Source="{Binding ProductImage}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style></Image><Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Canvas Width="160" Height="155" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,42"><Rectangle Canvas.Left="20" Canvas.Top="12" Width="120" Height="126" RadiusX="8" Fill="#9A6237" /><Rectangle Canvas.Left="28" Canvas.Top="20" Width="50" Height="110" RadiusX="3" Fill="#B97D46" /><Rectangle Canvas.Left="82" Canvas.Top="20" Width="50" Height="110" RadiusX="3" Fill="#8B5026" /><Ellipse Canvas.Left="70" Canvas.Top="76" Width="7" Height="7" Fill="#4B260B" /><Ellipse Canvas.Left="84" Canvas.Top="76" Width="7" Height="7" Fill="#4B260B" /><Rectangle Canvas.Left="28" Canvas.Top="138" Width="12" Height="8" Fill="#623510" /><Rectangle Canvas.Left="120" Canvas.Top="138" Width="12" Height="8" Fill="#623510" /></Canvas><StackPanel VerticalAlignment="Bottom" Margin="24,0,24,24"><TextBlock Text="اختر صورة واضحة للمنتج" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="تظهر هنا كمعاينة كبيرة قبل المتابعة" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel></Grid></Grid></Border><TextBlock Text="{Binding ProductImageName}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /><Button Content="اختيار صورة" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="ChooseImageClick" automation:AutomationProperties.Name="اختيار صورة المنتج" /></StackPanel>
                            <StackPanel Grid.Column="2" FlowDirection="RightToLeft"><TextBlock Text="المعلومات الأساسية" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="عرّف المنتج كما سيظهر للمدير في قائمة الأثاث." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,20" /><controls:FormField Label="اسم الأثاث"><TextBox x:Name="FurnitureNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم الأثاث" /></controls:FormField><controls:FormField Label="الفئة" Margin="0,17,0,0"><ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="فئة الأثاث" /></controls:FormField><controls:FormField Label="وصف قصير" Margin="0,17,0,0"><TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الوصف القصير" /></controls:FormField><controls:FormField Label="ملاحظات داخلية" Margin="0,17,0,0"><TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الملاحظات الداخلية" /></controls:FormField></StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="PartsStep" Visibility="{Binding IsStepTwo, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="OpenPartPickerClick" automation:AutomationProperties.Name="إضافة جزء للأثاث" Content="إضافة جزء" controls:ControlOptions.Icon="{StaticResource IconPlus}" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="الأجزاء المستخدمة" FontSize="24" FontWeight="Bold" /><TextBlock Text="اختر الجزء، ثم اضبط الكمية وشاهد التكلفة المحدثة." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="230"><Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0" Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><TextBlock Text="الجزء" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="الكمية" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="تكلفة الوحدة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="التكلفة الإجمالية" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="إزالة" Style="{StaticResource TableHeader}" /></Grid><ItemsControl x:Name="PartRows" Grid.Row="1" ItemsSource="{Binding SelectedParts}"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="64" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="18,7"><TextBlock Text="{Binding Part.Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Part.Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel><TextBox Grid.Column="1" Width="86" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" BorderThickness="1,1,1,2" FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="كمية الجزء" /><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding UnitCostLabel}" Style="{StaticResource TableBody}" /><TextBlock Text="YER" Style="{StaticResource TableBody}" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding TotalCostLabel}" Style="{StaticResource TableBody}" FontWeight="SemiBold" /><TextBlock Text="YER" Style="{StaticResource TableBody}" Margin="5,0,0,0" /></StackPanel><Button Grid.Column="4" Content="×" Style="{StaticResource RowActionButton}" Foreground="#A13B27" Click="RemovePartClick" automation:AutomationProperties.Name="إزالة الجزء" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                        <Border Background="#2F2117" CornerRadius="12" Padding="24,18" Margin="0,16,0,0"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentPartsCostLabel}" Foreground="White" FontSize="29" FontWeight="Bold" /><TextBlock Text="YER" Foreground="#DDBD9B" FontSize="13" Margin="9,0,0,3" VerticalAlignment="Bottom" /></StackPanel><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تكلفة الأجزاء الحالية" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="تُحدّث مع كل تغيير في الكمية" Foreground="#D8C8B8" FontSize="9" /></StackPanel></Grid></Border>
                    </StackPanel>

                    <StackPanel x:Name="VariantsStep" Visibility="{Binding IsStepThree, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="AddVariantClick" automation:AutomationProperties.Name="إضافة مقاس" Content="إضافة مقاس" controls:ControlOptions.Icon="{StaticResource IconPlus}" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="المقاسات الثابتة" FontSize="24" FontWeight="Bold" /><TextBlock Text="قارن المقاسات التي يحددها المدير لهذا المنتج." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <ItemsControl ItemsSource="{Binding Variants}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="212" Style="{StaticResource Card}" Padding="18" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#F5E6D6" CornerRadius="9" Padding="9,4"><TextBlock Text="مقاس ثابت" Foreground="#7C410C" FontSize="9" /></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextAlignment="Right" /></Grid><StackPanel Grid.Row="1" Margin="0,20,0,18"><TextBlock Text="العرض × الارتفاع × العمق" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" /><Separator Margin="0,14" Background="{StaticResource LineBrush}" /><TextBlock Text="التكلفة المحسوبة" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding CalculatedCostLabel}" FontSize="16" FontWeight="Bold" /><TextBlock Text="YER" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,1" VerticalAlignment="Bottom" /></StackPanel></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft"><Button Content="تعديل" Style="{StaticResource CompactButton}" Click="EditVariantClick" /><Button Content="تكرار" Style="{StaticResource CompactButton}" Margin="7,0,0,0" Click="DuplicateVariantClick" /><Button Content="إزالة" Style="{StaticResource CompactButton}" Foreground="#A13B27" BorderBrush="#D7A99F" Margin="7,0,0,0" Click="RemoveVariantClick" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <controls:EmptyState  Heading="لا توجد مقاسات بعد" Description="أضف أول مقاس ثابت لتبدأ المقارنة."><controls:EmptyState.Style><Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasVariants}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style></controls:EmptyState>
                    </StackPanel>

                    <StackPanel x:Name="OptionsStep" Visibility="{Binding IsStepFour, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="AddColorClick" automation:AutomationProperties.Name="إضافة لون" Content="إضافة لون" controls:ControlOptions.Icon="{StaticResource IconPlus}" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="الألوان المتاحة" FontSize="24" FontWeight="Bold" /><TextBlock Text="اختر الألوان التي يمكن لموظف الاستقبال عرضها لاحقاً." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0" Background="#F6F2EE" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="اللون" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="تعديل السعر" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="الحالة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="الإجراء" Style="{StaticResource TableHeader}" /></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding Colors}"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="70" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="94" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="10" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center" /><Border Grid.Column="2" Width="28" Height="28" CornerRadius="14" Background="{Binding SwatchBrush}" BorderBrush="#CFC4B9" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Grid.Column="1" Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Style="{StaticResource TableBody}" FontWeight="SemiBold" /><controls:StatusBadge Grid.Column="2" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}"><controls:StatusBadge.Style><Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}"><Setter Property="Tone" Value="Success"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Tone" Value="Neutral"/></DataTrigger></Style.Triggers></Style></controls:StatusBadge.Style></controls:StatusBadge><Button Grid.Column="3" Content="{Binding ToggleActionLabel}" Style="{StaticResource CompactButton}" Click="ToggleColorClick" automation:AutomationProperties.Name="تغيير حالة اللون" HorizontalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>

                        <Grid FlowDirection="LeftToRight" Margin="0,22,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="AddHandleClick" automation:AutomationProperties.Name="إضافة مقبض" Content="إضافة مقبض" controls:ControlOptions.Icon="{StaticResource IconPlus}" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="المقابض المتاحة" FontSize="24" FontWeight="Bold" /><TextBlock Text="ما يراه موظف الاستقبال كاختيار جاهز، مع فرق السعر بوضوح." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <ItemsControl ItemsSource="{Binding Handles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="188" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="64" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:StatusBadge Grid.Column="0" Padding="9,4" Text="{Binding StatusLabel}"><controls:StatusBadge.Style><Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}"><Setter Property="Tone" Value="Success"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Tone" Value="Neutral"/></DataTrigger></Style.Triggers></Style></controls:StatusBadge.Style></controls:StatusBadge><TextBlock Grid.Column="1" Text="{Binding Name}" TextAlignment="Right" FontSize="14" FontWeight="Bold" /></Grid><Border Grid.Row="1" Background="#F7F1EB" CornerRadius="9" Margin="0,12,0,8"><Canvas Width="122" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Canvas.Left="18" Canvas.Top="24" Width="86" Height="8" RadiusX="4" Fill="{Binding HandleBrush}" /><Ellipse Canvas.Left="15" Canvas.Top="20" Width="16" Height="16" Fill="{Binding HandleAccentBrush}" /><Ellipse Canvas.Left="91" Canvas.Top="20" Width="16" Height="16" Fill="{Binding HandleAccentBrush}" /><Rectangle Canvas.Left="38" Canvas.Top="16" Width="46" Height="3" RadiusX="1.5" Fill="{Binding HandleAccentBrush}" /></Canvas></Border><Grid Grid.Row="2" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="{Binding ToggleActionLabel}" Style="{StaticResource CompactButton}" Click="ToggleHandleClick" automation:AutomationProperties.Name="تغيير حالة المقبض" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="PricingStep" Visibility="{Binding IsStepFive, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#2F2117" CornerRadius="10" Padding="14,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPricing}" Width="18" Height="18" Fill="#E7C295" /><TextBlock Text="YER" Foreground="#F8E9D7" FontWeight="Bold" Margin="8,0,0,0" FlowDirection="LeftToRight" /></StackPanel></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تسعير المقاسات" FontSize="24" FontWeight="Bold" /><TextBlock Text="حدّد سعر البيع لكل مقاس. يظهر هامش الربح مباشرة للمقارنة." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <Border Background="#FBF4EC" BorderBrush="#E2C8AC" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,12"><TextBlock Text="التكلفة للمرجع فقط. سعر البيع هو القيمة التي ستظهر للعميل." Foreground="#704217" FontSize="10" /></Border>
                        <ItemsControl ItemsSource="{Binding Variants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="300" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="20,17" VerticalAlignment="Center"><TextBlock Text="{Binding MarginCaption}" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,6,0,0"><TextBlock Text="{Binding MarginLabel}" FontSize="16" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#28733C" /><Style.Triggers><DataTrigger Binding="{Binding HasNegativeMargin}" Value="True"><Setter Property="Foreground" Value="#A13B27" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="YER" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel>
                                            <Border Grid.Column="1" Background="#F7E9DA" BorderBrush="#D6B48F" BorderThickness="1,0" Padding="20,15"><StackPanel><controls:FormField Label="سعر البيع"><Grid FlowDirection="LeftToRight" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SellingPriceInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" Height="50" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Padding="12,0" VerticalContentAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right" BorderBrush="#B97A3E" automation:AutomationProperties.Name="سعر بيع المقاس" /><TextBlock Grid.Column="1" Text="YER" Foreground="#6F3B0D" FontSize="11" FontWeight="Bold" Margin="10,0,0,3" VerticalAlignment="Bottom" /></Grid></controls:FormField></StackPanel></Border>
                                            <StackPanel Grid.Column="2" Margin="20,17" VerticalAlignment="Center"><TextBlock Text="التكلفة" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,6,0,0"><TextBlock Text="{Binding CalculatedCostLabel}" FontSize="15" FontWeight="SemiBold" Foreground="#51483F" /><TextBlock Text="YER" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel>
                                            <StackPanel Grid.Column="3" FlowDirection="RightToLeft" Margin="22,16" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ReviewStep" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#E9F4E8" CornerRadius="10" Padding="13,7" VerticalAlignment="Center"><TextBlock Text="للقراءة فقط" Foreground="#28733C" FontSize="9" FontWeight="SemiBold" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="مراجعة المنتج" FontSize="24" FontWeight="Bold" /><TextBlock Text="راجع المعلومات والخيارات قبل الحفظ أو النشر." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
                            <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="168" Background="#F2E7DB" CornerRadius="11" ClipToBounds="True"><Grid><Image Source="{Binding ProductImage}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style></Image><Canvas Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Canvas.Left="14" Canvas.Top="8" Width="84" Height="88" RadiusX="6" Fill="#9A6237" /><Rectangle Canvas.Left="20" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#B97D46" /><Rectangle Canvas.Left="58" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#8B5026" /><Ellipse Canvas.Left="49" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" /><Ellipse Canvas.Left="59" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" /></Canvas></Grid></Border>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center"><TextBlock Text="المنتج" Foreground="#8B4D17" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="{Binding EditorName}" FontSize="23" FontWeight="Bold" Margin="0,7,0,0" /><Border Background="#F3ECE5" CornerRadius="9" Padding="10,4" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock Text="{Binding EditorCategory}" FontSize="9" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding ReviewDescription}" Foreground="#5D554E" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" MaxWidth="570" /></StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="المقاسات والأسعار" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Variants}" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="128" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" /><Separator Margin="0,12,0,9" Background="{StaticResource LineBrush}" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right"><TextBlock Text="{Binding SellingPriceLabel}" Foreground="#6F3B0D" FontSize="17" FontWeight="Bold" /><TextBlock Text="YER" Foreground="#8B4D17" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="المقابض المتاحة" FontSize="16" FontWeight="Bold" /><TextBlock Text="المقابض النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" /><ItemsControl ItemsSource="{Binding Handles}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Border Width="48" Height="24" Background="#F7F1EB" CornerRadius="6" Margin="0,0,9,0"><Rectangle Width="30" Height="5" RadiusX="2.5" Fill="{Binding HandleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="الألوان المتاحة" FontSize="16" FontWeight="Bold" /><TextBlock Text="الألوان النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" /><ItemsControl ItemsSource="{Binding Colors}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Border Width="24" Height="24" CornerRadius="12" Background="{Binding SwatchBrush}" BorderBrush="#CFC4B9" BorderThickness="1" Margin="0,0,9,0" /><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="إلغاء" Click="CancelEditorClick" automation:AutomationProperties.Name="إلغاء إنشاء الأثاث"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Grid.Column="1" Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasEditorError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="السابق" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="108" Click="NextStepClick" automation:AutomationProperties.Name="الخطوة التالية"><TextBlock Text="التالي" Foreground="White" /></Button></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}"><Button Content="السابق" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة من المراجعة" /><Button Content="حفظ كمسودة" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="SaveDraftClick" automation:AutomationProperties.Name="حفظ الأثاث كمسودة" /><Button Content="حفظ ونشر" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="126" Click="PublishClick" automation:AutomationProperties.Name="حفظ الأثاث ونشره" /></StackPanel></Grid></Border>
        </Grid>

        <Border Panel.ZIndex="30" Background="#702B1A0D" Visibility="{Binding IsPartPickerOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="570" MaxHeight="560" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="اختر جزءاً" FontSize="20" FontWeight="Bold" /><TextBlock Grid.Row="0" Text="يُضاف الجزء بكمية أولية يمكنك تعديلها." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,35,0,0" /><TextBox x:Name="PartSearchBox" Text="{Binding PartSearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن جزء متاح" Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource SearchInput}" /><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FilteredParts}"><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,0,8" Padding="14,11" Background="#FBF8F5" BorderBrush="#E4D9CF" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Style="{StaticResource ActionButton}" Click="SelectPartClick" automation:AutomationProperties.Name="اختيار الجزء"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center"><TextBlock Text="{Binding UnitCostLabel}" FontWeight="SemiBold" /><TextBlock Text="YER" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button Grid.Row="3" Content="إغلاق" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ClosePartPickerClick" /></Grid></Border></Border>

        <Border Panel.ZIndex="31" Background="#702B1A0D" Visibility="{Binding IsVariantEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="520" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel><TextBlock Text="{Binding VariantEditorTitle}" FontSize="20" FontWeight="Bold" /><TextBlock Text="هذا مقاس ثابت يختاره موظف الاستقبال كما هو." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><controls:FormField Label="اسم المقاس"><TextBox x:Name="VariantNameBox" Text="{Binding VariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم المقاس" /></controls:FormField><UniformGrid Columns="3" Margin="-5,16,-5,0"><StackPanel Margin="5,0"><controls:FormField Label="العرض (cm)"><TextBox Text="{Binding VariantWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></controls:FormField></StackPanel><StackPanel Margin="5,0"><controls:FormField Label="الارتفاع (cm)"><TextBox Text="{Binding VariantHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></controls:FormField></StackPanel><StackPanel Margin="5,0"><controls:FormField Label="العمق (cm)"><TextBox Text="{Binding VariantDepth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></controls:FormField></StackPanel></UniformGrid><TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveVariantClick" automation:AutomationProperties.Name="حفظ المقاس"><TextBlock Text="حفظ المقاس" Foreground="White" /></Button><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelVariantClick" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="32" Background="#702B1A0D" Visibility="{Binding IsColorEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="500" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel FlowDirection="RightToLeft"><TextBlock Text="إضافة لون" FontSize="20" FontWeight="Bold" /><TextBlock Text="أضف خياراً واضحاً مع فرق السعر الذي سيظهر لاحقاً." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><controls:FormField Label="اسم اللون"><TextBox x:Name="ColorNameBox" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم اللون" /></controls:FormField><controls:FormField Label="تعديل السعر" Margin="0,17,0,0"><TextBox Text="{Binding ColorPriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر اللون" /></controls:FormField><controls:FormField Label="اللون المعروض" Margin="0,17,0,0" ErrorText="{Binding EditorError}"><ComboBox ItemsSource="{Binding ColorSwatchOptions}" SelectedItem="{Binding ColorSwatchHex}" Style="{StaticResource SelectInput}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="درجة لون المنتج" /></controls:FormField><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveColorClick" automation:AutomationProperties.Name="حفظ اللون"><TextBlock Text="حفظ اللون" Foreground="White" /></Button><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelColorClick" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="33" Background="#702B1A0D" Visibility="{Binding IsHandleEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="500" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel FlowDirection="RightToLeft"><TextBlock Text="إضافة مقبض" FontSize="20" FontWeight="Bold" /><TextBlock Text="أضف المقبض مع فرق السعر الذي سيراه موظف الاستقبال." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><controls:FormField Label="اسم المقبض"><TextBox x:Name="HandleNameBox" Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="اسم المقبض" /></controls:FormField><controls:FormField Label="تعديل السعر" Margin="0,17,0,0" HelpText="سيُختار الرسم المناسب تلقائياً في المعاينة."><TextBox Text="{Binding HandlePriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر المقبض" /></controls:FormField><TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveHandleClick" automation:AutomationProperties.Name="حفظ المقبض"><TextBlock Text="حفظ المقبض" Foreground="White" /></Button><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CancelHandleClick" /></StackPanel></StackPanel></Border></Border>

        <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:03" Dismissed="FeedbackDismissed" Margin="28" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}" Panel.ZIndex="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
