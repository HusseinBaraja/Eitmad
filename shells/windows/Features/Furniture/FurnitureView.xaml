 /><Border Grid.Column="2" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF7E9" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Background" Value="#F0ECE8" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusLabel}" Foreground="#28733C" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#28733C" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Foreground" Value="#756D66" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><Button Grid.Column="3" Content="{Binding ToggleActionLabel}" Style="{StaticResource FurnitureGhostButton}" Click="ToggleColorClick" automation:AutomationProperties.Name="تغيير حالة اللون" HorizontalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>

                        <Grid FlowDirection="LeftToRight" Margin="0,22,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="45" Click="AddHandleClick" automation:AutomationProperties.Name="إضافة مقبض"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="17" Height="17" Fill="White" /><TextBlock Text="إضافة مقبض" Foreground="White" Margin="8,0,0,0" /></StackPanel></Button><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="المقابض المتاحة" FontSize="24" FontWeight="Bold" /><TextBlock Text="ما يراه موظف الاستقبال كاختيار جاهز، مع فرق السعر بوضوح." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <ItemsControl ItemsSource="{Binding Handles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="188" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="64" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" CornerRadius="9" Padding="9,4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF7E9" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Background" Value="#F0ECE8" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#28733C" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Foreground" Value="#756D66" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Grid.Column="1" Text="{Binding Name}" TextAlignment="Right" FontSize="14" FontWeight="Bold" /></Grid><Border Grid.Row="1" Background="#F7F1EB" CornerRadius="9" Margin="0,12,0,8"><Canvas Width="122" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Canvas.Left="18" Canvas.Top="24" Width="86" Height="8" RadiusX="4" Fill="{Binding HandleBrush}" /><Ellipse Canvas.Left="15" Canvas.Top="20" Width="16" Height="16" Fill="{Binding HandleAccentBrush}" /><Ellipse Canvas.Left="91" Canvas.Top="20" Width="16" Height="16" Fill="{Binding HandleAccentBrush}" /><Rectangle Canvas.Left="38" Canvas.Top="16" Width="46" Height="3" RadiusX="1.5" Fill="{Binding HandleAccentBrush}" /></Canvas></Border><Grid Grid.Row="2" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="{Binding ToggleActionLabel}" Style="{StaticResource FurnitureGhostButton}" Click="ToggleHandleClick" automation:AutomationProperties.Name="تغيير حالة المقبض" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="PricingStep" Visibility="{Binding IsStepFive, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#2F2117" CornerRadius="10" Padding="14,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPricing}" Width="18" Height="18" Fill="#E7C295" /><TextBlock Text="YER" Foreground="#F8E9D7" FontWeight="Bold" Margin="8,0,0,0" FlowDirection="LeftToRight" /></StackPanel></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تسعير المقاسات" FontSize="24" FontWeight="Bold" /><TextBlock Text="حدّد سعر البيع لكل مقاس. يظهر هامش الربح مباشرة للمقارنة." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>
                        <Border Background="#FBF4EC" BorderBrush="#E2C8AC" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,12"><TextBlock Text="التكلفة للمرجع فقط. سعر البيع هو القيمة التي ستظهر للعميل." Foreground="#704217" FontSize="10" /></Border>
                        <ItemsControl ItemsSource="{Binding Variants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="300" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="20,17" VerticalAlignment="Center"><TextBlock Text="{Binding MarginCaption}" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,6,0,0"><TextBlock Text="{Binding MarginLabel}" FontSize="16" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#28733C" /><Style.Triggers><DataTrigger Binding="{Binding HasNegativeMargin}" Value="True"><Setter Property="Foreground" Value="#A13B27" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="YER" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel>
                                            <Border Grid.Column="1" Background="#F7E9DA" BorderBrush="#D6B48F" BorderThickness="1,0" Padding="20,15"><StackPanel><TextBlock Text="سعر البيع" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" /><Grid FlowDirection="LeftToRight" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SellingPriceInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" Height="50" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Padding="12,0" VerticalContentAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right" BorderBrush="#B97A3E" automation:AutomationProperties.Name="سعر بيع المقاس" /><TextBlock Grid.Column="1" Text="YER" Foreground="#6F3B0D" FontSize="11" FontWeight="Bold" Margin="10,0,0,3" VerticalAlignment="Bottom" /></Grid></StackPanel></Border>
                                            <StackPanel Grid.Column="2" Margin="20,17" VerticalAlignment="Center"><TextBlock Text="التكلفة" Foreground="{StaticResource MutedBrush}" FontSize="9" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,6,0,0"><TextBlock Text="{Binding CalculatedCostLabel}" FontSize="15" FontWeight="SemiBold" Foreground="#51483F" /><TextBlock Text="YER" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel>
                                            <StackPanel Grid.Column="3" FlowDirection="RightToLeft" Margin="22,16" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ReviewStep" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}">
                        <Grid FlowDirection="LeftToRight" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#E9F4E8" CornerRadius="10" Padding="13,7" VerticalAlignment="Center"><TextBlock Text="للقراءة فقط" Foreground="#28733C" FontSize="9" FontWeight="SemiBold" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="مراجعة المنتج" FontSize="24" FontWeight="Bold" /><TextBlock Text="راجع المعلومات والخيارات قبل الحفظ أو النشر." Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Grid>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
                            <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="168" Background="#F2E7DB" CornerRadius="11" ClipToBounds="True"><Grid><Image Source="{Binding ProductImage}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style></Image><Canvas Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Canvas.Left="14" Canvas.Top="8" Width="84" Height="88" RadiusX="6" Fill="#9A6237" /><Rectangle Canvas.Left="20" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#B97D46" /><Rectangle Canvas.Left="58" Canvas.Top="14" Width="34" Height="76" RadiusX="3" Fill="#8B5026" /><Ellipse Canvas.Left="49" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" /><Ellipse Canvas.Left="59" Canvas.Top="52" Width="5" Height="5" Fill="#4B260B" /></Canvas></Grid></Border>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center"><TextBlock Text="المنتج" Foreground="#8B4D17" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="{Binding EditorName}" FontSize="23" FontWeight="Bold" Margin="0,7,0,0" /><Border Background="#F3ECE5" CornerRadius="9" Padding="10,4" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock Text="{Binding EditorCategory}" FontSize="9" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding ReviewDescription}" Foreground="#5D554E" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" MaxWidth="570" /></StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="المقاسات والأسعار" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Variants}" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="274" MinHeight="128" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" /><TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" /><Separator Margin="0,12,0,9" Background="{StaticResource LineBrush}" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right"><TextBlock Text="{Binding SellingPriceLabel}" Foreground="#6F3B0D" FontSize="17" FontWeight="Bold" /><TextBlock Text="YER" Foreground="#8B4D17" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,2" VerticalAlignment="Bottom" /></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="المقابض المتاحة" FontSize="16" FontWeight="Bold" /><TextBlock Text="المقابض النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" /><ItemsControl ItemsSource="{Binding Handles}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Border Width="48" Height="24" Background="#F7F1EB" CornerRadius="6" Margin="0,0,9,0"><Rectangle Width="30" Height="5" RadiusX="2.5" Fill="{Binding HandleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="الألوان المتاحة" FontSize="16" FontWeight="Bold" /><TextBlock Text="الألوان النشطة وفرق السعر" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,12" /><ItemsControl ItemsSource="{Binding Colors}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PriceAdjustmentLabel}" FlowDirection="LeftToRight" Foreground="#6F3B0D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Border Width="24" Height="24" CornerRadius="12" Background="{Binding SwatchBrush}" BorderBrush="#CFC4B9" BorderThickness="1" Margin="0,0,9,0" /><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="إلغاء" Click="CancelEditorClick" automation:AutomationProperties.Name="إلغاء إنشاء الأثاث"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FurnitureSecondaryButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Grid.Column="1" Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasEditorError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepSix}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="السابق" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FurnitureSecondaryButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="NextButton" Content="التالي" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="108" Click="NextStepClick" automation:AutomationProperties.Name="الخطوة التالية" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" Visibility="{Binding IsStepSix, Converter={StaticResource BooleanToVisibility}}"><Button Content="السابق" Style="{StaticResource FurnitureSecondaryButton}" Margin="0,0,9,0" Click="PreviousStepClick" automation:AutomationProperties.Name="الخطوة السابقة من المراجعة" /><Button Content="حفظ كمسودة" Style="{StaticResource FurnitureSecondaryButton}" Margin="0,0,9,0" Click="SaveDraftClick" automation:AutomationProperties.Name="حفظ الأثاث كمسودة" /><Button Content="حفظ ونشر" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="126" Click="PublishClick" automation:AutomationProperties.Name="حفظ الأثاث ونشره" /></StackPanel></Grid></Border>
        </Grid>

        <Border Panel.ZIndex="30" Background="#702B1A0D" Visibility="{Binding IsPartPickerOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="570" MaxHeight="560" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="اختر جزءاً" FontSize="20" FontWeight="Bold" /><TextBlock Grid.Row="0" Text="يُضاف الجزء بكمية أولية يمكنك تعديلها." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,35,0,0" /><TextBox x:Name="PartSearchBox" Grid.Row="1" Text="{Binding PartSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" Margin="0,18,0,12" automation:AutomationProperties.Name="البحث عن جزء متاح" /><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FilteredParts}"><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,0,8" Padding="14,11" Background="#FBF8F5" BorderBrush="#E4D9CF" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="SelectPartClick" automation:AutomationProperties.Name="اختيار الجزء"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5E8DB" /><Setter TargetName="Surface" Property="BorderBrush" Value="#BD8A5B" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center"><TextBlock Text="{Binding UnitCostLabel}" FontWeight="SemiBold" /><TextBlock Text="YER" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button Grid.Row="3" Content="إغلاق" Style="{StaticResource FurnitureSecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ClosePartPickerClick" /></Grid></Border></Border>

        <Border Panel.ZIndex="31" Background="#702B1A0D" Visibility="{Binding IsVariantEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="520" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel><TextBlock Text="{Binding VariantEditorTitle}" FontSize="20" FontWeight="Bold" /><TextBlock Text="هذا مقاس ثابت يختاره موظف الاستقبال كما هو." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><TextBlock Text="اسم المقاس" Style="{StaticResource FurnitureFieldLabel}" /><TextBox x:Name="VariantNameBox" Text="{Binding VariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" automation:AutomationProperties.Name="اسم المقاس" /><UniformGrid Columns="3" Margin="-5,16,-5,0"><StackPanel Margin="5,0"><TextBlock Text="العرض (cm)" Style="{StaticResource FurnitureFieldLabel}" /><TextBox Text="{Binding VariantWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel><StackPanel Margin="5,0"><TextBlock Text="الارتفاع (cm)" Style="{StaticResource FurnitureFieldLabel}" /><TextBox Text="{Binding VariantHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel><StackPanel Margin="5,0"><TextBlock Text="العمق (cm)" Style="{StaticResource FurnitureFieldLabel}" /><TextBox Text="{Binding VariantDepth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel></UniformGrid><TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Content="حفظ المقاس" Style="{StaticResource PrimaryButton}" Height="43" Click="SaveVariantClick" automation:AutomationProperties.Name="حفظ المقاس" /><Button Content="إلغاء" Style="{StaticResource FurnitureSecondaryButton}" Margin="9,0,0,0" Click="CancelVariantClick" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="32" Background="#702B1A0D" Visibility="{Binding IsColorEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="500" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel FlowDirection="RightToLeft"><TextBlock Text="إضافة لون" FontSize="20" FontWeight="Bold" /><TextBlock Text="أضف خياراً واضحاً مع فرق السعر الذي سيظهر لاحقاً." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><TextBlock Text="اسم اللون" Style="{StaticResource FurnitureFieldLabel}" /><TextBox x:Name="ColorNameBox" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" automation:AutomationProperties.Name="اسم اللون" /><TextBlock Text="تعديل السعر" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><TextBox Text="{Binding ColorPriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر اللون" /><TextBlock Text="اللون المعروض" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><ComboBox ItemsSource="{Binding ColorSwatchOptions}" SelectedItem="{Binding ColorSwatchHex}" Style="{StaticResource FurnitureComboBox}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="درجة لون المنتج" /><TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Content="حفظ اللون" Style="{StaticResource PrimaryButton}" Height="43" Click="SaveColorClick" automation:AutomationProperties.Name="حفظ اللون" /><Button Content="إلغاء" Style="{StaticResource FurnitureSecondaryButton}" Margin="9,0,0,0" Click="CancelColorClick" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="33" Background="#702B1A0D" Visibility="{Binding IsHandleEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="500" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel FlowDirection="RightToLeft"><TextBlock Text="إضافة مقبض" FontSize="20" FontWeight="Bold" /><TextBlock Text="أضف المقبض مع فرق السعر الذي سيراه موظف الاستقبال." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,18" /><TextBlock Text="اسم المقبض" Style="{StaticResource FurnitureFieldLabel}" /><TextBox x:Name="HandleNameBox" Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FurnitureTextInput}" automation:AutomationProperties.Name="اسم المقبض" /><TextBlock Text="تعديل السعر" Style="{StaticResource FurnitureFieldLabel}" Margin="0,17,0,7" /><TextBox Text="{Binding HandlePriceAdjustment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" FlowDirection="LeftToRight" automation:AutomationProperties.Name="تعديل سعر المقبض" /><TextBlock Text="سيُختار الرسم المناسب تلقائياً في المعاينة." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,15,0,0" /><TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,10,0,0" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,22,0,0"><Button Content="حفظ المقبض" Style="{StaticResource PrimaryButton}" Height="43" Click="SaveHandleClick" automation:AutomationProperties.Name="حفظ المقبض" /><Button Content="إلغاء" Style="{StaticResource FurnitureSecondaryButton}" Margin="9,0,0,0" Click="CancelHandleClick" /></StackPanel></StackPanel></Border></Border>

        <Border Margin="28" Padding="18,11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="40" Background="#3B240F" CornerRadius="9" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding FeedbackMessage}" Foreground="White" FontSize="11" /></Border>
    </Grid>
</UserControl>
