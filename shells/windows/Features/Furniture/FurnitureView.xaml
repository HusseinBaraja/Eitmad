                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="230"><Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0" Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><TextBlock Text="الجزء" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="1" Text="الكمية" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="2" Text="تكلفة الوحدة" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="3" Text="التكلفة الإجمالية" Style="{StaticResource FurnitureHeaderCell}" /><TextBlock Grid.Column="4" Text="إزالة" Style="{StaticResource FurnitureHeaderCell}" /></Grid><ItemsControl x:Name="PartRows" Grid.Row="1" ItemsSource="{Binding SelectedParts}"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="64" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="18,7"><TextBlock Text="{Binding Part.Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Part.Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel><TextBox Grid.Column="1" Width="86" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FurnitureTextInput}" BorderThickness="1,1,1,2" FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="كمية الجزء" /><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding UnitCostLabel}" Style="{StaticResource FurnitureBodyCell}" /><TextBlock Text="YER" Style="{StaticResource FurnitureBodyCell}" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding TotalCostLabel}" Style="{StaticResource FurnitureBodyCell}" FontWeight="SemiBold" /><TextBlock Text="YER" Style="{StaticResource FurnitureBodyCell}" Margin="5,0,0,0" /></StackPanel><Button Grid.Column="4" Content="×" Style="{StaticResource FurnitureRowActionButton}" Foreground="#A13B27" Click="RemovePartClick" automation:AutomationProperties.Name="إزالة الجزء" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                        <Border Background="#2F2117" CornerRadius="12" Padding="24,18" Margin="0,16,0,0"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentPartsCostLabel}" Foreground="White" FontSize="29" FontWeight="Bold" /><TextBlock Text="YER" Foreground="#DDBD9B" FontSize="13" Margin="9,0,0,3" VerticalAlignment="Bottom" /></StackPanel><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تكلفة الأجزاء الحالية" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="تُحدّث مع كل تغيير في الكمية" Foreground="#D8C8B8" FontSize="9" /></StackPanel></Grid></Border>
                    </StackPanel>

                    <StackPanel x:Name="VariantsStep" Visibility="{Binding IsStepThree, Converter={StaticResource BooleanToVisibility}}">
