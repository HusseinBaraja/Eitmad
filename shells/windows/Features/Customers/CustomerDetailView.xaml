<UserControl x:Class="Eitmad.WindowsShell.Features.Customers.CustomerDetailView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 xmlns:customers="clr-namespace:Eitmad.WindowsShell.Features.Customers"
 FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource CanvasBrush}">
 <UserControl.Resources>
  <Style x:Key="CustomerEditAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Style.Triggers><DataTrigger Binding="{Binding ReadOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HistoryValue" TargetType="TextBlock" BasedOn="{StaticResource TableBody}">
   <Setter Property="FlowDirection" Value="LeftToRight"/>
  </Style>
  <Style x:Key="ContactValue" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <controls:PageHeader Title="تفاصيل العميل">
   <Button x:Name="BackButton" Content="العودة" Style="{StaticResource InlineActionButton}" Click="BackClick" AutomationProperties.Name="العودة من تفاصيل العميل"/>
  </controls:PageHeader>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel Margin="28,20,28,28">
    <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,24" MaxWidth="760" HorizontalAlignment="Left">
     <StackPanel>
      <Grid Margin="0,0,0,20" HorizontalAlignment="Left">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SyncStateLabel}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0">
         <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
           <Style.Triggers><DataTrigger Binding="{Binding HasSyncConflict}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <controls:StatusBadge x:Name="ConflictStatus" Text="{Binding SyncStateLabel}" Tone="Warning" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasSyncConflict, Converter={StaticResource BooleanToVisibility}}">
         <controls:StatusBadge.Icon><Path Data="{StaticResource IconAlert}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:StatusBadge}}"/></controls:StatusBadge.Icon>
        </controls:StatusBadge>
       </StackPanel>
       <Button x:Name="EditButton" Grid.Column="1" Content="تعديل" Click="EditClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource CustomerEditAction}" AutomationProperties.Name="تعديل بيانات العميل" VerticalAlignment="Top" Margin="24,0,0,0"/>
      </Grid>
      <controls:FeedbackNotice x:Name="ConflictNotice" Tone="Warning" Margin="0,0,0,18" Visibility="{Binding HasSyncConflict, Converter={StaticResource BooleanToVisibility}}"
       Message="التعديل متوقف بسبب تعارض في المزامنة. يراجع المدير النسختين ويعتمد البيانات بعد تأكيد الخادم."/>
      <Button x:Name="ResolveButton" Content="مراجعة التعارضات" Style="{StaticResource SecondaryButton}" Click="ResolveClick" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed" AutomationProperties.Name="مراجعة تعارضات العميل والتعديلات المعلقة"/>
      <layout:AdaptiveFieldsPanel MinItemWidth="240">
       <controls:FormField Label="الفرع"><TextBlock Text="{Binding BranchId}" FlowDirection="LeftToRight" Style="{StaticResource ContactValue}"/></controls:FormField>
       <controls:FormField Label="رقم الهاتف"><TextBlock Text="{Binding Phone}" FlowDirection="LeftToRight" TextAlignment="Right" Style="{StaticResource ContactValue}"/></controls:FormField>
       <controls:FormField Label="العنوان"><TextBlock Text="{Binding Address}" Style="{StaticResource ContactValue}"/></controls:FormField>
      </layout:AdaptiveFieldsPanel>
      <controls:FormField Label="ملاحظات" Margin="0,18,0,0"><TextBlock Text="{Binding Notes}" Style="{StaticResource ContactValue}"/></controls:FormField>
     </StackPanel>
    </Border>
    <TextBlock Text="{Binding HistoryNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Button x:Name="HistoryNextButton" Content="صفحة السجل التالية" Click="HistoryNextClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding HasMoreHistory, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="الصفحة التالية من سجل العميل"/>
    <TextBlock Text="عروض الأسعار" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>
    <controls:OperationsTable x:Name="QuotationsTable" ItemsSource="{Binding Quotations}" RowHeight="58" MaxHeight="250" AutomationProperties.Name="عروض أسعار العميل">
     <controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا توجد عروض أسعار لهذا العميل"/></controls:OperationsTable.EmptyContent>
     <DataGrid.Columns>
      <DataGridTextColumn Header="رقم العرض" Binding="{Binding Number}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="التاريخ" controls:OperationsTable.IsCompactDetail="True" Binding="{Binding DateLabel}" SortMemberPath="Date" Width="*" MinWidth="110" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="الأصناف" controls:OperationsTable.IsCompactDetail="True" Binding="{Binding Items}" Width="2*" MinWidth="180" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="*" MinWidth="130" ElementStyle="{StaticResource HistoryValue}" CanUserSort="False"/>
     </DataGrid.Columns>
    </controls:OperationsTable>
    <TextBlock Text="الطلبات" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,24,0,12"/>
    <controls:OperationsTable x:Name="OrdersTable" ItemsSource="{Binding Orders}" RowHeight="58" MaxHeight="250" AutomationProperties.Name="طلبات العميل">
     <controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا توجد طلبات لهذا العميل"/></controls:OperationsTable.EmptyContent>
     <DataGrid.Columns>
      <DataGridTextColumn Header="رقم الطلب" Binding="{Binding Number}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="التاريخ" controls:OperationsTable.IsCompactDetail="True" Binding="{Binding DateLabel}" SortMemberPath="Date" Width="*" MinWidth="110" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="الأصناف" controls:OperationsTable.IsCompactDetail="True" Binding="{Binding Items}" Width="2*" MinWidth="180" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="*" MinWidth="130" ElementStyle="{StaticResource HistoryValue}" CanUserSort="False"/>
     </DataGrid.Columns>
    </controls:OperationsTable>
   </StackPanel>
  </ScrollViewer>
  <customers:CustomerEditorView x:Name="Editor" Grid.RowSpan="2"/>
  <customers:CustomerResolutionView x:Name="Resolution" Grid.RowSpan="2"/>
 </Grid>
</UserControl>
