<UserControl x:Class="Eitmad.WindowsShell.Features.Customers.CustomerDetailView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 xmlns:customers="clr-namespace:Eitmad.WindowsShell.Features.Customers"
 FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource CanvasBrush}">
 <UserControl.Resources>
  <Style x:Key="HistoryValue" TargetType="TextBlock" BasedOn="{StaticResource TableBody}">
   <Setter Property="FlowDirection" Value="LeftToRight"/>
  </Style>
  <Style x:Key="ContactValue" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <controls:PageHeader Title="تفاصيل العميل" Subtitle="بيانات الاتصال محفوظة في محرك الاعتماد">
   <Button x:Name="BackButton" Content="العودة" Style="{StaticResource InlineActionButton}" Click="BackClick" AutomationProperties.Name="العودة من تفاصيل العميل"/>
  </controls:PageHeader>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel Margin="28,20,28,28">
    <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,24">
     <StackPanel>
      <Grid Margin="0,0,0,20" FlowDirection="LeftToRight">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="EditButton" Content="تعديل" Click="EditClick" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="تعديل بيانات العميل" Margin="0,0,20,0"/>
       <TextBlock Grid.Column="1" Text="{Binding Name}" FlowDirection="RightToLeft" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>
      <layout:AdaptiveFieldsPanel MinItemWidth="240">
       <controls:FormField Label="رقم الهاتف"><TextBlock Text="{Binding Phone}" FlowDirection="LeftToRight" TextAlignment="Right" Style="{StaticResource ContactValue}"/></controls:FormField>
       <controls:FormField Label="العنوان"><TextBlock Text="{Binding Address}" Style="{StaticResource ContactValue}"/></controls:FormField>
      </layout:AdaptiveFieldsPanel>
      <controls:FormField Label="ملاحظات" Margin="0,18,0,0"><TextBlock Text="{Binding Notes}" Style="{StaticResource ContactValue}"/></controls:FormField>
     </StackPanel>
    </Border>
    <TextBlock Text="عروض الأسعار" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>
    <controls:OperationsTable x:Name="QuotationsTable" ItemsSource="{Binding Quotations}" RowHeight="58" MaxHeight="250" AutomationProperties.Name="عروض أسعار العميل">
     <controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا توجد عروض أسعار لهذا العميل"/></controls:OperationsTable.EmptyContent>
     <DataGrid.Columns>
      <DataGridTextColumn Header="رقم العرض" Binding="{Binding Number}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="التاريخ" Binding="{Binding DateLabel}" SortMemberPath="Date" Width="*" MinWidth="110" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="الأصناف" Binding="{Binding Items}" Width="2*" MinWidth="180" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="*" MinWidth="130" ElementStyle="{StaticResource HistoryValue}" CanUserSort="False"/>
     </DataGrid.Columns>
    </controls:OperationsTable>
    <TextBlock Text="الطلبات" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,24,0,12"/>
    <controls:OperationsTable x:Name="OrdersTable" ItemsSource="{Binding Orders}" RowHeight="58" MaxHeight="250" AutomationProperties.Name="طلبات العميل">
     <controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا توجد طلبات لهذا العميل"/></controls:OperationsTable.EmptyContent>
     <DataGrid.Columns>
      <DataGridTextColumn Header="رقم الطلب" Binding="{Binding Number}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="التاريخ" Binding="{Binding DateLabel}" SortMemberPath="Date" Width="*" MinWidth="110" ElementStyle="{StaticResource HistoryValue}"/>
      <DataGridTextColumn Header="الأصناف" Binding="{Binding Items}" Width="2*" MinWidth="180" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableBody}"/>
      <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="*" MinWidth="130" ElementStyle="{StaticResource HistoryValue}" CanUserSort="False"/>
     </DataGrid.Columns>
    </controls:OperationsTable>
   </StackPanel>
  </ScrollViewer>
  <customers:CustomerEditorView x:Name="Editor" Grid.RowSpan="2"/>
 </Grid>
</UserControl>
