<UserControl x:Class="Eitmad.WindowsShell.Features.Home.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources>
  <!-- One sale moves through these four stages. The band shows where the work is waiting. -->
  <Style x:Key="PipelineBand" TargetType="UniformGrid">
   <Setter Property="Columns" Value="4"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Columns" Value="2"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- A flat row inside a card: the card owns the frame, the row only tints on hover. -->
  <Style x:Key="HomeSurfaceButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="controls:ControlOptions.CornerRadius" Value="0"/>
   <Setter Property="controls:ControlOptions.HoverBackground" Value="{StaticResource AccentSoftBrush}"/>
  </Style>
  <Style x:Key="PipelineStage" TargetType="Button" BasedOn="{StaticResource HomeSurfaceButton}">
   <Setter Property="Padding" Value="20,16"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <!-- Counts are LTR numerals placed at the reading start under their label. -->
  <Style x:Key="StageCount" TargetType="TextBlock" BasedOn="{StaticResource ButtonText}">
   <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FlowDirection" Value="LeftToRight"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>
  <Style x:Key="ReadyCount" TargetType="TextBlock" BasedOn="{StaticResource StageCount}">
   <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
  </Style>
  <!-- The chevron between stages points along the reading direction to the next stage. -->
  <Style x:Key="StageConnector" TargetType="Path">
   <Setter Property="Data" Value="M1,2 L6,8 L1,14"/>
   <Setter Property="Stroke" Value="{StaticResource LineStrongBrush}"/>
   <Setter Property="StrokeThickness" Value="1.5"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="Width" Value="8"/>
   <Setter Property="Height" Value="16"/>
   <Setter Property="HorizontalAlignment" Value="Right"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,-4,0"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="HomeSectionMessage" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Margin" Value="20,4,20,18"/>
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
   <Setter Property="Margin" Value="20,16,20,12"/>
  </Style>
  <Style x:Key="HomeRecordButton" TargetType="Button" BasedOn="{StaticResource HomeSurfaceButton}">
   <Setter Property="Padding" Value="20,10"/>
  </Style>
  <DataTemplate x:Key="HomeRecordContent">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    <Border Grid.Column="1" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding State}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource InkSecondaryBrush}" TextWrapping="NoWrap"/>
    </Border>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3,0,0">
     <TextBlock Text="{Binding Kind}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
     <TextBlock Text="{Binding Number}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource InkSecondaryBrush}" FlowDirection="LeftToRight" Margin="0,0,14,0"/>
     <TextBlock Text="{Binding Date}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="HomeRecord">
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
    <Button Style="{StaticResource HomeRecordButton}" Content="{Binding}" ContentTemplate="{StaticResource HomeRecordContent}" Click="OpenClick" AutomationProperties.Name="{Binding OpenName}"/>
   </Border>
  </DataTemplate>
  <!-- Two working lists side by side; one column when the window is narrow. -->
  <Style x:Key="ReadyPanelPlacement" TargetType="Border" BasedOn="{StaticResource Card}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ActivityPanelPlacement" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Grid.Column" Value="2"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
     <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Margin" Value="0,16,0,0"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <!-- Pipeline band -->
  <Border Style="{StaticResource Card}">
   <UniformGrid x:Name="MetricsGrid" Style="{StaticResource PipelineBand}" Margin="1">
    <Grid>
     <Button x:Name="QuotationsAction" Style="{StaticResource PipelineStage}" Click="QuotationsClick" AutomationProperties.Name="{Binding OpenCount, StringFormat='عروض أسعار مفتوحة: {0}', FallbackValue='عروض أسعار مفتوحة'}">
      <StackPanel><TextBlock Text="عروض أسعار مفتوحة" Style="{StaticResource ButtonMutedText}"/><TextBlock Text="{Binding OpenCount, FallbackValue=—}" Style="{StaticResource StageCount}"/></StackPanel>
     </Button>
     <Path Style="{StaticResource StageConnector}"/>
    </Grid>
    <Grid>
     <Button x:Name="ApprovalsAction" Style="{StaticResource PipelineStage}" Click="ApprovalsClick" AutomationProperties.Name="{Binding ApprovalCount, StringFormat='بانتظار الموافقة: {0}', FallbackValue='بانتظار الموافقة'}">
      <StackPanel><TextBlock Text="بانتظار الموافقة" Style="{StaticResource ButtonMutedText}"/><TextBlock Text="{Binding ApprovalCount, FallbackValue=—}" Style="{StaticResource StageCount}"/></StackPanel>
     </Button>
     <Path Style="{StaticResource StageConnector}"/>
    </Grid>
    <Grid>
     <Button x:Name="OrdersAction" Style="{StaticResource PipelineStage}" Click="OrdersClick" AutomationProperties.Name="{Binding OrderCount, StringFormat='طلبات قيد التنفيذ: {0}', FallbackValue='طلبات قيد التنفيذ'}">
      <StackPanel><TextBlock Text="طلبات قيد التنفيذ" Style="{StaticResource ButtonMutedText}"/><TextBlock Text="{Binding OrderCount, FallbackValue=—}" Style="{StaticResource StageCount}"/></StackPanel>
     </Button>
     <Path Style="{StaticResource StageConnector}"/>
    </Grid>
    <Button x:Name="ReadyAction" Style="{StaticResource PipelineStage}" Click="ReadyOrdersClick" AutomationProperties.Name="{Binding ReadyCount, StringFormat='طلبات جاهزة للعميل: {0}', FallbackValue='طلبات جاهزة للعميل'}">
     <StackPanel><TextBlock Text="جاهزة للعميل" Style="{StaticResource ButtonMutedText}"/><TextBlock Text="{Binding ReadyCount, FallbackValue=—}" Style="{StaticResource ReadyCount}"/></StackPanel>
    </Button>
   </UniformGrid>
  </Border>

  <!-- Working lists -->
  <Grid Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="ReadyOrdersPanel" Style="{StaticResource ReadyPanelPlacement}" VerticalAlignment="Top">
    <StackPanel>
     <TextBlock Text="طلبات جاهزة للعميل" Style="{StaticResource PanelHeading}"/>
     <TextBlock x:Name="ReadyOrdersMessage" Text="{Binding ReadyOrdersMessage, FallbackValue=''}" Style="{StaticResource HomeSectionMessage}"/>
     <ItemsControl ItemsSource="{Binding ReadyOrders}" ItemTemplate="{StaticResource HomeRecord}" Focusable="False"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource ActivityPanelPlacement}" VerticalAlignment="Top">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ActivityTitle, FallbackValue=آخر نشاط}" Style="{StaticResource PanelHeading}"/>
      <StackPanel x:Name="SearchContext" Grid.Column="1" Margin="20,0" VerticalAlignment="Center" Visibility="{Binding HasSearchTerm, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
       <Button x:Name="ClearSearchButton" Content="مسح البحث" Style="{StaticResource LinkButton}" Click="ClearSearchClick" AutomationProperties.Name="مسح البحث وعرض آخر نشاط"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="ActivityMessage" Text="{Binding ActivityMessage, FallbackValue=''}" Style="{StaticResource HomeSectionMessage}"/>
     <ItemsControl ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource HomeRecord}" Focusable="False"/>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Data freshness: quiet, at the end, with one recovery action. -->
  <Grid x:Name="AvailabilityPanel" Margin="2,14,2,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Notice, FallbackValue=بيانات الرئيسية غير متاحة.}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="إعادة تحميل البيانات" Style="{StaticResource LinkButton}" FontSize="{StaticResource FontSizeSmall}" Margin="16,0,0,0" Click="RefreshClick" AutomationProperties.Name="إعادة تحميل بيانات الرئيسية"/>
  </Grid>
 </StackPanel>
</UserControl>
