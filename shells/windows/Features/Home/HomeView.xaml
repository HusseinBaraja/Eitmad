<UserControl x:Class="Eitmad.WindowsShell.Features.Home.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources>
  <Style x:Key="ManagerOnly" TargetType="FrameworkElement">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ReceptionOnly" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeMetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Padding" Value="16"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeMetricCount" TargetType="TextBlock">
   <Setter Property="Grid.Column" Value="1"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Margin" Value="12,0,0,0"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
    <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/><Setter Property="FontSize" Value="25"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="HorizontalAlignment" Value="Left"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeMetrics" TargetType="UniformGrid">
   <Setter Property="Columns" Value="4"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Columns" Value="2"/></DataTrigger>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}"><Setter Property="Columns" Value="2"/></DataTrigger>
    <DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Columns" Value="2"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- Alignment is relative to the RTL parent; keep LTR counts under their labels. -->
  <Style x:Key="HomeCount" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style x:Key="HomeSectionMessage" TargetType="TextBlock">
   <Setter Property="Margin" Value="0,8"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeRecordButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="8"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <DataTemplate x:Key="HomeRecordContent">
   <StackPanel>
    <WrapPanel>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding State}" TextWrapping="Wrap"/>
    </WrapPanel>
    <WrapPanel Margin="0,4,0,0">
     <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
     <TextBlock Text="{Binding Number}" FlowDirection="LeftToRight" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding Date}" FlowDirection="LeftToRight" Foreground="{StaticResource MutedBrush}"/>
    </WrapPanel>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="AvailabilityPanel">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="Grid.Row" Value="0"/><Setter Property="Padding" Value="0,0,0,8"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
      <Setter Property="Grid.Row" Value="4"/><Setter Property="Margin" Value="0,20,0,0"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,12,0,0"/>
     </DataTrigger></Style.Triggers>
    </Style>
   </Border.Style>
   <StackPanel>
    <TextBlock Text="حالة البيانات" FontWeight="SemiBold" Margin="0,0,0,6" Style="{StaticResource ManagerOnly}"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Notice, FallbackValue=بيانات الرئيسية غير متاحة.}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <Button Content="إعادة تحميل البيانات" Click="RefreshClick" HorizontalAlignment="Left" AutomationProperties.Name="إعادة تحميل بيانات الرئيسية">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
       <Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="12,0,0,0"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers>
      </Style></Button.Style>
     </Button>
    </Grid>
    <TextBlock Text="غير متاح: البحث الشامل في عملاء المؤسسة وتحصيل المدفوعات والمخزون والتركيبات والرسائل وتقارير الأقسام." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" Style="{StaticResource ManagerOnly}"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="1">
   <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,8,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Margin" Value="0,14,0,0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <TextBlock Text="نظرة عامة" FontWeight="SemiBold" Margin="0,0,0,6" Style="{StaticResource ManagerOnly}"/>
   <UniformGrid x:Name="MetricsGrid" Style="{StaticResource HomeMetrics}" Margin="-6,0" layout:ResponsiveLayout.IsEnabled="True">
    <Border Style="{StaticResource HomeMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="عروض أسعار مفتوحة" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding OpenCount, FallbackValue=—}" Style="{StaticResource HomeMetricCount}"/></Grid></Border>
    <Border Style="{StaticResource HomeMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="طلبات قيد التنفيذ" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding OrderCount, FallbackValue=—}" Style="{StaticResource HomeMetricCount}"/></Grid></Border>
    <Border Style="{StaticResource ReceptionOnly}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="بانتظار الموافقة" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding ApprovalCount, FallbackValue=—}" Style="{StaticResource HomeMetricCount}"/></Grid></Border>
    <Border Style="{StaticResource ReceptionOnly}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="طلبات جاهزة للعميل" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding ReadyCount, FallbackValue=—}" Style="{StaticResource HomeMetricCount}"/></Grid></Border>
   </UniformGrid>
  </StackPanel>
  <StackPanel x:Name="OperationalPanel">
   <StackPanel.Style>
    <Style TargetType="StackPanel"><Setter Property="Grid.Row" Value="2"/><Setter Property="Margin" Value="0,12,0,0"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Grid.Row" Value="0"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
    </Style>
   </StackPanel.Style>
   <TextBlock Text="للمتابعة" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" Style="{StaticResource ManagerOnly}"/>
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="ApprovalsPanel" Background="{StaticResource CopperTintBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Top" Style="{StaticResource ManagerOnly}">
     <StackPanel>
      <TextBlock Text="بانتظار الموافقة" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ApprovalCount, FallbackValue=—}" Style="{StaticResource HomeCount}"/>
      <Button Content="فتح الموافقات" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Right" Tag="الموافقات" Click="ApprovalsClick" AutomationProperties.Name="فتح موافقات الخصم"/>
     </StackPanel>
    </Border>
    <Border x:Name="ReadyOrdersPanel" VerticalAlignment="Top">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/><Setter Property="Grid.ColumnSpan" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Padding" Value="16"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="12,0,0,0"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel>
      <TextBlock Text="طلبات جاهزة للعميل" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding ReadyCount, FallbackValue=—}" Style="{StaticResource HomeCount}" Visibility="{Binding IsManagerDashboard, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}"/>
      <TextBlock x:Name="ReadyOrdersMessage" Text="{Binding ReadyOrdersMessage, FallbackValue=تعذر تحميل الطلبات الجاهزة. أعد تحميل البيانات.}" Style="{StaticResource HomeSectionMessage}"/>
      <ItemsControl ItemsSource="{Binding ReadyOrders}"><ItemsControl.ItemTemplate><DataTemplate>
       <Button Style="{StaticResource HomeRecordButton}" Content="{Binding}" ContentTemplate="{StaticResource HomeRecordContent}" Click="OpenClick" AutomationProperties.Name="{Binding OpenName}"/>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
  <StackPanel Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource ManagerOnly}">
   <TextBlock Text="وصول سريع" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <ContentPresenter Content="{Binding QuickRoutes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
  </StackPanel>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"><StackPanel>
   <TextBlock Text="{Binding ActivityTitle, FallbackValue=آخر نشاط}" Style="{StaticResource SectionTitle}"/>
   <StackPanel x:Name="SearchContext" Margin="0,8,0,4" Visibility="{Binding HasSearchTerm, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
    <TextBlock Text="عبارة البحث:" Foreground="{StaticResource MutedBrush}"/>
    <TextBlock x:Name="ActiveSearchTerm" Text="{Binding SearchTerm}" FlowDirection="LeftToRight" TextAlignment="Right" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
    <Button x:Name="ClearSearchButton" Content="مسح البحث وعرض آخر نشاط" Style="{StaticResource LinkButton}" Click="ClearSearchClick" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="مسح البحث وعرض آخر نشاط"/>
   </StackPanel>
   <TextBlock x:Name="ActivityMessage" Text="{Binding ActivityMessage, FallbackValue=تعذر تحميل النشاط. أعد تحميل البيانات.}" Style="{StaticResource HomeSectionMessage}"/>
   <ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button Style="{StaticResource HomeRecordButton}" Content="{Binding}" ContentTemplate="{StaticResource HomeRecordContent}" Click="OpenClick" AutomationProperties.Name="{Binding OpenName}"/>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </Grid>
</UserControl>
