<UserControl x:Class="Eitmad.WindowsShell.Features.Home.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources>
  <Style x:Key="HomeMetrics" TargetType="UniformGrid">
   <Setter Property="Columns" Value="4"/>
   <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Columns" Value="2"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}"><Setter Property="Columns" Value="2"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeCount" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding Notice, FallbackValue=بيانات الرئيسية غير متاحة.}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
  <Button Content="إعادة تحميل البيانات" Style="{StaticResource LinkButton}" Click="RefreshClick" HorizontalAlignment="Left" AutomationProperties.Name="إعادة تحميل بيانات الرئيسية"/>
  <UniformGrid x:Name="MetricsGrid" Style="{StaticResource HomeMetrics}" Margin="-6,6" layout:ResponsiveLayout.IsEnabled="True">
   <Border Style="{StaticResource Card}" Margin="6" Padding="16"><StackPanel><TextBlock Text="عروض أسعار مفتوحة" TextWrapping="Wrap"/><TextBlock Text="{Binding OpenCount, FallbackValue=—}" Style="{StaticResource HomeCount}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="6" Padding="16"><StackPanel><TextBlock Text="طلبات قيد التنفيذ" TextWrapping="Wrap"/><TextBlock Text="{Binding OrderCount, FallbackValue=—}" Style="{StaticResource HomeCount}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="6" Padding="16"><StackPanel><TextBlock Text="بانتظار الموافقة" TextWrapping="Wrap"/><TextBlock Text="{Binding ApprovalCount, FallbackValue=—}" Style="{StaticResource HomeCount}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="6" Padding="16"><StackPanel><TextBlock Text="طلبات جاهزة للعميل" TextWrapping="Wrap"/><TextBlock Text="{Binding ReadyCount, FallbackValue=—}" Style="{StaticResource HomeCount}"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="طلبات جاهزة للعميل" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="لا توجد طلبات جاهزة ضمن النتائج المتاحة" Margin="0,8" TextWrapping="Wrap" Visibility="{Binding HasNoReadyOrders, Converter={StaticResource BooleanToVisibility}}"/>
   <ItemsControl ItemsSource="{Binding ReadyOrders}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button Style="{StaticResource LinkButton}" Click="OpenClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding OpenName}"><StackPanel><TextBlock Text="{Binding Number}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></StackPanel></Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="{Binding ActivityTitle, FallbackValue=آخر نشاط}" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="لا توجد سجلات ضمن النتائج المتاحة" Margin="0,8" TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>
   <ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button Style="{StaticResource ActionButton}" Margin="0,5" Padding="12" Click="OpenClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding OpenName}">
     <StackPanel><TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Number}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="{Binding State}" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></StackPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
