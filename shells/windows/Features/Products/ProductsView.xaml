<UserControl x:Class="Eitmad.WindowsShell.Features.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="ProductFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="ProductTextInput" TargetType="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DED6CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" Background="{TemplateBinding BorderBrush}" CornerRadius="8" Margin="0,0,0,1">
                            <Border x:Name="InputSurface" Background="{TemplateBinding Background}" CornerRadius="7" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="#A35E1E" /><Setter TargetName="InputSurface" Property="Margin" Value="1.5" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="#C69A70" /></Trigger>
                            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputChrome" Property="Background" Value="{StaticResource DangerBrush}" /><Setter TargetName="InputSurface" Property="Margin" Value="1.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductComboItem" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F3E5D7" /><Setter Property="Foreground" Value="#6C390D" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FBF2E9" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DED6CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProductComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F6EEE6" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="Chevron" Data="M3,7 L8,12 L13,7" Stroke="#8B4D17" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" /></Border>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="4,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template></ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                                <Border Width="{Binding ActualWidth, ElementName=InputChrome}" MaxHeight="300" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="4"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" /></Border.Effect><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M3,12 L8,7 L13,12" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductCategoryCombo" TargetType="ComboBox" BasedOn="{StaticResource ProductCombo}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F6EEE6" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="Chevron" Data="M3,7 L8,12 L13,7" Stroke="#8B4D17" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" /></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedValue, RelativeSource={RelativeSource TemplatedParent}}" Margin="4,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template></ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                                <Border Width="{Binding ActualWidth, ElementName=InputChrome}" MaxHeight="340" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="4"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" /></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer><Border Grid.Row="1" BorderBrush="#E6DCD3" BorderThickness="0,1,0,0" Margin="4,4,4,0" Padding="2,7,2,2"><StackPanel><Button Content="+ إضافة فئة" Tag="category" Style="{DynamicResource ProductDropdownAction}" Click="AddCategoryFromDropdownClick" automation:AutomationProperties.Name="إضافة فئة جديدة" /><Button Content="إدارة الفئات" Tag="category" Style="{DynamicResource ProductDropdownAction}" Click="ManageCategoriesFromDropdownClick" automation:AutomationProperties.Name="إدارة فئات المنتجات" /></StackPanel></Border></Grid></Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M3,12 L8,7 L13,12" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductDropdownAction" TargetType="Button">
            <Setter Property="Height" Value="35" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#7B410F" /><Setter Property="HorizontalContentAlignment" Value="Right" /><Setter Property="Padding" Value="11,6" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontSize" Value="11" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FBF0E5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProductSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="43" /><Setter Property="Padding" Value="18,8" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#BBAA9A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#4A3525" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F7F0E8" /><Setter TargetName="Surface" Property="BorderBrush" Value="#98653D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProductCompactButton" TargetType="Button" BasedOn="{StaticResource ProductSecondaryButton}"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="11,5" /><Setter Property="FontSize" Value="10" /></Style>
        <Style x:Key="ProductHeaderCell" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#675F59" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="ProductBodyCell" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style x:Key="ProductRowAction" TargetType="Button"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5E9DC" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ProductMenuItem" TargetType="MenuItem"><Setter Property="FlowDirection" Value="RightToLeft" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="Padding" Value="13,9" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Right" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FBF0E5" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProductRadio" TargetType="RadioButton"><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,16,0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,17">
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="46" Click="AddProductClick" automation:AutomationProperties.Name="إضافة منتج"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="White" Stretch="Uniform" /><TextBlock Text="إضافة منتج" Foreground="White" FontSize="13" Margin="9,0,0,0" /></StackPanel></Button>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="المنتجات" FontSize="27" FontWeight="Bold" TextAlignment="Right" /><TextBlock Text="منتجات جاهزة للبيع كما هي، بدون تصنيع" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,20,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="190" /><ColumnDefinition Width="12" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="44" Background="White" BorderBrush="#DED6CE" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="17" Height="17" Fill="#8D6A4C" Stretch="Uniform" /><TextBox x:Name="ProductSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="8,3" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="12" FlowDirection="RightToLeft" TextAlignment="Left" VerticalContentAlignment="Center" automation:AutomationProperties.Name="البحث في المنتجات" /></Grid></Border>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource ProductCombo}" automation:AutomationProperties.Name="تصفية فئة المنتجات" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource ProductCombo}" automation:AutomationProperties.Name="تصفية حالة المنتجات" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,15,0,9" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="معاينة محلية — لا يتم حفظ البيانات" Foreground="#9A5C22" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Grid>
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="940"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                <TextBlock Text="الصورة" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="1" Text="اسم المنتج" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="2" Text="الفئة" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="3" Text="الخيار / المقاس" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="4" Text="تكلفة الشراء" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="5" Text="سعر البيع" Foreground="#7B410F" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="6" Text="الحالة" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="7" Text="الإجراءات" Style="{StaticResource ProductHeaderCell}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><ItemsControl ItemsSource="{Binding VisibleProducts}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border x:Name="RowSurface" MinHeight="76" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <Border Width="54" Height="54" CornerRadius="10" Background="#F2E7DC" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid>
                                        <Grid x:Name="MattressThumb" Visibility="Collapsed"><Border Width="42" Height="25" CornerRadius="5" Background="#DCE6E4" BorderBrush="#7A958F" BorderThickness="1" /><Path Data="M8,26 L39,26 M11,16 L11,30 M36,16 L36,30" Stroke="#825A39" StrokeThickness="2" Stretch="Uniform" Width="40" Height="28" /></Grid>
                                        <Grid x:Name="PillowThumb" Visibility="Collapsed"><Path Data="M7,17 C10,9 33,9 38,17 C42,24 37,35 29,34 C21,37 9,34 7,27 C5,23 5,20 7,17Z" Fill="#FAF8F3" Stroke="#B89572" StrokeThickness="1.4" Stretch="Uniform" Width="42" Height="36" /></Grid>
                                        <Grid x:Name="VaseThumb" Visibility="Collapsed"><Path Data="M15,4 L29,4 C28,10 27,12 31,17 C37,25 33,41 22,44 C11,41 7,25 13,17 C17,12 16,10 15,4Z" Fill="#C98550" Stroke="#8B4D24" StrokeThickness="1.4" Stretch="Uniform" Width="34" Height="42" /></Grid>
                                        <Grid x:Name="LampThumb" Visibility="Collapsed"><Path Data="M11,6 L32,6 L37,22 L6,22Z" Fill="#D5AA6D" Stroke="#79512A" StrokeThickness="1.4" /><Path Data="M21,22 L21,39 M13,40 L29,40" Stroke="#79512A" StrokeThickness="2" /></Grid>
                                        <Border CornerRadius="9"><Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background></Border>
                                    </Grid></Border>
                                    <StackPanel Grid.Column="1" Margin="14,8" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" /><TextBlock Text="منتج جاهز" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0" /></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource ProductBodyCell}" /><TextBlock Grid.Column="3" Text="{Binding VariantSummary}" Style="{StaticResource ProductBodyCell}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding PurchaseCostLabel}" Style="{StaticResource ProductBodyCell}" /><TextBlock Text="YER" Style="{StaticResource ProductBodyCell}" Margin="5,0,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding SellingPriceLabel}" Foreground="#7B410F" FontWeight="SemiBold" Style="{StaticResource ProductBodyCell}" /><TextBlock Text="YER" Foreground="#7B410F" FontWeight="SemiBold" Style="{StaticResource ProductBodyCell}" Margin="5,0,0,0" /></StackPanel>
                                    <Border Grid.Column="6" x:Name="StatusPill" Background="#EAF7E9" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" Foreground="#28733C" FontSize="10" FontWeight="SemiBold" /></Border>
                                    <Button Grid.Column="7" Style="{StaticResource ProductRowAction}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات المنتج"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FlowDirection="LeftToRight" Placement="Right" HorizontalOffset="6" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" Padding="5"><MenuItem Header="تعديل" Style="{StaticResource ProductMenuItem}" Click="EditProductClick" /><MenuItem Header="تكرار" Style="{StaticResource ProductMenuItem}" Click="DuplicateProductClick" /><Separator /><MenuItem Header="أرشفة" Style="{StaticResource ProductMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveProductClick" /></ContextMenu></Button.ContextMenu></Button>
                                </Grid></Border>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding ThumbnailKind}" Value="Mattress"><Setter TargetName="MattressThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Pillow"><Setter TargetName="PillowThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Vase"><Setter TargetName="VaseThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ThumbnailKind}" Value="Lamp"><Setter TargetName="LampThumb" Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.56" /><Setter TargetName="StatusPill" Property="Background" Value="#EEEAE6" /><Setter TargetName="StatusText" Property="Foreground" Value="#625A54" /></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoVisibleProducts, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="لا توجد منتجات مطابقة" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="جرّب تغيير البحث أو عوامل التصفية." Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel></Grid></ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="EditorSurface">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,17"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#F4E8DC" CornerRadius="16" Padding="13,6" VerticalAlignment="Center"><TextBlock Text="منتج جاهز" Foreground="#7B410F" FontSize="10" FontWeight="SemiBold" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="{Binding EditorTitle}" FontSize="27" FontWeight="Bold" /><TextBlock Text="المعلومات والسعر والخيارات في صفحة واحدة" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,22,28,26" MaxWidth="970" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource Card}" Padding="24"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft"><TextBlock Text="صورة المنتج" Style="{StaticResource ProductFieldLabel}" /><Border Height="236" Background="#F7F1EA" BorderBrush="#D8C6B4" BorderThickness="1" CornerRadius="12"><Grid>
                        <StackPanel x:Name="ImagePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Width="72" Height="72" CornerRadius="36" Background="#EAD8C8"><Path Data="{StaticResource IconProducts}" Width="31" Height="31" Fill="#8B572A" Stretch="Uniform" /></Border><TextBlock Text="صورة واضحة للعرض لاحقاً" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,10,0,0" /></StackPanel>
                        <Image x:Name="ProductImagePreview" Source="{Binding ProductImage}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProductImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                    </Grid></Border><TextBlock Text="{Binding ProductImageName}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" FlowDirection="LeftToRight" TextAlignment="Right" /><Button Content="اختيار صورة" Style="{StaticResource ProductSecondaryButton}" Margin="0,12,0,0" Click="ChooseImageClick" automation:AutomationProperties.Name="اختيار صورة المنتج" /></StackPanel>
                    <StackPanel Grid.Column="2" FlowDirection="RightToLeft"><TextBlock Text="المعلومات الأساسية" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="عرّف المنتج الجاهز كما سيظهر في نقاط البيع." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,20" /><TextBlock Text="اسم المنتج" Style="{StaticResource ProductFieldLabel}" /><TextBox x:Name="ProductNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextInput}" automation:AutomationProperties.Name="اسم المنتج" /><TextBlock Text="الفئة" Style="{StaticResource ProductFieldLabel}" Margin="0,17,0,7" /><ComboBox ItemsSource="{Binding ActiveCategories}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding EditorCategory, Mode=TwoWay}" Style="{StaticResource ProductCategoryCombo}" automation:AutomationProperties.Name="فئة المنتج" /><TextBlock Text="وصف قصير" Style="{StaticResource ProductFieldLabel}" Margin="0,17,0,7" /><TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextInput}" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="الوصف القصير للمنتج" /></StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0"><StackPanel><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center"><RadioButton Content="نعم" GroupName="ProductVariants" IsChecked="{Binding HasVariants, Mode=TwoWay}" Style="{StaticResource ProductRadio}" automation:AutomationProperties.Name="للمنتج خيارات مختلفة نعم" /><RadioButton Content="لا" GroupName="ProductVariants" IsChecked="{Binding HasNoVariants, Mode=TwoWay}" Style="{StaticResource ProductRadio}" automation:AutomationProperties.Name="للمنتج خيارات مختلفة لا" /></StackPanel><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="هل لهذا المنتج مقاسات أو أنواع مختلفة؟" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="الخيار هو نسخة جاهزة يبيعها المورد؛ لا توجد أبعاد مخصصة." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Grid>
                    <Grid x:Name="SinglePricing" Margin="0,24,0,0"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasVariants}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="تكلفة الشراء" Style="{StaticResource ProductFieldLabel}" /><Border Background="#F8F5F1" CornerRadius="9" Padding="1"><Grid><TextBox Text="{Binding PurchaseCost, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource ProductTextInput}" FlowDirection="LeftToRight" TextAlignment="Right" automation:AutomationProperties.Name="تكلفة شراء المنتج" /><TextBlock Text="YER" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" /></Grid></Border><TextBlock Text="سعر المورد" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,5,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="سعر البيع" Foreground="#7B410F" Style="{StaticResource ProductFieldLabel}" /><Border Background="#FFF8F0" CornerRadius="9" Padding="2"><Grid><TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource ProductTextInput}" BorderBrush="#B96B25" FontSize="17" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right" automation:AutomationProperties.Name="سعر بيع المنتج" /><TextBlock Text="YER" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0" Foreground="#7B410F" IsHitTestVisible="False" /></Grid></Border><TextBlock Text="القيمة التي تظهر للمبيعات" Foreground="#9A5C22" FontSize="9" Margin="0,5,0,0" /></StackPanel>
                        <Border Grid.Column="4" Background="#F4EEE7" CornerRadius="10" Padding="16" VerticalAlignment="Bottom" MinHeight="73"><StackPanel><TextBlock Text="الهامش" Foreground="{StaticResource MutedBrush}" FontSize="10" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,7,0,0"><TextBlock Text="{Binding MarginLabel}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="YER" FontSize="11" Margin="6,5,0,0" /></StackPanel></StackPanel></Border>
                    </Grid>
                    <StackPanel x:Name="VariantsPricing" Margin="0,24,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasVariants}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Background="#F6F2EE"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="اسم الخيار" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="1" Text="تكلفة الشراء" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="2" Text="سعر البيع" Foreground="#7B410F" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="3" Text="الهامش" Style="{StaticResource ProductHeaderCell}" /><TextBlock Grid.Column="4" Text="إزالة" Style="{StaticResource ProductHeaderCell}" /></Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Variants}"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="62" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextInput}" Height="38" MinHeight="38" Margin="8" automation:AutomationProperties.Name="اسم خيار المنتج" /><TextBox Grid.Column="1" Text="{Binding PurchaseCost, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource ProductTextInput}" Height="38" MinHeight="38" Margin="8" FlowDirection="LeftToRight" TextAlignment="Right" automation:AutomationProperties.Name="تكلفة شراء الخيار" /><TextBox Grid.Column="2" Text="{Binding SellingPrice, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource ProductTextInput}" BorderBrush="#C98442" Height="38" MinHeight="38" Margin="8" FlowDirection="LeftToRight" TextAlignment="Right" automation:AutomationProperties.Name="سعر بيع الخيار" /><StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding MarginLabel}" FontWeight="SemiBold" /><TextBlock Text="YER" FontSize="9" Margin="5,2,0,0" /></StackPanel><Button Grid.Column="4" Content="×" Style="{StaticResource ProductRowAction}" Foreground="#A13B27" Click="RemoveVariantClick" automation:AutomationProperties.Name="إزالة خيار المنتج" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </Grid></Border><Button Content="+ إضافة خيار" Style="{StaticResource ProductSecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="AddVariantClick" automation:AutomationProperties.Name="إضافة خيار للمنتج" />
                    </StackPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="ملاحظات" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="معلومة داخلية اختيارية عن المورد أو العرض." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,12" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextInput}" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" automation:AutomationProperties.Name="ملاحظات المنتج" /></StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="2" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,13"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="أرشفة المنتج" Style="{StaticResource ProductSecondaryButton}" Foreground="#942F1F" BorderBrush="#C99E94" Click="ArchiveFromEditorClick" IsEnabled="{Binding CanArchiveFromEditor}" Visibility="{Binding CanArchiveFromEditor, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="أرشفة المنتج من صفحة التعديل" /><TextBlock Grid.Column="1" Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0" Visibility="{Binding HasEditorError, Converter={StaticResource BooleanToVisibility}}" /><StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight"><Button Content="إلغاء" Style="{StaticResource ProductSecondaryButton}" MinWidth="104" Click="CancelEditorClick" automation:AutomationProperties.Name="إلغاء تعديل المنتج" /><Button Content="حفظ المنتج" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="132" Margin="10,0,0,0" Click="SaveProductClick" automation:AutomationProperties.Name="حفظ المنتج" /></StackPanel></Grid></Border>
        </Grid>

        <Border Panel.ZIndex="40" Background="#702B1A0D" Visibility="{Binding IsArchiveConfirmationOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="430" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel><Border Width="54" Height="54" CornerRadius="27" Background="#F9E9E5" HorizontalAlignment="Right"><Path Data="M7,7 L25,7 M10,7 L11,27 L21,27 L22,7 M13,4 L19,4 L20,7 L12,7 M14,11 L14,23 M18,11 L18,23" Stroke="#9C3D2B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="28" Stretch="Uniform" /></Border><TextBlock Text="{Binding ArchiveConfirmationTitle}" FontSize="20" FontWeight="Bold" Margin="0,15,0,0" /><TextBlock Text="سيبقى المنتج في المعاينة ويمكن عرضه من فلتر «مؤرشف». لا يتم حذف أي بيانات." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,20" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left"><Button Content="إلغاء" Style="{StaticResource ProductSecondaryButton}" MinWidth="96" Click="CancelArchiveClick" automation:AutomationProperties.Name="إلغاء أرشفة المنتج" /><Button Content="تأكيد الأرشفة" Style="{StaticResource ProductSecondaryButton}" Background="#943E2D" Foreground="White" BorderBrush="#943E2D" MinWidth="130" Margin="10,0,0,0" Click="ConfirmArchiveClick" automation:AutomationProperties.Name="تأكيد أرشفة المنتج" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="50" Background="#702B1A0D" Visibility="{Binding IsCategoryEditorOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="430" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><StackPanel><TextBlock Text="{Binding CategoryEditorTitle}" FontSize="20" FontWeight="Bold" /><TextBlock Text="استخدم فئة واحدة واضحة للمنتجات الجاهزة." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,18" /><TextBlock Text="اسم الفئة" Style="{StaticResource ProductFieldLabel}" /><TextBox x:Name="CategoryNameBox" Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextInput}" automation:AutomationProperties.Name="اسم فئة المنتج" /><TextBlock Text="{Binding CategoryError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,7,0,0" Visibility="{Binding HasCategoryError, Converter={StaticResource BooleanToVisibility}}" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,20,0,0"><Button Content="إلغاء" Style="{StaticResource ProductSecondaryButton}" MinWidth="96" Click="CancelCategoryClick" /><Button Content="حفظ الفئة" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="116" Margin="10,0,0,0" Click="SaveCategoryClick" /></StackPanel></StackPanel></Border></Border>

        <Border Panel.ZIndex="50" Background="#702B1A0D" Visibility="{Binding IsCategoryManagerOpen, Converter={StaticResource BooleanToVisibility}}"><Border Width="560" MaxHeight="560" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="إدارة الفئات" FontSize="20" FontWeight="Bold" /><TextBlock Text="نفس الفئات تظهر في القائمة ونموذج المنتج." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,16" /></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FBF8F5" BorderBrush="#E4D9CF" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight"><Button Content="تعديل" Style="{StaticResource ProductCompactButton}" Margin="0,0,8,0" Click="EditCategoryClick" /><Button Content="أرشفة" Style="{StaticResource ProductCompactButton}" Foreground="#942F1F" IsEnabled="{Binding CanArchive}" Click="ArchiveCategoryClick" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusLabel}" Foreground="#8B2E1B" FontSize="9" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,14,0,0"><Button Content="إغلاق" Style="{StaticResource ProductSecondaryButton}" MinWidth="96" Click="CloseCategoryManagerClick" /><Button Content="+ إضافة فئة" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="120" Margin="10,0,0,0" Click="AddCategoryFromDropdownClick" /></StackPanel></Grid></Border></Border>

        <Border Margin="28" Padding="18,11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="60" Background="#3B240F" CornerRadius="9" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding FeedbackMessage}" Foreground="White" FontSize="11" /></Border>

    </Grid>
</UserControl>
