<UserControl x:Class="Eitmad.WindowsShell.Features.Orders.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>

        <Style x:Key="OrderStatusBadge" TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}"><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Tone" Value="Warning"/></DataTrigger><DataTrigger Binding="{Binding IsInProduction}" Value="True"><Setter Property="Tone" Value="Information"/></DataTrigger><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Tone" Value="Success"/></DataTrigger><DataTrigger Binding="{Binding IsDelivered}" Value="True"><Setter Property="Tone" Value="Success"/></DataTrigger><DataTrigger Binding="{Binding IsCancelled}" Value="True"><Setter Property="Tone" Value="Danger"/></DataTrigger></Style.Triggers></Style>


    </UserControl.Resources>

    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Title="الطلبات" Subtitle="راجع طلبات العملاء وتقدمها من مكان واحد"></controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,16">
                        <TextBox x:Name="OrderSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث برقم الطلب أو العميل" Style="{StaticResource SearchInput}" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" Margin="10,0,0,8" automation:AutomationProperties.Name="تصفية الطلبات حسب الحالة" />
                        <ComboBox ItemsSource="{Binding DateOptions}" SelectedItem="{Binding SelectedDate}" Style="{StaticResource SelectInput}" Margin="10,0,0,8" automation:AutomationProperties.Name="تصفية الطلبات حسب التاريخ" />
                    </layout:AdaptiveFieldsPanel>

                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
                            <StackPanel MinWidth="920" FlowDirection="RightToLeft">
                                <Grid Height="47" Background="#F7F3EF">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.72*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="رقم الطلب" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="العميل" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="التاريخ" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="الإجمالي" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="الحالة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="5" Text="فتح" Style="{StaticResource TableHeader}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding VisibleOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE9E4" BorderThickness="0,0,0,1" Background="White" MinHeight="65">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.72*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource TableBody}" FontWeight="SemiBold" FlowDirection="LeftToRight" /><TextBlock Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="2" Text="{Binding DateLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="3" Text="{Binding FinalTotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                    <controls:StatusBadge Grid.Column="4" Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Style="{StaticResource OrderStatusBadge}"></controls:StatusBadge>
                                                    <Button Grid.Column="5" Content="فتح" Style="{StaticResource InlineActionButton}" Click="OpenOrderClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="فتح الطلب" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="18,11" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <controls:EmptyState Margin="0,16,0,0" Visibility="{Binding HasNoVisibleOrders, Converter={StaticResource BooleanToVisibility}}" Heading="لا توجد طلبات مطابقة" Description="غيّر البحث أو عوامل التصفية."></controls:EmptyState>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailSurface" Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,17">
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="BackToOrdersButton" Grid.Column="0" Content="العودة إلى الطلبات" Style="{StaticResource InlineActionButton}" Height="38" Click="BackToListClick" automation:AutomationProperties.Name="العودة إلى قائمة الطلبات" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تفاصيل الطلب" FontSize="25" FontWeight="Bold" /><TextBlock Text="مراجعة بيانات الطلب وبنود الأثاث" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,0,9"><TextBlock Text="رقم الطلب" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedOrder.Number}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
                                <StackPanel Width="180" Margin="0,0,0,9"><TextBlock Text="الحالة الحالية" Style="{StaticResource MetadataLabel}" /><controls:StatusBadge Margin="0,5,0,0" Padding="12,3" HorizontalAlignment="Right" Text="{Binding StatusLabel}" Style="{StaticResource OrderStatusBadge}"></controls:StatusBadge></StackPanel>
                                <StackPanel Width="250" Margin="0,0,0,9"><TextBlock Text="العميل" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedOrder.Customer}" Style="{StaticResource MetadataValue}" /></StackPanel>
                                <StackPanel Width="160" Margin="0,0,0,9"><TextBlock Text="التاريخ" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedOrder.DateLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
                            </WrapPanel>
                            <Border Grid.Row="1" Background="#F7F3EF" CornerRadius="7" Padding="12,8" Margin="0,8,0,0"><TextBlock Text="للمراجعة فقط · تُدار مهام الورشة في أوامر العمل" Foreground="#745A43" FontSize="10" /></Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,16,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Padding="20,15" BorderBrush="#EEE9E4" BorderThickness="0,0,0,1"><TextBlock Text="بنود الأثاث" FontSize="17" FontWeight="SemiBold" /></Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
                                <StackPanel MinWidth="1040" FlowDirection="RightToLeft">
                                    <Grid Height="43" Background="#F7F3EF"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.28*" /><ColumnDefinition Width="0.82*" /><ColumnDefinition Width="1.02*" /><ColumnDefinition Width="0.62*" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="المنتج" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="التنويعة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="الأبعاد" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="اللون" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="المقبض" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="5" Text="الكمية" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="6" Text="سعر البيع" Style="{StaticResource TableHeader}" /></Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedOrder.Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEE9E4" BorderThickness="0,0,0,1" MinHeight="62"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.28*" /><ColumnDefinition Width="0.82*" /><ColumnDefinition Width="1.02*" /><ColumnDefinition Width="0.62*" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Product}" Style="{StaticResource TableBody}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Variant}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="2" Text="{Binding Dimensions}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="3" Text="{Binding Color}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="4" Text="{Binding Handle}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="5" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="6" Text="{Binding SellingPriceLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Width="430" HorizontalAlignment="Left" Padding="22" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="ملخص الطلب" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" /><Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="المجموع الفرعي" Style="{StaticResource SummaryLabel}" /><TextBlock Grid.Column="1" Text="{Binding SelectedOrder.SubtotalLabel}" Style="{StaticResource SummaryValue}" /></Grid><Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الخصم" Style="{StaticResource SummaryLabel}" /><TextBlock Grid.Column="1" Text="{Binding SelectedOrder.DiscountLabel}" Style="{StaticResource SummaryValue}" Foreground="#9A382B" /></Grid><Separator Background="#DED8D2" Margin="0,1,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الإجمالي النهائي" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding SelectedOrder.FinalTotalLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#6E3A0D" /></Grid></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
