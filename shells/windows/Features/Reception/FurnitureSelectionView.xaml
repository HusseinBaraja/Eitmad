<UserControl x:Class="Eitmad.WindowsShell.Features.Reception.FurnitureSelectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Resources/SalesCatalogVisuals.xaml"/><ResourceDictionary Source="../../Resources/SalesSelectionStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28,18" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Button x:Name="BackButton" Content="{Binding BackLabel}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="BackClick" AutomationProperties.Name="{Binding BackLabel}"/>
  <TextBlock Text="معاينة ببيانات تجريبية — عرض السعر مؤقت ولا يتم حفظه" Margin="0,12"/>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" CornerRadius="12" Height="250" Margin="0,0,20,0">
    <Grid DataContext="{Binding Item}">
     <ContentControl Content="{Binding}" Style="{StaticResource CatalogIllustration}" Focusable="False" IsHitTestVisible="False"/>
     <Image Source="{Binding Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
    </Grid>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="{Binding Item.Name}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Item.Description}" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="اختر المقاس" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
  <TextBlock Text="العرض × الارتفاع × العمق · مقاسات ثابتة" Margin="0,0,0,12"/>
  <ListBox x:Name="SizesList" Style="{StaticResource Options}" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" AutomationProperties.Name="اختر المقاس">
   <ListBox.ItemTemplate><DataTemplate><StackPanel>
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
    <TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" FontSize="16" Margin="0,10,0,8"/>
    <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" FontSize="18" FontWeight="Bold"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Visibility="{Binding HasColors, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="اختر اللون" FontSize="22" FontWeight="Bold" Margin="0,16,0,12"/>
   <ListBox x:Name="ColorsList" Style="{StaticResource Options}" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" AutomationProperties.Name="اختر اللون">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <Border Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" CornerRadius="6" Height="42" Margin="0,0,0,10"/>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
     <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  <StackPanel Visibility="{Binding HasHandles, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="اختر المقبض" FontSize="22" FontWeight="Bold" Margin="0,16,0,12"/>
   <ListBox x:Name="HandlesList" Style="{StaticResource Options}" ItemsSource="{Binding Handles}" SelectedItem="{Binding SelectedHandle}" AutomationProperties.Name="اختر المقبض">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <Grid Height="48" Margin="0,0,0,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <Canvas Width="120" Height="48" FlowDirection="LeftToRight">
       <Rectangle Canvas.Left="22" Canvas.Top="20" Width="7" Height="15" Fill="{Binding SwatchBrush}"/>
       <Rectangle Canvas.Left="91" Canvas.Top="20" Width="7" Height="15" Fill="{Binding SwatchBrush}"/>
       <Rectangle Canvas.Left="18" Canvas.Top="16" Width="84" Height="9" RadiusX="4" Fill="{Binding SwatchBrush}"/>
      </Canvas>
     </Grid>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
     <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,20,0,0">
   <StackPanel>
    <DockPanel><TextBlock Text="الكمية" Margin="0,0,16,0" FontSize="20" VerticalAlignment="Center"/><controls:QuantityStepper x:Name="QuantityControl" Value="{Binding Quantity}" HorizontalAlignment="Left"/></DockPanel>
    <Grid Margin="0,18,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="سعر الأثاث"/><TextBlock Grid.Column="1" Text="{Binding BasePriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="1" Text="{Binding SelectedColor.Name}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedColor.PriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="2" Text="{Binding SelectedHandle.Name}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHandle.PriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="3" Text="إضافات الخيارات"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdditionsLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="4" Text="سعر الوحدة" FontSize="18" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnitPriceLabel}" FlowDirection="LeftToRight" FontSize="18" Margin="0,8"/>
     <TextBlock Grid.Row="5" Text="الإجمالي" FontSize="26" FontWeight="Bold"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LineTotalLabel}" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight"/>
    </Grid>
    <TextBlock Text="{Binding Guidance}" Margin="0,0,0,8"/>
    <Button x:Name="AddButton" Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="52" IsEnabled="{Binding CanAdd}" Click="AddClick" AutomationProperties.Name="{Binding ActionLabel}"/>
   </StackPanel>
  </Border>
 </StackPanel>
 </ScrollViewer>
 <controls:FeedbackNotice x:Name="AddedNotice" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="28,12" Tone="Success" IsFloating="True" DisplayDuration="00:00:04"/>
 </Grid>
</UserControl>
