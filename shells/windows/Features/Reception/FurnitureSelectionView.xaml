<UserControl x:Class="Eitmad.WindowsShell.Features.Reception.FurnitureSelectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Resources/SalesCatalogVisuals.xaml"/><ResourceDictionary Source="../../Resources/SalesSelectionStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <Grid Style="{StaticResource SelectionWorkspace}" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" CornerRadius="8" Width="112" Height="80" Margin="0,0,12,0">
    <Grid DataContext="{Binding Item}">
     <ContentControl Content="{Binding}" Style="{StaticResource CatalogIllustration}" Focusable="False" IsHitTestVisible="False"/>
     <Image Source="{Binding Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
    </Grid>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock x:Name="ItemName" reception:SalesText.Value="{Binding Item.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock reception:SalesText.Value="{Binding Item.Description}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <Button x:Name="BackButton" Content="{Binding BackLabel}" Style="{StaticResource SelectionSupportingAction}" Click="BackClick" AutomationProperties.Name="{Binding BackLabel}"/>
    <Button Content="تحديث الصنف" Click="RefreshClick" Style="{StaticResource SelectionSupportingAction}" Margin="0,4,0,0" AutomationProperties.Name="تحديث الصنف"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="SelectionOptions" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="0,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
     <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger>
    </Style.Triggers></Style></StackPanel.Style>
  <TextBlock Text="اختر المقاس" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
  <ListBox x:Name="SizesList" Style="{StaticResource Options}" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" AutomationProperties.Name="اختر المقاس">
   <ListBox.ItemTemplate><DataTemplate><StackPanel>
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
    <TextBlock Text="{Binding DimensionsLabel}" FlowDirection="LeftToRight" FontSize="16" Margin="0,4,0,4"/>
    <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" FontSize="18" FontWeight="Bold"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Visibility="{Binding CanCustomize, Converter={StaticResource BooleanToVisibility}}">
   <Grid Margin="0,12,0,8" MaxWidth="600" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <controls:FormField Label="العرض (سم)">
     <StackPanel>
     <TextBlock x:Name="WidthRange" Text="{Binding WidthRange}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,0,0,4"/>
     <TextBox Style="{StaticResource TextInput}" Text="{Binding WidthCm, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="العرض بالسنتيمتر" AutomationProperties.HelpText="{Binding WidthRange}"/>
     </StackPanel>
    </controls:FormField>
    <controls:FormField Grid.Column="2" Label="الارتفاع (سم)">
     <StackPanel>
     <TextBlock x:Name="HeightRange" Text="{Binding HeightRange}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,0,0,4"/>
     <TextBox Style="{StaticResource TextInput}" Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="الارتفاع بالسنتيمتر" AutomationProperties.HelpText="{Binding HeightRange}"/>
     </StackPanel>
    </controls:FormField>
    <controls:FormField Grid.Column="4" Label="العمق (سم)">
     <StackPanel>
     <TextBlock x:Name="DepthRange" Text="{Binding DepthRange}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,0,0,4"/>
     <TextBox Style="{StaticResource TextInput}" Text="{Binding DepthCm, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="العمق بالسنتيمتر" AutomationProperties.HelpText="{Binding DepthRange}"/>
     </StackPanel>
    </controls:FormField>
   </Grid>
  </StackPanel>
  <layout:AdaptiveFieldsPanel MinItemWidth="320" Spacing="12">
  <StackPanel Visibility="{Binding HasColors, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="اختر اللون" FontSize="18" FontWeight="Bold" Margin="0,8,0,6"/>
   <ListBox x:Name="ColorsList" Style="{StaticResource Options}" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" AutomationProperties.Name="اختر اللون">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <Border Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" CornerRadius="6" Height="28" Margin="0,0,0,4"/>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
     <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  <StackPanel Visibility="{Binding HasHandles, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="اختر المقبض" FontSize="18" FontWeight="Bold" Margin="0,8,0,6"/>
   <ListBox x:Name="HandlesList" Style="{StaticResource Options}" ItemsSource="{Binding Handles}" SelectedItem="{Binding SelectedHandle}" AutomationProperties.Name="اختر المقبض">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <Grid Height="48" Margin="0,0,0,4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <Canvas Width="120" Height="48" FlowDirection="LeftToRight">
       <Rectangle Canvas.Left="22" Canvas.Top="20" Width="7" Height="15" Fill="{Binding SwatchBrush}"/>
       <Rectangle Canvas.Left="91" Canvas.Top="20" Width="7" Height="15" Fill="{Binding SwatchBrush}"/>
       <Rectangle Canvas.Left="18" Canvas.Top="16" Width="84" Height="9" RadiusX="4" Fill="{Binding SwatchBrush}"/>
      </Canvas>
     </Grid>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
     <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" Margin="0,8,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  </layout:AdaptiveFieldsPanel>
   </StackPanel>
   <Border>
    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SelectionPriceSummary}">
     <Setter Property="Grid.Column" Value="2"/>
     <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
      <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Grid.Row" Value="1"/>
      <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="MaxWidth" Value="360"/><Setter Property="HorizontalAlignment" Value="Left"/>
     </DataTrigger></Style.Triggers>
    </Style></Border.Style>
    <StackPanel>
  <TextBlock Text="تفاصيل السعر" FontWeight="SemiBold"/>
    <Grid Margin="0,12,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="سعر الأثاث" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding BasePriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="1" reception:SalesText.Value="{Binding SelectedColor.Name}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedColor.PriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="2" reception:SalesText.Value="{Binding SelectedHandle.Name}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHandle.PriceLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="3" Text="إضافات الخيارات" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdditionsLabel}" FlowDirection="LeftToRight"/>
     <TextBlock Grid.Row="4" Text="سعر الوحدة" FontSize="18" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnitPriceLabel}" FlowDirection="LeftToRight" FontSize="18" Margin="0,8"/>
    </Grid>
    </StackPanel>
   </Border>
   </Grid>
  </ScrollViewer>
  <Border x:Name="SelectionReview" Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
   <StackPanel MaxWidth="820" HorizontalAlignment="Left">
    <WrapPanel x:Name="CurrentOptions" Margin="0,0,0,6">
     <TextBlock Text="الاختيار:" FontWeight="SemiBold" Margin="0,0,8,0"/>
     <TextBlock reception:SalesText.Value="{Binding SelectedSize.Name}" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding SelectedSize.DimensionsLabel}" FlowDirection="LeftToRight" Margin="0,0,12,0">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
       <DataTrigger Binding="{Binding CanCustomize}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <TextBlock reception:SalesText.Value="{Binding SelectedColor.Name}" Margin="0,0,12,0"/>
     <TextBlock reception:SalesText.Value="{Binding SelectedHandle.Name}"/>
    </WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding CanCustomize, Converter={StaticResource BooleanToVisibility}}">
     <TextBlock Text="المقاسات الحالية (سم):" Margin="0,0,8,0"/>
     <TextBlock FlowDirection="LeftToRight"><Run Text="{Binding WidthCm}"/><Run Text=" × "/><Run Text="{Binding HeightCm}"/><Run Text=" × "/><Run Text="{Binding DepthCm}"/></TextBlock>
    </StackPanel>
    <WrapPanel HorizontalAlignment="Left">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="الكمية" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <controls:QuantityStepper x:Name="QuantityControl" Value="{Binding Quantity}"/>
     </StackPanel>
     <StackPanel VerticalAlignment="Center" Margin="28,0">
      <TextBlock Text="الإجمالي"/>
      <TextBlock x:Name="LineTotal" Text="{Binding LineTotalLabel}" FlowDirection="LeftToRight" FontSize="22" FontWeight="Bold"/>
     </StackPanel>
     <Button x:Name="AddButton" Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="48" VerticalAlignment="Center" IsEnabled="{Binding CanAdd}" Click="AddClick" AutomationProperties.Name="{Binding ActionLabel}"/>
    </WrapPanel>
    <TextBlock x:Name="SelectionGuidance" Text="{Binding Guidance}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
      <DataTrigger Binding="{Binding Guidance}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Border>
 </Grid>
 <controls:FeedbackNotice x:Name="AddedNotice" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20,12" Tone="Success" IsFloating="True" DisplayDuration="00:00:04"/>
 </Grid>
</UserControl>
