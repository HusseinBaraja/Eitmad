<UserControl x:Class="Eitmad.WindowsShell.Features.Reception.CurrentQuotationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Resources/SalesCatalogVisuals.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MaxHeight="480"/></Grid.RowDefinitions>
  <StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button x:Name="ContinueButton" Grid.Column="1" VerticalAlignment="Top" Content="متابعة اختيار المنتجات" Style="{StaticResource SecondaryButton}" Click="ContinueClick" AutomationProperties.Name="متابعة اختيار المنتجات"/>
  <StackPanel>
  <TextBlock Text="{Binding QuotationHeading}" FontSize="28" FontWeight="Bold" Margin="0,18,0,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
    <DataTrigger Binding="{Binding ShowQuotationHeader, RelativeSource={RelativeSource AncestorType=reception:SalesCatalogView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <TextBlock reception:SalesText.Value="{Binding QuotationNumber}" FontSize="18" VerticalAlignment="Center">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
    <DataTrigger Binding="{Binding QuotationNumber}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
    <StackPanel Margin="0,4,0,0" Visibility="{Binding IsLiveQuotation, Converter={StaticResource BooleanToVisibility}}">
     <TextBlock Text="{Binding DraftState}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding DraftEditState}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
  </StackPanel>
  </Grid>
   <TextBlock Text="{Binding QuotationEditorGuidance}" TextWrapping="Wrap" Margin="0,8,0,12">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsLiveQuotation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
  <ScrollViewer x:Name="QuotationItemsScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
  <TextBlock Text="عرض السعر فارغ. تابع اختيار المنتجات لإضافة الأصناف." TextWrapping="Wrap" FontSize="20" Margin="0,20" Visibility="{Binding IsQuotationEmpty, Converter={StaticResource BooleanToVisibility}}"/>
  <controls:FormField Label="الأصناف" ErrorText="{Binding ItemsError}"><StackPanel Grid.IsSharedSizeScope="True">
   <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="0,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="Quantity"/><ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="UnitPrice"/><ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="Total"/><ColumnDefinition Width="Auto" SharedSizeGroup="Actions"/></Grid.ColumnDefinitions>
     <TextBlock Text="الصنف والخيارات" FontWeight="SemiBold"/>
     <TextBlock Grid.Column="1" Text="الكمية" TextAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="سعر الوحدة" Margin="12,0"/>
     <TextBlock Grid.Column="3" Text="الإجمالي" Margin="12,0"/>
     <TextBlock Grid.Column="4" Text="إجراءات الصنف" Margin="12,0"/>
    </Grid>
   </Border>
   <ItemsControl ItemsSource="{Binding QuotationLines}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border x:Name="QuotationLineRow" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="0,12">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="Quantity"/><ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="UnitPrice"/><ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="Total"/><ColumnDefinition Width="Auto" SharedSizeGroup="Actions"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Width="56" Height="56" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Viewbox>
         <ContentControl Width="200" Height="188" DataContext="{Binding Item}" Content="{Binding}" Style="{StaticResource CatalogIllustration}" Focusable="False" IsHitTestVisible="False"/>
        </Viewbox>
        <Image Source="{Binding Item.Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
       </Grid>
       <StackPanel Grid.Column="1">
        <TextBlock reception:SalesText.Value="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="LineDescription" reception:SalesText.Value="{Binding Item.Description}" TextWrapping="Wrap">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Item.Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock reception:SalesText.Value="{Binding Options}" TextWrapping="Wrap">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Options}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Dimensions}" FlowDirection="LeftToRight" TextAlignment="Right">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Grid>
      <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="18" FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Center"/>
      <controls:AmountDisplay Grid.Column="2" AmountText="{Binding UnitPrice, StringFormat=N0}" UnitText="ر.ي" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>
      <controls:AmountDisplay Grid.Column="3" AmountText="{Binding LineTotal, StringFormat=N0}" UnitText="ر.ي" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
       <Button Content="تعديل" Style="{StaticResource SecondaryButton}" Click="EditClick" AutomationProperties.Name="{Binding Name, StringFormat=تعديل {0}}"/>
       <Button Content="تكرار" Style="{StaticResource SecondaryButton}" Click="DuplicateClick" AutomationProperties.Name="{Binding Name, StringFormat=تكرار {0}}" Margin="6,0,0,0"/>
       <Button Content="إزالة" Style="{StaticResource SecondaryButton}" Click="RemoveClick" AutomationProperties.Name="{Binding Name, StringFormat=إزالة {0}}" Margin="6,0,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></StackPanel></controls:FormField>
   </StackPanel>
  </ScrollViewer>
  <ScrollViewer x:Name="QuotationDetailsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
  <Grid x:Name="QuotationDetailsLayout" SizeChanged="DetailsSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="CustomerSection" VerticalAlignment="Top" Padding="16" Style="{StaticResource Card}" Effect="{x:Null}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
  <StackPanel>
   <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="1" Content="+ عميل جديد" Style="{StaticResource SecondaryButton}" Click="NewCustomerClick" AutomationProperties.Name="عميل جديد"/>
    <TextBlock Text="بيانات العميل" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock x:Name="CustomerSelectionState" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold">
    <TextBlock.Style>
     <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Text" Value="عميل محدد من السجل"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}"><Setter Property="Text" Value="اختر عميلاً بالاسم أو الهاتف."/></DataTrigger>
       <DataTrigger Binding="{Binding IsNewCustomer}" Value="True"><Setter Property="Text" Value="بيانات عميل جديد. احفظه لاختياره."/></DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <controls:FormField Label="اسم العميل" IsRequired="True" ErrorText="{Binding CustomerNameError}"><TextBox x:Name="CustomerNameInput" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" AutomationProperties.Name="اسم العميل"/></controls:FormField>
    <controls:FormField Grid.Column="2" Label="رقم الهاتف" IsRequired="True" ErrorText="{Binding PhoneError}"><TextBox x:Name="PhoneInput" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Style="{StaticResource TextInput}" AutomationProperties.Name="رقم الهاتف"/></controls:FormField>
   </Grid>
   <ItemsControl ItemsSource="{Binding CustomerMatches}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button HorizontalAlignment="Left" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AttachCustomerClick" AutomationProperties.Name="{Binding Name, StringFormat=اختيار العميل {0}}" Margin="0,0,0,8">
     <WrapPanel FlowDirection="RightToLeft">
      <TextBlock Text="{Binding Name}"/>
      <TextBlock Text=" — " />
      <TextBlock Text="{Binding Phone}" FlowDirection="LeftToRight"/>
     </WrapPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="جارٍ البحث…" Visibility="{Binding IsCustomerBusy, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding CustomerOperationError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <controls:FormField Label="العنوان (اختياري)"><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreCustomerDetailsReadOnly}" Style="{StaticResource TextInput}" AutomationProperties.Name="العنوان"/></controls:FormField>
    <controls:FormField Grid.Column="2" Label="ملاحظات (اختياري)"><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreCustomerDetailsReadOnly}" Style="{StaticResource TextInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="ملاحظات"/></controls:FormField>
   </Grid>
   <TextBlock Text="عدّل العنوان والملاحظات من تفاصيل العميل. الملاحظات لا تُحفظ في المسودة." TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding IsLiveQuotation, Converter={StaticResource BooleanToVisibility}}"/>
   <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsNewCustomer, Converter={StaticResource BooleanToVisibility}}">
    <Button Content="حفظ" Click="SaveCustomerClick" AutomationProperties.Name="حفظ العميل">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomerSaveBusy}" Value="True">
         <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelCustomerClick" AutomationProperties.Name="إلغاء العميل الجديد" Margin="8,0,0,0"/>
   </WrapPanel>
  </StackPanel>
  </Border>
  <StackPanel x:Name="QuotationSummarySection" Grid.Column="2">
   <Border x:Name="FinancialSummary" Padding="12" Style="{StaticResource Card}" Effect="{x:Null}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
    <StackPanel>
     <Grid FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Column="2" Text="المجموع الفرعي" FlowDirection="RightToLeft" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <controls:AmountDisplay AmountText="{Binding SubtotalLabel}" UnitText="ر.ي" FontSize="20" HorizontalAlignment="Right"/>
      <Label Grid.Row="1" Grid.Column="2" Content="الخصم" Target="{Binding ElementName=DiscountInput}" FlowDirection="RightToLeft" Padding="0" FontSize="18" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,8,0,0">
      <TextBox x:Name="DiscountInput" Width="100" Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" AutomationProperties.Name="نسبة الخصم" TextAlignment="Center"/>
      <TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="18"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DiscountError}" FlowDirection="RightToLeft" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="14" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="قيمة الخصم" FlowDirection="RightToLeft" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <controls:AmountDisplay Grid.Row="3" AmountText="{Binding DiscountAmountLabel}" UnitText="ر.ي" FontSize="20" HorizontalAlignment="Right" Margin="0,8,0,0"/>
      <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
      <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding TotalHeading}" FlowDirection="RightToLeft" TextWrapping="Wrap" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      <controls:AmountDisplay Grid.Row="5" AmountText="{Binding FinalTotalLabel}" UnitText="ر.ي" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
     </Grid>
    <StackPanel Margin="0,16,0,0" Visibility="{Binding RequiresDiscountApproval, Converter={StaticResource BooleanToVisibility}}">
     <controls:StatusBadge Text="{Binding DiscountStatus}" Tone="Neutral" HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding DiscountGuidance}" TextWrapping="Wrap" Margin="0,8"/>
     <Button Content="طلب موافقة" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="RequestApprovalClick" AutomationProperties.Name="طلب موافقة" Visibility="{Binding CanRequestDiscountApproval, Converter={StaticResource BooleanToVisibility}}"/>
    </StackPanel>
    </StackPanel>
   </Border>
     <controls:FeedbackNotice x:Name="DraftSaveFailureNotice" Message="{Binding DraftSaveError}" Tone="Danger" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
    <WrapPanel Margin="0,12,0,0">
     <Button Content="إصدار عرض السعر" Style="{StaticResource PrimaryButton}" Click="SaveQuotationClick" IsEnabled="{Binding CanIssueQuotation}" AutomationProperties.Name="إصدار عرض السعر"/>
     <Button x:Name="SaveDraftButton" Content="{Binding DraftSaveAction}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SaveDraftClick" IsEnabled="{Binding CanSaveDraft}" AutomationProperties.Name="{Binding DraftSaveAction}"/>
    </WrapPanel>
    <WrapPanel Margin="0,8,0,0">
     <Button x:Name="PrintPreviewButton" Content="معاينة المستند المحفوظ" Style="{StaticResource SecondaryButton}" Click="PrintPreviewClick" IsEnabled="{Binding CanPreviewCustomer}" AutomationProperties.Name="معاينة المستند المحفوظ"/>
     <Button Content="إعادة فتح النسخة المحفوظة" Click="ReloadDraftClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" IsEnabled="{Binding CanReloadDraft}" Visibility="{Binding IsLiveQuotation, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="إعادة فتح النسخة المحفوظة"/>
    </WrapPanel>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasDraftSaveFailure}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{Binding QuotationNotice}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
  </StackPanel>
  </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
