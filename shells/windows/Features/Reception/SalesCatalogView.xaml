<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" x:Class="Eitmad.WindowsShell.Features.Reception.SalesCatalogView" FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" x:Key="CatalogText">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        </Style>
        <DataTemplate x:Key="MissingVisual">
            <TextBlock Text="الصورة غير متاحة" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CatalogText}"/>
        </DataTemplate>
        <DataTemplate x:Key="WardrobeVisual">
            <Viewbox Margin="34">
                <Canvas Width="44" Height="38">
                    <Rectangle Canvas.Left="7" Canvas.Top="3" Width="30" Height="31" RadiusX="2" Fill="#9A6237"/>
                    <Line X1="22" X2="22" Y1="5" Y2="32" Stroke="#F0D2AE" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="18" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B"/>
                    <Ellipse Canvas.Left="24" Canvas.Top="18" Width="2.4" Height="2.4" Fill="#4B260B"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="BedVisual">
            <Viewbox Margin="34">
                <Canvas Width="46" Height="36">
                    <Rectangle Canvas.Left="4" Canvas.Top="16" Width="38" Height="15" RadiusX="3" Fill="#B97843"/>
                    <Rectangle Canvas.Left="5" Canvas.Top="7" Width="8" Height="24" RadiusX="2" Fill="#7B421D"/>
                    <Rectangle Canvas.Left="14" Canvas.Top="12" Width="12" Height="8" RadiusX="3" Fill="#F6E7D6"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="TableVisual">
            <Viewbox Margin="34">
                <Canvas Width="46" Height="36">
                    <Ellipse Canvas.Left="5" Canvas.Top="6" Width="36" Height="14" Fill="#B87437"/>
                    <Rectangle Canvas.Left="11" Canvas.Top="17" Width="4" Height="15" Fill="#704019"/>
                    <Rectangle Canvas.Left="31" Canvas.Top="17" Width="4" Height="15" Fill="#704019"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="DeskVisual">
            <Viewbox Margin="34">
                <Canvas Width="46" Height="36">
                    <Rectangle Canvas.Left="4" Canvas.Top="8" Width="38" Height="8" RadiusX="2" Fill="#9E6537"/>
                    <Rectangle Canvas.Left="7" Canvas.Top="15" Width="4" Height="18" Fill="#663412"/>
                    <Rectangle Canvas.Left="35" Canvas.Top="15" Width="4" Height="18" Fill="#663412"/>
                    <Rectangle Canvas.Left="25" Canvas.Top="16" Width="11" Height="9" Fill="#C99564"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="ChairVisual">
            <Viewbox Margin="34">
                <Canvas Width="42" Height="38">
                    <Rectangle Canvas.Left="9" Canvas.Top="3" Width="24" Height="18" RadiusX="7" Fill="#B9773F"/>
                    <Rectangle Canvas.Left="7" Canvas.Top="19" Width="28" Height="9" RadiusX="3" Fill="#915224"/>
                    <Rectangle Canvas.Left="10" Canvas.Top="27" Width="4" Height="8" Fill="#61310F"/>
                    <Rectangle Canvas.Left="29" Canvas.Top="27" Width="4" Height="8" Fill="#61310F"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="MattressVisual">
            <Viewbox Margin="42">
                <Grid>
                    <Border Width="42" Height="25" CornerRadius="5" Background="#DCE6E4" BorderBrush="#7A958F" BorderThickness="1"/>
                    <Path Data="M8,26 L39,26 M11,16 L11,30 M36,16 L36,30" Stroke="#825A39" StrokeThickness="2" Stretch="Uniform" Width="40" Height="28"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="PillowVisual">
            <Viewbox Margin="42">
                <Grid>
                    <Path Data="M7,17 C10,9 33,9 38,17 C42,24 37,35 29,34 C21,37 9,34 7,27 C5,23 5,20 7,17Z" Fill="#FAF8F3" Stroke="#B89572" StrokeThickness="1.4" Stretch="Uniform" Width="42" Height="36"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="VaseVisual">
            <Viewbox Margin="42">
                <Grid>
                    <Path Data="M15,4 L29,4 C28,10 27,12 31,17 C37,25 33,41 22,44 C11,41 7,25 13,17 C17,12 16,10 15,4Z" Fill="#C98550" Stroke="#8B4D24" StrokeThickness="1.4" Stretch="Uniform" Width="34" Height="42"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="LampVisual">
            <Viewbox Margin="42">
                <Grid>
                    <Path Data="M11,6 L32,6 L37,22 L6,22Z" Fill="#D5AA6D" Stroke="#79512A" StrokeThickness="1.4"/>
                    <Path Data="M21,22 L21,39 M13,40 L29,40" Stroke="#79512A" StrokeThickness="2"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="المنتجات" FontSize="28" FontWeight="Bold" Style="{StaticResource CatalogText}"/>
            <TextBlock Text="معاينة ببيانات تجريبية — لا يتم حفظ الاختيار" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,4,0,16" Style="{StaticResource CatalogText}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBox x:Name="CatalogSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" MinHeight="54" FontSize="17" AutomationProperties.Name="ابحث عن منتج"/>
            <TextBlock Text="ابحث عن منتج..." Margin="16,0" VerticalAlignment="Center" FontSize="17" IsHitTestVisible="False" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CatalogText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent" Margin="0,14,0,16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="فئات المنتجات">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="15,9"/>
                    <Setter Property="Margin" Value="0,0,6,6"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CatalogText}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Width="290" Margin="0,0,16,18" Padding="0" Effect="{x:Null}">
                            <StackPanel>
                                <Grid Height="188" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <ContentControl Content="{Binding}" Focusable="False" IsHitTestVisible="False">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource MissingVisual}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Mattress">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource MattressVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Pillow">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource PillowVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Vase">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource VaseVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Lamp">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource LampVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Wardrobe">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource WardrobeVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Bed">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource BedVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Table">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TableVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Desk">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource DeskVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailKind}" Value="Chair">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource ChairVisual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <Image Source="{Binding Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
                                </Grid>
                                <StackPanel Margin="18,14,18,18">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" MinHeight="36" Style="{StaticResource CatalogText}"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="12" MinHeight="50" Margin="0,5,0,6" Style="{StaticResource CatalogText}"/>
                                    <TextBlock Text="{Binding VariantSummary}" FontSize="14" Margin="0,0,0,10" Style="{StaticResource CatalogText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding PricePrefix}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource CatalogText}"/>
                                        <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" FontSize="18" FontWeight="SemiBold" Style="{StaticResource CatalogText}"/>
                                    </StackPanel>
                                    <Button Content="اختيار" Style="{StaticResource PrimaryButton}" MinHeight="44" Click="SelectClick" AutomationProperties.Name="{Binding SelectionName}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="لا توجد منتجات مطابقة" FontSize="22" Margin="0,0,0,18" Style="{StaticResource CatalogText}"/>
            <Button Content="مسح الفلاتر" Style="{StaticResource SecondaryButton}" Click="ClearClick" AutomationProperties.Name="مسح الفلاتر"/>
        </StackPanel>
        <TextBlock Grid.Row="4" Text="{Binding SelectionNotice}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CatalogText}"/>
    </Grid>
</UserControl>
