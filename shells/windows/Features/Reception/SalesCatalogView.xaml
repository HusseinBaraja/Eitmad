<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" x:Class="Eitmad.WindowsShell.Features.Reception.SalesCatalogView" FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Resources/SalesCatalogVisuals.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:PageHeader Title="المنتجات" ContainsButton="True" ButtonText="{Binding QuotationLabel}" ButtonClick="OpenQuotationClick"
        Visibility="{Binding ShowQuotationHeader, RelativeSource={RelativeSource AncestorType=reception:SalesCatalogView}, Converter={StaticResource BooleanToVisibility}}"/>
    <Grid Grid.Row="1">
    <Grid x:Name="CatalogListing" Margin="28,20">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsReviewingQuotation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSelecting}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding CatalogStatus}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CatalogText}"><Style.Triggers>
                <DataTrigger Binding="{Binding CatalogStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBox Grid.Row="1" x:Name="CatalogSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInput}" controls:ControlOptions.Placeholder="ابحث عن منتج..." AutomationProperties.Name="ابحث عن منتج"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent" Margin="0,14,0,16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="فئات المنتجات">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterChip}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <ScrollViewer Grid.Row="3" x:Name="CatalogResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleItems}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CatalogRow" Style="{StaticResource Card}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Margin="0,0,0,10" Padding="10" Effect="{x:Null}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Height="96" VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <ContentControl Content="{Binding}" Focusable="False" IsHitTestVisible="False" Style="{StaticResource CatalogIllustration}"/>
                                    <Image Source="{Binding Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock reception:SalesText.Value="{Binding Name}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource CatalogText}"/>
                                    <TextBlock reception:SalesText.Value="{Binding VariantSummary}" FontSize="14" Style="{StaticResource CatalogText}"/>
                                    <TextBlock reception:SalesText.Value="{Binding Description}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CatalogText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PricePrefix}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource CatalogText}"/>
                                        <TextBlock Text="{Binding PriceLabel}" FlowDirection="LeftToRight" FontSize="16" FontWeight="SemiBold" Style="{StaticResource CatalogText}"/>
                                    </StackPanel>
                                    <Button Content="اختيار" Style="{StaticResource PrimaryButton}" MinHeight="44" Margin="0,4,0,0" Click="SelectClick" AutomationProperties.Name="{Binding SelectionName}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="لا توجد منتجات مطابقة" FontSize="22" Margin="0,0,0,18" Style="{StaticResource CatalogText}"/>
            <Button Content="مسح الفلاتر" Style="{StaticResource SecondaryButton}" Click="ClearClick" AutomationProperties.Name="مسح الفلاتر"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding SelectionNotice}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CatalogText}"><Style.Triggers>
                    <DataTrigger Binding="{Binding SelectionNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <WrapPanel>
                <Button Content="تحديث الكتالوج" Click="ReloadClick" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="تحديث الكتالوج"/>
                <Button Content="الصفحة التالية" Click="NextClick" Style="{StaticResource SecondaryButton}" Margin="8,0" Visibility="{Binding HasNextPage, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="الصفحة التالية"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
        <reception:FurnitureSelectionView x:Name="SelectionView" DataContext="{Binding Selection}" Visibility="{Binding DataContext.IsSelectingFurniture, Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType=reception:SalesCatalogView}}" />
        <reception:ProductSelectionView x:Name="ProductSelectionView" DataContext="{Binding ProductSelection}" Visibility="{Binding DataContext.IsSelectingProduct, Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType=reception:SalesCatalogView}}" />
        <reception:CurrentQuotationView x:Name="QuotationView" Visibility="{Binding IsReviewingQuotation, Converter={StaticResource BooleanToVisibility}}"/>
    </Grid>
    </Grid>
</UserControl>
