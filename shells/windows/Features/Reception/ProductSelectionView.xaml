<UserControl x:Class="Eitmad.WindowsShell.Features.Reception.ProductSelectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Resources/SalesCatalogVisuals.xaml"/><ResourceDictionary Source="../../Resources/SalesSelectionStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <Grid Margin="20,12" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" CornerRadius="8" Width="112" Height="80" Margin="0,0,12,0">
    <Grid DataContext="{Binding Item}">
     <ContentControl Content="{Binding}" Style="{StaticResource CatalogIllustration}" Focusable="False" IsHitTestVisible="False"/>
     <Image Source="{Binding Image}" Stretch="Uniform" FlowDirection="LeftToRight"/>
    </Grid>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock x:Name="ItemName" reception:SalesText.Value="{Binding Item.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock reception:SalesText.Value="{Binding Item.Description}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <Button x:Name="BackButton" Content="{Binding BackLabel}" Style="{StaticResource SelectionSupportingAction}" Click="BackClick" AutomationProperties.Name="{Binding BackLabel}"/>
    <Button Content="تحديث الصنف" Click="RefreshClick" Style="{StaticResource SelectionSupportingAction}" Margin="0,4,0,0" AutomationProperties.Name="تحديث الصنف"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="SelectionOptions" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
  <StackPanel Visibility="{Binding HasVariants, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="اختر النوع / المقاس" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
   <ListBox x:Name="VariantsList" Style="{StaticResource Options}" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" AutomationProperties.Name="اختر النوع / المقاس">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionTitle}"/>
     <TextBlock Text="{Binding PriceLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FlowDirection="LeftToRight" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  <StackPanel Visibility="{Binding HasNoVariants, Converter={StaticResource BooleanToVisibility}}">
   <TextBlock Text="سعر البيع" FontSize="18"/>
   <TextBlock Text="{Binding Item.PriceLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
  </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="SelectionReview" Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
   <StackPanel>
    <WrapPanel x:Name="CurrentOptions" Margin="0,0,0,6" Visibility="{Binding HasVariants, Converter={StaticResource BooleanToVisibility}}">
     <TextBlock Text="الاختيار:" FontWeight="SemiBold" Margin="0,0,8,0"/>
     <TextBlock reception:SalesText.Value="{Binding SelectedVariant.Name}"/>
    </WrapPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="الكمية" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <controls:QuantityStepper x:Name="QuantityControl" Value="{Binding Quantity}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0">
      <TextBlock Text="الإجمالي"/>
      <controls:AmountDisplay x:Name="LineTotal" AmountText="{Binding LineTotalLabel}" UnitText="ر.ي" UnitPlacement="After" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"/>
     </StackPanel>
     <Button x:Name="AddButton" Grid.Column="2" Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="48" VerticalAlignment="Center" IsEnabled="{Binding CanAdd}" Click="AddClick" AutomationProperties.Name="{Binding ActionLabel}"/>
    </Grid>
    <TextBlock x:Name="SelectionGuidance" Text="{Binding Guidance}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
    <TextBlock x:Name="LocalNotice" Text="{Binding PersistenceNotice}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
 <controls:FeedbackNotice x:Name="AddedNotice" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20,12" Tone="Success" IsFloating="True" DisplayDuration="00:00:04"/>
 </Grid>
</UserControl>
