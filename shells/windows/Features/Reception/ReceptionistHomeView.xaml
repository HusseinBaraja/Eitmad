<UserControl x:Class="Eitmad.WindowsShell.Features.Reception.ReceptionistHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:quotations="clr-namespace:Eitmad.WindowsShell.Features.Quotations"
             xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception"
             xmlns:home="clr-namespace:Eitmad.WindowsShell.Features.Home" xmlns:customers="clr-namespace:Eitmad.WindowsShell.Features.Customers"
             FlowDirection="RightToLeft"
             Language="ar-YE"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="ReceptionRoute" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ReceptionistRoot" FlowDirection="LeftToRight" layout:ResponsiveLayout.IsEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <controls:ShellTitleBar x:Name="ReceptionistTitleBar" Grid.Row="0" Grid.Column="0"
                                Tag="الرئيسية"
                                PrimaryActionLabel="عرض السعر" PrimaryActionIcon="{StaticResource IconQuote}"
                                SearchPlaceholder="ابحث عن عروض الأسعار، العملاء، المنتجات، أو الطلبات..."
                                SwitchAccountHint="تسجيل الخروج وتبديل الحساب · Alt+K"
                                AccountSwitchRequested="SharedAccountSwitchRequested"
                                ActionRequested="TitleBarActionRequested"
                                SearchSubmitted="TitleBarSearchSubmitted">
            <controls:ShellTitleBar.Style>
                <Style TargetType="controls:ShellTitleBar">
                    <Setter Property="Title" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ReceptionQuotations}" Value="Visible">
                            <Setter Property="Title" Value="{Binding ViewModel.ListTitle, ElementName=ReceptionQuotations}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=ReceptionQuotations}" Value="Visible" />
                                <Condition Binding="{Binding ViewModel.IsDetailVisible, ElementName=ReceptionQuotations}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Title" Value="تفاصيل عرض السعر" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=ReceptionOrders}" Value="Visible" />
                                <Condition Binding="{Binding Content.ViewModel.IsDetailVisible, ElementName=ReceptionOrders}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Title" Value="تفاصيل الطلب" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ShellTitleBar.Style>
        </controls:ShellTitleBar>

        <ScrollViewer x:Name="HomeContent" Grid.Row="1" Grid.Column="0" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="24,12,24,24" MaxWidth="1180">
                <Button x:Name="NewQuotationAction"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="48"
                        Padding="18,10"
                        FontSize="17"
                        Content="عرض سعر جديد"
                        controls:ControlOptions.Icon="{StaticResource IconPlus}"
                        HorizontalAlignment="Left"
                        Tag="عرض سعر جديد"
                        Click="ActionClick"
                        automation:AutomationProperties.Name="بدء عرض سعر جديد" />

                <UniformGrid x:Name="ReceptionistActionsGrid" Columns="3" Margin="-4,8,-4,0">
                    <Button x:Name="QuotationsAction" Style="{StaticResource ReceptionRoute}" Content="عروض الأسعار" Tag="عروض الأسعار" Click="ActionClick" automation:AutomationProperties.Name="فتح عروض الأسعار" />
                    <Button x:Name="OrdersAction" Style="{StaticResource ReceptionRoute}" Content="الطلبات" Tag="الطلبات" Click="ActionClick" automation:AutomationProperties.Name="فتح الطلبات" />
                    <Button x:Name="ProductsAction" Style="{StaticResource ReceptionRoute}" Content="المنتجات" Tag="المنتجات" Click="ActionClick" automation:AutomationProperties.Name="فتح المنتجات" />
                </UniformGrid>

                <home:HomeView x:Name="ReceptionHome" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <controls:FeedbackNotice x:Name="ReceptionistNotice"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Margin="30"
                                 Padding="18,11"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Panel.ZIndex="40"
                                 Tone="Information"
                                 IsFloating="True"
                                 DisplayDuration="00:00:02.5"
                                 Dismissed="DismissNotice" />
        <quotations:QuotationsView x:Name="ReceptionQuotations" Grid.Row="1" Visibility="Collapsed"/>
        <ContentControl x:Name="ReceptionOrders" Grid.Row="1" Visibility="Collapsed"/>
        <reception:SalesCatalogView x:Name="CatalogContent" Grid.Row="1" Visibility="Collapsed" />
        <customers:CustomerDetailView x:Name="CustomerDetail" Grid.Row="1" Visibility="Collapsed" BackRequested="CustomerBackRequested"/>
        <controls:ShellSidebar x:Name="ReceptionistSidebar" Grid.RowSpan="2" Grid.Column="1" IsReceptionist="True" NavigationRequested="SidebarNavigationRequested" />
    </Grid>
</UserControl>
