<UserControl x:Class="Eitmad.WindowsShell.Features.WorkOrders.WorkOrdersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="WorkOrderStatusBadge" TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter Property="Tone" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                    <Setter Property="Tone" Value="Information" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Tone" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                    <Setter Property="Tone" Value="Danger" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FurniturePicture" TargetType="Border">
            <Setter Property="Width" Value="142" />
            <Setter Property="Height" Value="118" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F4E7D8" />
                        <GradientStop Color="#E5CDB3" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Title="أوامر العمل" Subtitle="الأثاث المطلوب تصنيعه ومسؤولية إنجازه" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,8">
                        <controls:FormField Label="البحث">
                            <TextBox x:Name="WorkOrderSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث في أوامر العمل" Style="{StaticResource SearchInput}" />
                        </controls:FormField>
                        <controls:FormField Label="الحالة">
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية أوامر العمل حسب الحالة" />
                        </controls:FormField>
                        <controls:FormField Label="موعد التسليم">
                            <ComboBox ItemsSource="{Binding DueDateOptions}" SelectedItem="{Binding SelectedDueDate}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية أوامر العمل حسب موعد التسليم" />
                        </controls:FormField>
                    </layout:AdaptiveFieldsPanel>
                    <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="معاينة محلية — لا يتم حفظ تغييرات الحالة" Foreground="#8A531F" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                    </Grid>
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid FlowDirection="LeftToRight">
                            <StackPanel FlowDirection="RightToLeft">
                                <controls:OperationsTable ItemsSource="{Binding VisibleWorkOrders}" SelectedValuePath="Id" MaxHeight="460" automation:AutomationProperties.Name="رقم أمر العمل">
                                    <controls:OperationsTable.EmptyContent>
                                        <controls:EmptyState Heading="لا توجد أوامر عمل مطابقة" Description="غيّر البحث أو عوامل التصفية." />
                                    </controls:OperationsTable.EmptyContent>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="رقم أمر العمل" Width="1.05*" MinWidth="120" SortMemberPath="Number">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Number}" Style="{StaticResource TableBody}" FontWeight="Bold" Foreground="#6F3B10" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="العميل / الطلب" Width="1.85*" MinWidth="160" SortMemberPath="Customer">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell2" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <StackPanel VerticalAlignment="Center" Margin="10,0">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Customer}" Style="{StaticResource TableBody}" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="ContrastCell1" Text="{Binding OrderNumber, StringFormat=الطلب {0}}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Center" FlowDirection="LeftToRight" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell2" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الأثاث" Width="1.55*" MinWidth="160" SortMemberPath="FurnitureSummary">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <Border x:Name="ContrastCell2" BorderBrush="#9A5C22" BorderThickness="2,0,0,0" Padding="9,0" Margin="4,12">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding FurnitureSummary}" Style="{StaticResource TableBody}" FontWeight="Bold" FontSize="12" />
                                                        </Border>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الكمية" Width="0.55*" MinWidth="70" SortMemberPath="TotalQuantity">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="مسند إلى" Width="1.05*" MinWidth="120" SortMemberPath="AssignedTo">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding AssignedTo}" Style="{StaticResource TableBody}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="موعد التسليم" Width="1.2*" MinWidth="120" SortMemberPath="DueDate">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding DueDateLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="1.05*" MinWidth="100" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <controls:StatusBadge Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Style="{StaticResource WorkOrderStatusBadge}"></controls:StatusBadge>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="فتح" Width="0.65*" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#ECE5DE" BorderThickness="0" Background="White" MinHeight="76">
                                                        <Button Content="فتح" Style="{StaticResource InlineActionButton}" Click="OpenWorkOrderClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="فتح أمر العمل" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="DetailSurface" Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,16" Height="{StaticResource PageHeaderHeight}">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToWorkOrdersButton" Grid.Column="0" Content="العودة إلى أوامر العمل" Style="{StaticResource InlineActionButton}" Height="38" Click="BackToListClick" automation:AutomationProperties.Name="العودة إلى قائمة أوامر العمل" />
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <TextBlock Text="أمر عمل" FontSize="{StaticResource PageHeaderTitleSize}" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedWorkOrder.DetailNumberLabel}" FlowDirection="LeftToRight" FontSize="{StaticResource PageHeaderTitleSize}" FontWeight="Bold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="ما الذي يجب تصنيعه؟" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource PageHeaderDescriptionSize}" Margin="0,4,0,0" />
                    </StackPanel>
                    <controls:StatusBadge DataContext="{Binding SelectedWorkOrder}" Grid.Column="2" Padding="14,4" VerticalAlignment="Center" Text="{Binding StatusLabel}" Style="{StaticResource WorkOrderStatusBadge}"></controls:StatusBadge>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <WrapPanel>
                            <StackPanel Width="210" Margin="0,0,0,8">
                                <TextBlock Text="الطلب المرتبط" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedWorkOrder.OrderNumber}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Width="250" Margin="0,0,0,8">
                                <TextBlock Text="العميل" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedWorkOrder.Customer}" Style="{StaticResource MetadataValue}" />
                            </StackPanel>
                            <StackPanel Width="210" Margin="0,0,0,8">
                                <TextBlock Text="النجّار المسند إليه" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedWorkOrder.AssignedTo}" Style="{StaticResource MetadataValue}" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,0,8">
                                <TextBlock Text="موعد التسليم" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedWorkOrder.DueDateLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <Grid FlowDirection="LeftToRight" Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F2E4D6" CornerRadius="9" Padding="10,5">
                                    <TextBlock Text="{Binding SelectedWorkOrder.FurnitureCountLabel}" Foreground="#76400F" FontSize="9" FontWeight="SemiBold" FlowDirection="RightToLeft" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="الأثاث المطلوب" FontSize="19" FontWeight="Bold" TextAlignment="Right" FlowDirection="RightToLeft" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedWorkOrder.Furniture}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FCFAF7" BorderBrush="#E8DDD2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                            <Grid FlowDirection="LeftToRight">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource FurniturePicture}" automation:AutomationProperties.Name="{Binding Name, StringFormat=صورة {0}}">
                                                    <Grid>
                                                        <Canvas Width="112" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsWardrobe, Converter={StaticResource BooleanToVisibility}}">
                                                            <Rectangle Canvas.Left="16" Canvas.Top="8" Width="80" Height="78" RadiusX="5" Fill="#8C552C" />
                                                            <Rectangle Canvas.Left="22" Canvas.Top="14" Width="33" Height="66" RadiusX="2" Fill="#B17643" />
                                                            <Rectangle Canvas.Left="58" Canvas.Top="14" Width="32" Height="66" RadiusX="2" Fill="#9B6337" />
                                                            <Line X1="56" Y1="14" X2="56" Y2="80" Stroke="#6C3E1E" StrokeThickness="2" />
                                                            <Ellipse Canvas.Left="48" Canvas.Top="48" Width="5" Height="5" Fill="#D7AE61" />
                                                            <Ellipse Canvas.Left="60" Canvas.Top="48" Width="5" Height="5" Fill="#D7AE61" />
                                                            <Rectangle Canvas.Left="23" Canvas.Top="86" Width="10" Height="5" Fill="#593016" />
                                                            <Rectangle Canvas.Left="80" Canvas.Top="86" Width="10" Height="5" Fill="#593016" />
                                                        </Canvas>
                                                        <Canvas Width="112" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTable, Converter={StaticResource BooleanToVisibility}}">
                                                            <Polygon Points="12,35 72,17 101,31 40,51" Fill="#A76C3D" />
                                                            <Polygon Points="12,35 40,51 40,60 12,44" Fill="#75431F" />
                                                            <Polygon Points="40,51 101,31 101,40 40,60" Fill="#8C552C" />
                                                            <Rectangle Canvas.Left="22" Canvas.Top="47" Width="7" Height="38" Fill="#68401F" />
                                                            <Rectangle Canvas.Left="87" Canvas.Top="39" Width="7" Height="39" Fill="#68401F" />
                                                            <Rectangle Canvas.Left="41" Canvas.Top="56" Width="7" Height="35" Fill="#68401F" />
                                                        </Canvas>
                                                        <Canvas Width="112" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBed, Converter={StaticResource BooleanToVisibility}}">
                                                            <Rectangle Canvas.Left="12" Canvas.Top="49" Width="90" Height="28" RadiusX="5" Fill="#A26A3D" />
                                                            <Rectangle Canvas.Left="12" Canvas.Top="14" Width="15" Height="72" RadiusX="4" Fill="#704321" />
                                                            <Rectangle Canvas.Left="20" Canvas.Top="35" Width="78" Height="23" RadiusX="5" Fill="#E8D9C5" />
                                                            <Rectangle Canvas.Left="28" Canvas.Top="38" Width="27" Height="13" RadiusX="4" Fill="#FAF5ED" />
                                                            <Rectangle Canvas.Left="59" Canvas.Top="38" Width="27" Height="13" RadiusX="4" Fill="#FAF5ED" />
                                                            <Rectangle Canvas.Left="18" Canvas.Top="77" Width="8" Height="10" Fill="#583116" />
                                                            <Rectangle Canvas.Left="89" Canvas.Top="77" Width="8" Height="10" Fill="#583116" />
                                                        </Canvas>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Column="1" Margin="22,0,0,0" FlowDirection="RightToLeft">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Variant}" Foreground="#8A531F" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Row="1" Margin="0,18,0,0">
                                                        <StackPanel Width="220" Margin="0,0,0,8">
                                                            <TextBlock Text="المقاسات الثابتة" Style="{StaticResource MetadataLabel}" />
                                                            <TextBlock Text="{Binding Dimensions}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                                                        </StackPanel>
                                                        <StackPanel Width="155" Margin="0,0,0,8">
                                                            <TextBlock Text="اللون" Style="{StaticResource MetadataLabel}" />
                                                            <TextBlock Text="{Binding Color}" Style="{StaticResource MetadataValue}" />
                                                        </StackPanel>
                                                        <StackPanel Width="175" Margin="0,0,0,8">
                                                            <TextBlock Text="المقبض" Style="{StaticResource MetadataLabel}" />
                                                            <TextBlock Text="{Binding Handle}" Style="{StaticResource MetadataValue}" />
                                                        </StackPanel>
                                                        <StackPanel Width="100" Margin="0,0,0,8">
                                                            <TextBlock Text="الكمية" Style="{StaticResource MetadataLabel}" />
                                                            <TextBlock Text="{Binding QuantityLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Padding="20,14" BorderBrush="#EEE9E4" BorderThickness="0,0,0,1">
                                <TextBlock Text="الأجزاء المطلوبة" FontSize="17" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Row="1">
                                <controls:OperationsTable ItemsSource="{Binding SelectedWorkOrder.Parts}" MaxHeight="460" automation:AutomationProperties.Name="القطعة">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="القطعة" Width="*" MinWidth="120" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="48">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Name}" Style="{StaticResource TableBody}" TextAlignment="Right" Margin="20,0" FontWeight="SemiBold" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الكمية" Width="180" MinWidth="80" SortMemberPath="Quantity">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="48">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,16,0,0" Background="#FFF8E7" BorderBrush="#E7C878" BorderThickness="1" CornerRadius="11" Padding="20">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#C78A21" CornerRadius="3" />
                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="16,0,0,0">
                                <TextBlock Text="ملاحظات الطلب" FontSize="16" FontWeight="Bold" Foreground="#654713" />
                                <TextBlock Text="{Binding SelectedWorkOrder.Notes}" FontSize="12" LineHeight="22" Margin="0,8,0,0" Foreground="#584A32" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AdvanceStatusButton" Grid.Column="0" Content="{Binding SelectedWorkOrder.NextStatusActionLabel}" Style="{StaticResource PrimaryButton}" Height="43" MinWidth="145" IsEnabled="{Binding SelectedWorkOrder.CanAdvance}" Click="AdvanceStatusClick" automation:AutomationProperties.Name="تغيير حالة أمر العمل" />
                            <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="20,0,0,0">
                                <TextBlock Text="حالة العمل" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="جديد  ←  قيد التنفيذ  ←  مكتمل" FlowDirection="RightToLeft" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:03" Dismissed="FeedbackDismissed" Margin="0,10,0,0" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
