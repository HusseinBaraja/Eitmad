<UserControl x:Class="Eitmad.WindowsShell.Features.Parts.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="PartsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="PartsTextInput" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DED6CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /><Setter TargetName="InputChrome" Property="BorderThickness" Value="1.5" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" /><Setter TargetName="InputChrome" Property="Background" Value="#FFFEFC" /></Trigger>
                            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource DangerBrush}" /><Setter TargetName="InputChrome" Property="BorderThickness" Value="1.5" /><Setter Property="ToolTip" Value="أدخل رقماً صالحاً غير سالب." /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PartsComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F3E5D7" /><Setter Property="Foreground" Value="#6C390D" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FBF2E9" /><Setter Property="Foreground" Value="#7A4314" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PartsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DED6CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PartsComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F6EEE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="Chevron" Data="M3,7 L8,12 L13,7" Stroke="#8B4D17" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                                    </Border>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="4,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" Focusable="False">
                                <Border Width="{Binding ActualWidth, ElementName=InputChrome}" MaxHeight="260" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" /></Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" /><Setter TargetName="InputChrome" Property="Background" Value="#FFFEFC" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /><Setter TargetName="InputChrome" Property="BorderThickness" Value="1.5" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" /><Setter TargetName="InputChrome" Property="Background" Value="#FFFCF8" /><Setter TargetName="Chevron" Property="Data" Value="M3,12 L8,7 L13,12" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PartsRowActionButton" TargetType="Button">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="#F5E9DC" /><Setter TargetName="ActionSurface" Property="BorderBrush" Value="#D5B18E" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.68" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PartsContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="154"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" /></Border.Effect><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PartsMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="13,9" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#FBF0E5" /><Setter Property="Foreground" Value="#783F0D" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.36" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PartsMenuSeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#ECE4DC" Margin="9,4" /></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PartsHeaderCell" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style x:Key="PartsBodyCell" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style x:Key="PartsSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="43" /><Setter Property="Padding" Value="18,8" /><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Setter Property="BorderBrush" Value="#B79A80" /><Setter Property="BorderThickness" Value="1.2" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="UseLayoutRounding" Value="True" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F7F0E8" /><Setter TargetName="Surface" Property="BorderBrush" Value="#98653D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListSurface">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,15" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="46" Style="{StaticResource PrimaryButton}" Click="AddPartClick" automation:AutomationProperties.Name="إضافة جزء">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="White" Stretch="Uniform" /><TextBlock Text="إضافة جزء" Foreground="White" FontSize="13" Margin="9,0,0,0" /></StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="24,0,0,0">
                        <TextBlock Text="الأجزاء" FontSize="27" FontWeight="Bold" HorizontalAlignment="Left" TextAlignment="Right" />
                        <TextBlock Text="إدارة أجزاء الأثاث وتكاليفها واستخدامها" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,28">
                    <UniformGrid x:Name="FiltersGrid" Margin="-6,0,-6,14">
                        <StackPanel Margin="6,0">
                            <TextBlock Text="البحث" Style="{StaticResource PartsFieldLabel}" />
                            <Border Height="44" Background="White" BorderBrush="#DED6CE" BorderThickness="1" CornerRadius="8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource IconSearch}" Style="{StaticResource ToolbarVectorIcon}" /><TextBox Grid.Column="1" x:Name="PartsSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="9,10,2,8" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="13" ToolTip="ابحث باسم الجزء أو الفئة" automation:AutomationProperties.Name="البحث عن جزء" TextAlignment="Left" FlowDirection="RightToLeft" /></Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="6,0"><TextBlock Text="الفئة" Style="{StaticResource PartsFieldLabel}" /><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PartsComboBox}" automation:AutomationProperties.Name="تصفية الفئة" /></StackPanel>
                        <StackPanel Margin="6,0"><TextBlock Text="الحالة" Style="{StaticResource PartsFieldLabel}" /><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PartsComboBox}" automation:AutomationProperties.Name="تصفية الحالة" /></StackPanel>
                        <UniformGrid.Style><Style TargetType="UniformGrid"><Setter Property="Columns" Value="3" /><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Columns" Value="1" /></DataTrigger></Style.Triggers></Style></UniformGrid.Style>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" ClipToBounds="True" MinHeight="310">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                            <ScrollViewer Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <Grid MinWidth="790">
                                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#F7F3EF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="اسم الجزء" Style="{StaticResource PartsHeaderCell}" />
                                            <TextBlock Grid.Column="1" Text="الفئة" Style="{StaticResource PartsHeaderCell}" />
                                            <TextBlock Grid.Column="2" Text="التكلفة" Style="{StaticResource PartsHeaderCell}" />
                                            <TextBlock Grid.Column="3" Text="مستخدم في" Style="{StaticResource PartsHeaderCell}" />
                                            <TextBlock Grid.Column="4" Text="الحالة" Style="{StaticResource PartsHeaderCell}" />
                                            <TextBlock Grid.Column="5" Text="الإجراءات" Style="{StaticResource PartsHeaderCell}" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleParts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="White" Cursor="Hand" MouseLeftButtonUp="PartRowClick">
                                                    <Grid FlowDirection="RightToLeft">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,8" FlowDirection="LeftToRight"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="NoWrap" /><TextBlock Text="جزء أثاث" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right" Margin="0,3,0,0" /></StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource PartsBodyCell}" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock Text="{Binding CostAmountLabel}" Style="{StaticResource PartsBodyCell}" FlowDirection="LeftToRight" /><TextBlock Text="{Binding CurrencyLabel}" Style="{StaticResource PartsBodyCell}" Margin="6,0,0,0" /></StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding UsedInLabel}" Style="{StaticResource PartsBodyCell}" FlowDirection="LeftToRight" />
                                                        <Border Grid.Column="4" x:Name="StatusPill" Background="#EAF7E9" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" Foreground="#28733C" FontSize="10" FontWeight="SemiBold" /></Border>
                                                        <Button Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PartsRowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات الجزء">
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FlowDirection="LeftToRight" Style="{StaticResource PartsContextMenu}" Placement="MousePoint">
                                                                    <MenuItem Header="تعديل" Style="{StaticResource PartsMenuItem}" Click="EditMenuItemClick" />
                                                                    <MenuItem Header="تكرار" Style="{StaticResource PartsMenuItem}" Click="DuplicateMenuItemClick" />
                                                                    <Separator Style="{StaticResource PartsMenuSeparator}" />
                                                                    <MenuItem Header="أرشفة" Style="{StaticResource PartsMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveMenuItemClick" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /><Setter TargetName="StatusPill" Property="Background" Value="#E5E2DF" /><Setter TargetName="StatusText" Property="Foreground" Value="#716B66" /></DataTrigger>
                                                    <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="White" Panel.ZIndex="4">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNoVisibleParts}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconSearch}" Style="{StaticResource MetricVectorIcon}" Width="23" Height="23" /></Border><TextBlock Text="لا توجد أجزاء مطابقة" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,13,0,0" /><TextBlock Text="جرّب تغيير البحث أو عوامل التصفية." Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Grid.Row="2" Background="#FCFAF8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9"><TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorSurface">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,15" FlowDirection="LeftToRight">
                    <StackPanel HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="حدّد المعلومات أولاً، ثم المواد الخام، ثم راجع الجزء." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,30" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0ECE8" /><Setter Property="BorderBrush" Value="#D8D0C8" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Background" Value="{StaticResource CopperBrush}" /><Setter Property="BorderBrush" Value="{StaticResource CopperBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="المعلومات" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="تعريف الجزء" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Height="1" Background="#DED6CE" VerticalAlignment="Center" Margin="8,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0ECE8" /><Setter Property="BorderBrush" Value="#D8D0C8" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Background" Value="{StaticResource CopperBrush}" /><Setter Property="BorderBrush" Value="{StaticResource CopperBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="2" FontFamily="Segoe UI" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="المواد الخام" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="الاستهلاك والتكلفة" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" Height="1" Background="#DED6CE" VerticalAlignment="Center" Margin="8,0" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0ECE8" /><Setter Property="BorderBrush" Value="#D8D0C8" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{StaticResource CopperBrush}" /><Setter Property="BorderBrush" Value="{StaticResource CopperBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="3" FontFamily="Segoe UI" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="المراجعة" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="تأكيد البيانات" Foreground="{StaticResource MutedBrush}" FontSize="9" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="InformationStep" Padding="30">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="معلومات الجزء" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="عرّف الجزء الآن. ستختار المواد الخام المستخدمة في الخطوة التالية." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,24" />
                            <TextBlock Text="اسم الجزء" Style="{StaticResource PartsFieldLabel}" />
                            <TextBox x:Name="EditorNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PartsTextInput}" Margin="0,0,0,18" automation:AutomationProperties.Name="اسم الجزء" />
                            <TextBlock Text="الفئة" Style="{StaticResource PartsFieldLabel}" />
                            <ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory, Mode=TwoWay}" Style="{StaticResource PartsComboBox}" automation:AutomationProperties.Name="فئة الجزء" Margin="0,0,0,18" />
                            <TextBlock Text="الوصف أو الملاحظات" Style="{StaticResource PartsFieldLabel}" />
                            <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PartsTextInput}" Height="108" MinHeight="108" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" automation:AutomationProperties.Name="وصف الجزء أو ملاحظاته" />
                            <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,10,0,0" Visibility="{Binding HasEditorError, Converter={StaticResource BooleanToVisibility}}" />
                            <Grid Margin="0,26,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="44" Click="NextFromInformationClick" automation:AutomationProperties.Name="التالي إلى المواد الخام"><TextBlock Text="التالي" Foreground="White" /></Button><Button Grid.Column="1" Content="إلغاء" Style="{StaticResource PartsSecondaryButton}" Margin="10,0,0,0" Click="CancelEditorClick" /></Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MaterialsStep" Padding="30">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Height="42" Style="{StaticResource PartsSecondaryButton}" Click="OpenMaterialPickerClick" automation:AutomationProperties.Name="إضافة مادة خام"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="15" Height="15" Fill="{StaticResource CopperBrush}" Stretch="Uniform" /><TextBlock Text="إضافة مادة خام" Margin="8,0,0,0" /></StackPanel></Button><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="20,0,0,0"><TextBlock Text="المواد الخام المستخدمة" FontSize="22" FontWeight="Bold" /><TextBlock Text="أضف المواد، ثم أدخل الكمية المستخدمة من كل مادة." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid>

                            <Border Margin="0,22,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid MinWidth="780">
                                        <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border Background="#F7F3EF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                            <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="المادة الخام" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="1" Text="الكمية المستخدمة" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="2" Text="الوحدة" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="3" Text="تكلفة الوحدة" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="4" Text="التكلفة الإجمالية" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="5" Text="إزالة" Style="{StaticResource PartsHeaderCell}" /></Grid>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <ItemsControl x:Name="MaterialRows" ItemsSource="{Binding SelectedMaterials}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Material.Name}" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" TextAlignment="Right" /><TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Style="{StaticResource PartsTextInput}" Height="36" Margin="9,8" Padding="8,2" FontFamily="Segoe UI" Language="en-US" FlowDirection="LeftToRight" TextAlignment="Center" automation:AutomationProperties.Name="كمية المادة الخام" /><TextBlock Grid.Column="2" Text="{Binding Material.Unit}" Style="{StaticResource PartsBodyCell}" FlowDirection="LeftToRight" /><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock Text="{Binding UnitCostLabel}" Style="{StaticResource PartsBodyCell}" /><TextBlock Text="YER" Style="{StaticResource PartsBodyCell}" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock Text="{Binding TotalCostLabel}" Style="{StaticResource PartsBodyCell}" FontWeight="SemiBold" /><TextBlock Text="YER" Style="{StaticResource PartsBodyCell}" FontWeight="SemiBold" Margin="5,0,0,0" /></StackPanel><Button Grid.Column="5" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PartsRowActionButton}" Content="×" Foreground="{StaticResource DangerBrush}" Click="RemoveMaterialClick" automation:AutomationProperties.Name="إزالة المادة الخام" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel HorizontalAlignment="Center" Margin="0,30"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedMaterials}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="{StaticResource CopperBrush}" Stretch="Uniform" /></Border><TextBlock Text="لم تضف مواد خام بعد" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0" /><TextBlock Text="اختر مادة خام، ثم أدخل الكمية المستخدمة." Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Border Background="#FCF5EC" BorderBrush="#D8B38D" BorderThickness="1" CornerRadius="10" Padding="22,16" HorizontalAlignment="Left" MinWidth="280" Margin="0,18,0,0">
                                <StackPanel><TextBlock Text="تكلفة الجزء" Foreground="#714216" FontSize="11" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,4,0,0"><TextBlock Text="{Binding TotalPartCostLabel}" FontFamily="Segoe UI" FontSize="27" FontWeight="Bold" Foreground="#6D390A" /><TextBlock Text="YER" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#6D390A" VerticalAlignment="Bottom" Margin="8,0,0,4" /></StackPanel></StackPanel>
                            </Border>
                            <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,10,0,0" Visibility="{Binding HasEditorError, Converter={StaticResource BooleanToVisibility}}" />
                            <Grid Margin="0,24,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="44" Click="NextFromMaterialsClick" automation:AutomationProperties.Name="التالي إلى المراجعة"><TextBlock Text="التالي" Foreground="White" /></Button><Button Grid.Column="1" Content="السابق" Style="{StaticResource PartsSecondaryButton}" Margin="10,0,0,0" Click="PreviousStepClick" automation:AutomationProperties.Name="السابق إلى المعلومات" /></Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ReviewStep" Padding="24">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="مراجعة الجزء" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="تحقّق من المعلومات والتكلفة قبل الحفظ. استخدم «السابق» لإجراء أي تعديل." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,16" />
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#FAF7F4" CornerRadius="8" Padding="14,10"><StackPanel><TextBlock Text="اسم الجزء" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding EditorName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="#FAF7F4" CornerRadius="8" Padding="14,10"><StackPanel><TextBlock Text="الفئة" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding EditorCategory}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border></Grid>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Background="#F7F3EF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="المادة الخام" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="1" Text="الكمية" Style="{StaticResource PartsHeaderCell}" /><TextBlock Grid.Column="2" Text="التكلفة" Style="{StaticResource PartsHeaderCell}" /></Grid></Border><ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedMaterials}"><ItemsControl.ItemTemplate><DataTemplate><Border MinHeight="48" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Material.Name}" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" TextAlignment="Right" /><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock Text="{Binding Quantity}" Style="{StaticResource PartsBodyCell}" Language="en-US" /><TextBlock Text="{Binding Material.Unit}" Style="{StaticResource PartsBodyCell}" Margin="5,0,0,0" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock Text="{Binding TotalCostLabel}" Style="{StaticResource PartsBodyCell}" /><TextBlock Text="YER" Style="{StaticResource PartsBodyCell}" Margin="5,0,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                            </Border>
                            <Border Background="#F5E8D9" BorderBrush="#C99563" BorderThickness="1.2" CornerRadius="11" Padding="20,13" HorizontalAlignment="Left" MinWidth="315" Margin="0,16,0,0"><StackPanel><TextBlock Text="إجمالي تكلفة الجزء" Foreground="#6D390A" FontSize="12" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,3,0,0"><TextBlock Text="{Binding TotalPartCostLabel}" FontFamily="Segoe UI" FontSize="29" FontWeight="Bold" Foreground="#5C2D05" /><TextBlock Text="YER" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#5C2D05" VerticalAlignment="Bottom" Margin="8,0,0,5" /></StackPanel></StackPanel></Border>
                            <Grid Margin="0,18,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="46" Click="SaveEditorClick" automation:AutomationProperties.Name="حفظ الجزء"><TextBlock Text="{Binding SaveButtonLabel}" Foreground="White" /></Button><Button Grid.Column="1" Content="السابق" Style="{StaticResource PartsSecondaryButton}" Margin="10,0,0,0" Click="PreviousStepClick" automation:AutomationProperties.Name="السابق إلى المواد الخام" /></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.RowSpan="2" Panel.ZIndex="30" Visibility="{Binding IsMaterialPickerOpen, Converter={StaticResource BooleanToVisibility}}">
                <Border Background="#720F0904" />
                <Border Width="620" MaxHeight="590" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#D6C7B8" BorderThickness="1" CornerRadius="13" Padding="26">
                    <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="12" Opacity="0.28" Color="#321A08" /></Border.Effect>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Width="34" Height="34" Style="{StaticResource PartsRowActionButton}" Content="×" Click="CloseMaterialPickerClick" automation:AutomationProperties.Name="إغلاق اختيار المادة الخام" /><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="18,0,0,0"><TextBlock Text="اختيار مادة خام" FontSize="20" FontWeight="Bold" /><TextBlock Text="ابحث، ثم اختر مادة لإضافتها إلى الجزء." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Grid><Border Grid.Row="1" Height="44" Background="#FCFAF8" BorderBrush="#DED6CE" BorderThickness="1" CornerRadius="8" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource IconSearch}" Style="{StaticResource ToolbarVectorIcon}" /><TextBox x:Name="MaterialSearchBox" Grid.Column="1" Text="{Binding MaterialSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="9,10,2,8" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="12" automation:AutomationProperties.Name="البحث في المواد الخام" /></Grid></Border><Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390"><ItemsControl ItemsSource="{Binding FilteredMaterials}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,11"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="اختيار" Style="{StaticResource PartsSecondaryButton}" Height="36" Padding="14,5" Click="SelectMaterialClick" automation:AutomationProperties.Name="اختيار المادة الخام" /><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="16,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Right" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,4,0,0"><TextBlock Text="{Binding UnitCostLabel}" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="10" /><TextBlock Text="YER /" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="10" Margin="4,0,0,0" /><TextBlock Text="{Binding Unit}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,0,0,0" /></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="لا توجد مواد خام مطابقة" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNoMaterialOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="FeedbackToast" Margin="28" Padding="18,11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="20" Background="#3B240F" CornerRadius="9">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFeedback}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding FeedbackMessage}" Foreground="White" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
