<UserControl x:Class="Eitmad.WindowsShell.Features.Parts.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid x:Name="ListSurface">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <controls:PageHeader  Title="الأجزاء" Subtitle="إدارة أجزاء الأثاث وتكاليفها واستخدامها"><StackPanel Orientation="Horizontal"><Button Height="46" Style="{StaticResource PrimaryButton}" Click="AddPartClick" automation:AutomationProperties.Name="إضافة جزء">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="White" Stretch="Uniform" /><TextBlock Text="إضافة جزء" Foreground="White" FontSize="13" Margin="9,0,0,0" /></StackPanel>
                    </Button></StackPanel></controls:PageHeader>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,28">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" x:Name="FiltersGrid" Margin="0,0,0,14">
                        <StackPanel>
                            <controls:FormField Label="البحث"><TextBox x:Name="PartsSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ابحث باسم الجزء أو الفئة" automation:AutomationProperties.Name="البحث عن جزء" Style="{StaticResource SearchInput}" /></controls:FormField>
                        </StackPanel>
                        <StackPanel><controls:FormField Label="الفئة"><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الفئة" /></controls:FormField></StackPanel>
                        <StackPanel><controls:FormField Label="الحالة"><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الحالة" /></controls:FormField></StackPanel>

                    </layout:AdaptiveFieldsPanel>

                    <Border Style="{StaticResource Card}" ClipToBounds="True" MinHeight="310">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                            <Grid Grid.RowSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                                    <controls:OperationsTable Grid.Row="1" ItemsSource="{Binding VisibleParts}" SelectedValuePath="Id" FlowDirection="RightToLeft" MaxHeight="460" automation:AutomationProperties.Name="اسم الجزء"><controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا توجد أجزاء مطابقة" Description="جرّب تغيير البحث أو عوامل التصفية."/></controls:OperationsTable.EmptyContent><DataGrid.Columns><DataGridTemplateColumn Header="اسم الجزء" Width="2*" MinWidth="160" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><StackPanel VerticalAlignment="Center" Margin="18,8" FlowDirection="LeftToRight"><TextBlock x:Name="ContrastCell0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="NoWrap" /><TextBlock x:Name="ContrastCell1" Text="جزء أثاث" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right" Margin="0,3,0,0" /></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الفئة" Width="1.2*" MinWidth="120" SortMemberPath="Category"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><TextBlock x:Name="ContrastCell0" Text="{Binding Category}" Style="{StaticResource TableBody}" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="التكلفة" Width="1.1*" MinWidth="120" SortMemberPath="Cost"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><controls:AmountDisplay HorizontalAlignment="Center" AmountText="{Binding CostAmountLabel}" UnitText="{Binding CurrencyLabel}" UnitPlacement="After"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="مستخدم في" Width="1*" MinWidth="120" SortMemberPath="UsedInCount"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><TextBlock x:Name="ContrastCell0" Text="{Binding UsedInLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الحالة" Width="0.9*" MinWidth="100" SortMemberPath="StatusLabel"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><controls:StatusBadge x:Name="StatusPill" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Tone="Success"></controls:StatusBadge></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /><Setter TargetName="StatusPill" Property="Background" Value="#E5E2DF" /><Setter TargetName="StatusPill" Property="Foreground" Value="#716B66" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الإجراءات" Width="0.55*" MinWidth="70" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White"><Button HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات الجزء">
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FlowDirection="LeftToRight" Style="{StaticResource ActionMenu}" Placement="MousePoint">
                                                                    <MenuItem Header="تعديل" Style="{StaticResource ActionMenuItem}" Click="EditMenuItemClick" />
                                                                    <MenuItem Header="تكرار" Style="{StaticResource ActionMenuItem}" Click="DuplicateMenuItemClick" />
                                                                    <Separator Style="{StaticResource ActionMenuSeparator}" />
                                                                    <MenuItem Header="أرشفة" Style="{StaticResource ActionMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveMenuItemClick" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter TargetName="RowSurface" Property="Opacity" Value="0.52" /><Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" /></DataTrigger><Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" /></Trigger><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></controls:OperationsTable>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="2" Background="#FCFAF8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9"><TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorSurface">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <controls:PageHeader  Title="{Binding EditorTitle}" Subtitle="حدّد المعلومات أولاً، ثم المواد الخام، ثم راجع الجزء."></controls:PageHeader>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,30" MaxWidth="980" HorizontalAlignment="Stretch">
                    <controls:StepIndicator CurrentStep="{Binding CurrentStep}" Margin="0,0,0,14"><controls:StepItem Label="المعلومات" Description="تعريف الجزء"/><controls:StepItem Label="المواد الخام" Description="الاستهلاك والتكلفة"/><controls:StepItem Label="المراجعة" Description="تأكيد البيانات"/></controls:StepIndicator>

                    <Border x:Name="InformationStep" Padding="30">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepOne}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="معلومات الجزء" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="عرّف الجزء الآن. ستختار المواد الخام المستخدمة في الخطوة التالية." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,24" />
                            <controls:FormField Label="اسم الجزء"><TextBox x:Name="EditorNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Margin="0,0,0,18" automation:AutomationProperties.Name="اسم الجزء" /></controls:FormField>
                            <controls:FormField Label="الفئة"><ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory, Mode=TwoWay}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="فئة الجزء" Margin="0,0,0,18" /></controls:FormField>
                            <controls:FormField Label="الوصف أو الملاحظات" ErrorText="{Binding EditorError}"><TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Height="108" MinHeight="108" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" automation:AutomationProperties.Name="وصف الجزء أو ملاحظاته" /></controls:FormField>
                            <Grid Margin="0,26,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="44" Click="NextFromInformationClick" automation:AutomationProperties.Name="التالي إلى المواد الخام"><TextBlock Text="التالي" Foreground="White" /></Button><Button Grid.Column="1" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelEditorClick" /></Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MaterialsStep" Padding="30">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepTwo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Height="42" Style="{StaticResource SecondaryButton}" Click="OpenMaterialPickerClick" automation:AutomationProperties.Name="إضافة مادة خام" Content="إضافة مادة خام" controls:ControlOptions.Icon="{StaticResource IconPlus}" /><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="20,0,0,0"><TextBlock Text="المواد الخام المستخدمة" FontSize="22" FontWeight="Bold" /><TextBlock Text="أضف المواد، ثم أدخل الكمية المستخدمة من كل مادة." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid>

                            <Border Margin="0,22,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <Grid>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                        <Grid Grid.Row="1">
                                            <controls:OperationsTable x:Name="MaterialRows" ItemsSource="{Binding SelectedMaterials}" FlowDirection="RightToLeft" MaxHeight="460" automation:AutomationProperties.Name="المادة الخام"><controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لم تضف مواد خام بعد" Description="اختر مادة خام، ثم أدخل الكمية المستخدمة." IsCompact="True"/></controls:OperationsTable.EmptyContent><DataGrid.Columns><DataGridTemplateColumn Header="المادة الخام" Width="2.1*" MinWidth="160" SortMemberPath="Material.Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell1" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><TextBlock x:Name="ContrastCell0" Text="{Binding Material.Name}" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" TextAlignment="Right" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الكمية المستخدمة" Width="1.15*" MinWidth="120" SortMemberPath="Quantity"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell0" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Style="{StaticResource TextInput}" Height="36" Margin="9,8" Padding="8,2" FontFamily="Segoe UI" Language="en-US" FlowDirection="LeftToRight" TextAlignment="Center" automation:AutomationProperties.Name="كمية المادة الخام" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الوحدة" Width="0.7*" MinWidth="120" SortMemberPath="Material.Unit"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell1" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><TextBlock x:Name="ContrastCell0" Text="{Binding Material.Unit}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="تكلفة الوحدة" Width="1.05*" MinWidth="120" SortMemberPath="Material.UnitCost"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell0" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><controls:AmountDisplay HorizontalAlignment="Center" VerticalAlignment="Center"  AmountText="{Binding UnitCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="التكلفة الإجمالية" Width="1.05*" MinWidth="120" SortMemberPath="TotalCost"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell0" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><controls:AmountDisplay HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" AmountText="{Binding TotalCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="إزالة" Width="0.55*" MinWidth="80" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell0" MinHeight="60" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><Button Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RowActionButton}" Content="×" Foreground="{StaticResource DangerBrush}" Click="RemoveMaterialClick" automation:AutomationProperties.Name="إزالة المادة الخام" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></controls:OperationsTable>

                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="#FCF5EC" BorderBrush="#D8B38D" BorderThickness="1" CornerRadius="10" Padding="22,16" HorizontalAlignment="Left" MinWidth="280" Margin="0,18,0,0">
                                <StackPanel><TextBlock Text="تكلفة الجزء" Foreground="#714216" FontSize="11" FontWeight="SemiBold" /><controls:AmountDisplay Margin="0,4,0,0" FontSize="27" FontWeight="Bold" Foreground="#6D390A" AmountText="{Binding TotalPartCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay></StackPanel>
                            </Border>
                            <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,10,0,0" Visibility="{Binding HasEditorError, Converter={StaticResource BooleanToVisibility}}" />
                            <Grid Margin="0,24,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="44" Click="NextFromMaterialsClick" automation:AutomationProperties.Name="التالي إلى المراجعة"><TextBlock Text="التالي" Foreground="White" /></Button><Button Grid.Column="1" Content="السابق" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PreviousStepClick" automation:AutomationProperties.Name="السابق إلى المعلومات" /></Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ReviewStep" Padding="24">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsStepThree}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="مراجعة الجزء" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="تحقّق من المعلومات والتكلفة قبل الحفظ. استخدم «السابق» لإجراء أي تعديل." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,16" />
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#FAF7F4" CornerRadius="8" Padding="14,10"><StackPanel><TextBlock Text="اسم الجزء" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding EditorName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="#FAF7F4" CornerRadius="8" Padding="14,10"><StackPanel><TextBlock Text="الفئة" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding EditorCategory}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border></Grid>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><controls:OperationsTable Grid.Row="1" ItemsSource="{Binding SelectedMaterials}" FlowDirection="RightToLeft" MaxHeight="460" automation:AutomationProperties.Name="المادة الخام"><DataGrid.Columns><DataGridTemplateColumn Header="المادة الخام" Width="2*" MinWidth="160" SortMemberPath="Material.Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell1" MinHeight="48" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><TextBlock x:Name="ContrastCell0" Text="{Binding Material.Name}" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" TextAlignment="Right" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="الكمية" Width="1*" MinWidth="80" SortMemberPath="Quantity"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell2" MinHeight="48" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock x:Name="ContrastCell0" Text="{Binding Quantity}" Style="{StaticResource TableBody}" Language="en-US" /><TextBlock x:Name="ContrastCell1" Text="{Binding Material.Unit}" Style="{StaticResource TableBody}" Margin="5,0,0,0" /></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"><Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="التكلفة" Width="1.25*" MinWidth="120" SortMemberPath="TotalCost"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="ContrastCell0" MinHeight="48" BorderBrush="{StaticResource LineBrush}" BorderThickness="0"><controls:AmountDisplay HorizontalAlignment="Center" VerticalAlignment="Center"  AmountText="{Binding TotalCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True"></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></controls:OperationsTable></Grid>
                            </Border>
                            <Border Background="#F5E8D9" BorderBrush="#C99563" BorderThickness="1.2" CornerRadius="11" Padding="20,13" HorizontalAlignment="Left" MinWidth="315" Margin="0,16,0,0"><StackPanel><TextBlock Text="إجمالي تكلفة الجزء" Foreground="#6D390A" FontSize="12" FontWeight="SemiBold" /><controls:AmountDisplay Margin="0,3,0,0" FontSize="29" FontWeight="Bold" Foreground="#5C2D05" AmountText="{Binding TotalPartCostLabel}" UnitText="YER" UnitPlacement="After"></controls:AmountDisplay></StackPanel></Border>
                            <Grid Margin="0,18,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="46" Click="SaveEditorClick" automation:AutomationProperties.Name="حفظ الجزء"><TextBlock Text="{Binding SaveButtonLabel}" Foreground="White" /></Button><Button Grid.Column="1" Content="السابق" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PreviousStepClick" automation:AutomationProperties.Name="السابق إلى المواد الخام" /></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <controls:DialogHost Grid.RowSpan="2" Panel.ZIndex="30" IsOpen="{Binding IsMaterialPickerOpen}" Title="اختيار مادة خام" PreferredWidth="620" FlowDirection="RightToLeft" CloseRequested="CloseMaterialPickerClick" InitialFocusTarget="{Binding ElementName=MaterialSearchBox}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="18,0,0,0"><TextBlock Text="ابحث، ثم اختر مادة لإضافتها إلى الجزء." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Grid><TextBox x:Name="MaterialSearchBox" Text="{Binding MaterialSearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث في المواد الخام" Grid.Row="1" Margin="0,20,0,14" Style="{StaticResource SearchInput}" /><Grid Grid.Row="2"><Border><ItemsControl ItemsSource="{Binding FilteredMaterials}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,11"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="اختيار" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,5" Click="SelectMaterialClick" automation:AutomationProperties.Name="اختيار المادة الخام" /><StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="16,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Right" /><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,4,0,0"><TextBlock Text="{Binding UnitCostLabel}" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="10" /><TextBlock Text="YER /" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="10" Margin="4,0,0,0" /><TextBlock Text="{Binding Unit}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,0,0,0" /></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border><TextBlock Text="لا توجد مواد خام مطابقة" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNoMaterialOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></controls:DialogHost>
        </Grid>

        <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:02.5" Dismissed="FeedbackDismissed" Margin="28" Panel.ZIndex="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
