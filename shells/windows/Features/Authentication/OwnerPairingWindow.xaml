<Window x:Class="Eitmad.WindowsShell.Features.Authentication.OwnerPairingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="الاعتماد · ربط جهاز" Width="720" Height="560" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"
 FlowDirection="RightToLeft" Language="ar-YE" Background="{DynamicResource CanvasBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28" MaxWidth="600">
  <TextBlock Text="ربط جهاز بالورشة" FontSize="26" FontWeight="Bold"/>
  <TextBlock Text="لمالك المنشأة فقط. افتح الاعتماد على الجهاز الجديد، واختر هذا الخادم، ثم أدخل الرمز. كل موظف يسجل الدخول بحسابه بعد الربط." Margin="0,12,0,20"/>
  <Button x:Name="OpenCodeButton" Content="إظهار رمز ربط جديد" Style="{StaticResource PrimaryButton}" Click="OpenClick" AutomationProperties.Name="إظهار رمز ربط جهاز جديد"/>
  <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,12">
   <StackPanel><TextBlock x:Name="CodeText" Text="لم يُطلب رمز" FontSize="32" FlowDirection="LeftToRight" TextAlignment="Center" AutomationProperties.Name="رمز الربط المؤقت"/>
    <TextBlock x:Name="ExpiryText" Text="لا تشارك الرمز إلا مع الشخص الذي يربط جهاز الورشة." TextAlignment="Center" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="PairingNotice" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,16"/>
  <TextBlock Text="ربط الجهاز لا ينشئ حسابًا للموظف ولا يمنحه صلاحيات. استخدم المستخدمون لإضافة حساب أو إيقافه."/>
  <Button Content="إدارة حسابات الموظفين" Style="{StaticResource SecondaryButton}" Click="StaffClick" Margin="0,12,0,0" AutomationProperties.Name="فتح إدارة حسابات الموظفين"/>
 </StackPanel></ScrollViewer>
</Window>
