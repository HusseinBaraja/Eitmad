<UserControl x:Class="Eitmad.WindowsShell.Features.Authentication.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             layout:ResponsiveLayout.IsEnabled="True"
             FlowDirection="RightToLeft"
             Language="ar-YE"
             Background="{StaticResource CanvasBrush}">
    <Grid FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="0.88*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(layout:ResponsiveLayout.Mode), RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="1.12*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(layout:ResponsiveLayout.Mode), RelativeSource={RelativeSource Self}}"
                                     Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.Background>
                <ImageBrush ImageSource="/Eitmad.WindowsShell;component/Resources/ShowroomHero.png"
                            Stretch="UniformToFill"
                            AlignmentX="Left"
                            AlignmentY="Center" />
            </Grid.Background>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A201713" />
                        <GradientStop Color="#D92B170A" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="44" VerticalAlignment="Bottom" FlowDirection="RightToLeft">
                <Border Width="54" Height="4" CornerRadius="2" Background="#E5B277" HorizontalAlignment="Right" Margin="0,0,0,18" />
                <TextBlock Text="عملٌ منظّم يبدأ من هنا"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextAlignment="Right" />
                <TextBlock Text="واجهة عربية واضحة لاستقبال العملاء وإدارة أعمال صناعة الأثاث."
                           Foreground="#F3E9DE"
                           FontSize="14"
                           LineHeight="25"
                           TextAlignment="Right"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      VerticalContentAlignment="Stretch"
                      Background="#FFFDFC">
            <Grid FlowDirection="RightToLeft">
                <StackPanel MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="48,34" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(layout:ResponsiveLayout.Mode), RelativeSource={RelativeSource Self}}"
                                             Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                    <Setter Property="Margin" Value="24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <Viewbox Width="46" Height="39" Stretch="Uniform">
                            <Canvas Width="76" Height="62">
                                <Path Fill="#4B260B" Data="M 4,50 L 21,8 L 34,50 L 23,42 L 17,60 Z" />
                                <Path Fill="#8A572A" Data="M 23,50 L 39,1 L 51,50 L 40,42 L 33,61 Z" />
                                <Path Fill="#B08051" Data="M 44,50 L 59,12 L 73,50 L 61,43 L 55,61 Z" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Margin="12,-3,0,0">
                            <TextBlock Text="الاعتماد" FontSize="25" FontWeight="Bold" Foreground="#704019" />
                            <TextBlock Text="لصناعة الأثاث" FontSize="11" Foreground="#704019" Margin="1,-3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="تسجيل الدخول" FontSize="30" FontWeight="Bold" Margin="0,30,0,0" />
                    <TextBlock Text="أدخل بيانات حسابك للانتقال إلى مساحة العمل."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,8,0,25" />

                    <controls:FormField Label="اسم المستخدم" IsRequired="True">
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource TextInput}"
                                 Height="48"
                                 Padding="14,0"
                                 FontSize="14"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 HorizontalContentAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 automation:AutomationProperties.Name="اسم المستخدم"
                                 KeyDown="CredentialKeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="UsernameChrome" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <!-- WPF applies TextBox.Padding to this host; the border must not repeat it. -->
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="UsernameChrome" Property="BorderBrush" Value="#A35E1E" />
                                            <Setter TargetName="UsernameChrome" Property="BorderThickness" Value="1.5" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="UsernameChrome" Property="Background" Value="#FFFEFC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </controls:FormField>

                    <controls:FormField Label="كلمة المرور" IsRequired="True" Margin="0,17,0,0">
                        <Border Height="48" Background="White" BorderBrush="#D8D1CA" BorderThickness="1" CornerRadius="8">
                            <PasswordBox x:Name="PasswordInput"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="14,9"
                                         FontFamily="Segoe UI"
                                         FontSize="16"
                                         FlowDirection="RightToLeft"
                                         HorizontalContentAlignment="Left"
                                         automation:AutomationProperties.Name="كلمة المرور"
                                         KeyDown="CredentialKeyDown" />
                        </Border>
                    </controls:FormField>

                    <TextBlock x:Name="SignInError"
                               TextWrapping="Wrap"
                               Text="بيانات الدخول غير صحيحة."
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="11"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"
                               automation:AutomationProperties.LiveSetting="Assertive" />

                    <Button x:Name="SignInButton"
                            Content="دخول"
                            Height="48"
                            Margin="0,18,0,0"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14"
                            Click="SignInClick"
                            automation:AutomationProperties.Name="تسجيل الدخول" />
                    <TextBlock x:Name="SignInProgress" Text="يتم التحقق من الحساب وإنشاء جلسة آمنة…"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="0,12,0,0" TextAlignment="Center"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <Border Margin="0,22,0,0" Padding="12,9" Background="#F6EEE6" CornerRadius="8">
                        <TextBlock Text="تُرسل بيانات الدخول مباشرة إلى محرك Rust ولا يحفظها التطبيق."
                                   TextWrapping="Wrap"
                                   Foreground="#704019"
                                   FontSize="10"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
