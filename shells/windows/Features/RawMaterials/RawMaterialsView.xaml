<UserControl x:Class="Eitmad.WindowsShell.Features.RawMaterials.RawMaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ReferenceActionsTemplate"><StackPanel Margin="5,3,5,2">
                                            <Border Height="1" Background="#ECE4DC" Margin="3,2,3,5" />
                                            <Button Tag="{Binding Tag}" Click="AddReferenceFromDropdownClick" Style="{StaticResource DropdownActionButton}">
                                                <TextBlock Foreground="#8B4D17" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="+ إضافة تصنيف جديد" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Tag}" Value="unit"><Setter Property="Text" Value="+ إضافة وحدة جديدة" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Tag="{Binding Tag}" Click="ManageReferencesFromDropdownClick" Style="{StaticResource DropdownActionButton}">
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="إدارة التصنيفات" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Tag}" Value="unit"><Setter Property="Text" Value="إدارة الوحدات" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel></DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListSurface">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader  Title="المواد الخام" Subtitle="بحث سريع وتكاليف واضحة وإدارة بدون حذف دائم"><StackPanel Orientation="Horizontal"><Button Height="46" Style="{StaticResource PrimaryButton}" Click="AddRawMaterialClick" automation:AutomationProperties.Name="إضافة مادة خام">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Path Data="{StaticResource IconPlus}" Width="18" Height="18" Fill="White" Stretch="Uniform" />
                            <TextBlock Text="إضافة مادة خام" Foreground="White" FontSize="13" Margin="9,0,0,0" />
                        </StackPanel>
                    </Button></StackPanel></controls:PageHeader>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,28">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" x:Name="FiltersGrid" Margin="0,0,0,14">
                        <StackPanel>
                            <controls:FormField Label="البحث"><TextBox x:Name="RawMaterialsSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ابحث باسم المادة أو الفئة أو الوحدة" automation:AutomationProperties.Name="البحث في المواد الخام" Style="{StaticResource SearchInput}" /></controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الفئة"><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الفئة" /></controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الحالة"><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الحالة" /></controls:FormField>
                        </StackPanel>

                    </layout:AdaptiveFieldsPanel>

                    <Border Style="{StaticResource Card}" ClipToBounds="True" MinHeight="310">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                            <ScrollViewer Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <Grid MinWidth="760">
                                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="#F7F3EF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.55*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="اسم المادة" Style="{StaticResource TableHeader}" />
                                            <TextBlock Grid.Column="1" Text="الفئة" Style="{StaticResource TableHeader}" />
                                            <TextBlock Grid.Column="2" Text="الوحدة" Style="{StaticResource TableHeader}" />
                                                        <TextBlock Grid.Column="3" Text="التكلفة الحالية" Style="{StaticResource TableHeader}" />
                                            <TextBlock Grid.Column="4" Text="الحالة" Style="{StaticResource TableHeader}" />
                                            <TextBlock Grid.Column="5" Text="الإجراءات" Style="{StaticResource TableHeader}" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleMaterials}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="White" Cursor="Hand" MouseLeftButtonUp="RawMaterialRowClick">
                                                    <Grid FlowDirection="RightToLeft">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.55*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,8" FlowDirection="LeftToRight">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="NoWrap" />
                                                            <TextBlock Text="مادة خام" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource TableBody}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource TableBody}" />
                                                        <controls:AmountDisplay Grid.Column="3" HorizontalAlignment="Center" AmountText="{Binding CostAmountLabel}" UnitText="{Binding CurrencyLabel}" UnitPlacement="Before"/>
                                                        <controls:StatusBadge x:Name="StatusPill" Grid.Column="4" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Tone="Success"></controls:StatusBadge>
                                                        <Button Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات المادة الخام">
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FlowDirection="LeftToRight" Style="{StaticResource ActionMenu}" Placement="Right" HorizontalOffset="6">
                                                                    <MenuItem Header="تعديل" Style="{StaticResource ActionMenuItem}" Click="EditMenuItemClick" />
                                                                    <MenuItem Header="تكرار" Style="{StaticResource ActionMenuItem}" Click="DuplicateMenuItemClick" />
                                                                    <Separator Style="{StaticResource ActionMenuSeparator}" />
                                                                    <MenuItem Header="أرشفة" Style="{StaticResource ActionMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveMenuItemClick" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                        <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                        <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                        <Setter TargetName="StatusPill" Property="Background" Value="#E5E2DF" />
                                                        <Setter TargetName="StatusPill" Property="Foreground" Value="#716B66" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                            <controls:EmptyState Grid.Row="1" Panel.ZIndex="4" Heading="لا توجد مواد مطابقة" Description="جرّب تغيير البحث أو عوامل التصفية."><controls:EmptyState.Style>
                                    <Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasNoVisibleMaterials}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </controls:EmptyState.Style></controls:EmptyState>
                            <Border Grid.Row="2" Background="#FCFAF8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorSurface">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <controls:PageHeader  Title="{Binding EditorTitle}" Subtitle="بيانات تجريبية غير محفوظة"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="العودة إلى القائمة" Click="CancelEditorClick" /></StackPanel></controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,24" MaxWidth="860" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Card}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="تفاصيل المادة" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="يمكنك مراجعة البيانات قبل حفظها في المعاينة المحلية." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,24" />
                            <controls:FormField Label="اسم المادة"><TextBox x:Name="EditorNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Margin="0,0,0,18" /></controls:FormField>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <controls:FormField Label="الفئة"><ComboBox Tag="category" ItemsSource="{Binding ActiveCategories}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding EditorCategory, Mode=TwoWay}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصنيف المادة الخام" controls:ControlOptions.FooterTemplate="{StaticResource ReferenceActionsTemplate}" /></controls:FormField>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <controls:FormField Label="الوحدة"><ComboBox Tag="unit" ItemsSource="{Binding ActiveUnits}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Name" SelectedValue="{Binding EditorUnit, Mode=TwoWay}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="وحدة المادة الخام" controls:ControlOptions.FooterTemplate="{StaticResource ReferenceActionsTemplate}" /></controls:FormField>
                                </StackPanel>
                            </Grid>
                            <controls:FormField Label="التكلفة الحالية (ر.س.)" ErrorText="{Binding EditorError}"><TextBox Text="{Binding EditorCost, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextInput}" FontFamily="Segoe UI" FlowDirection="LeftToRight" TextAlignment="Right" /></controls:FormField>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0" FlowDirection="LeftToRight">
                                <Button Style="{StaticResource PrimaryButton}" Height="44" Click="SaveEditorClick"><TextBlock Text="حفظ في المعاينة" Foreground="White" /></Button>
                                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelEditorClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Panel.ZIndex="30" Background="#6A2B1A0D">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsReferenceManagerOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="520" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="12" Padding="22">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition MaxHeight="350" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding ReferenceManagerTitle}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="يمكنك تعديل العناصر أو أرشفتها بدون حذف دائم." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,15" />
                    <Border Grid.Row="2" BorderBrush="#E6DED6" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ManagedReferences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE7E0" BorderThickness="0,0,0,1" Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ShortName}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,8,0">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="تعديل" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="EditReferenceClick" />
                                                <Button Grid.Column="2" Content="أرشفة" Style="{StaticResource CompactButton}" Foreground="#8B2E1B" BorderBrush="#D5A89E" IsEnabled="{Binding CanArchive}" Click="ArchiveReferenceClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="3" Content="إغلاق" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="CloseReferenceManagerClick" />
                </Grid>
            </Border>
        </Border>

        <Border Panel.ZIndex="31" Background="#6A2B1A0D">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsReferenceEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#36200F" /></Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ReferenceEditorTitle}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="يُضاف العنصر إلى هذه المعاينة فقط." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,20" />
                    <controls:FormField Label="الاسم"><TextBox x:Name="ReferenceNameBox" Text="{Binding ReferenceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" /></controls:FormField>
                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsUnitReference}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <controls:FormField Label="الاسم المختصر" HelpText="مثال: متر مربع — m²"><TextBox Text="{Binding ReferenceShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Right" /></controls:FormField>
                    </StackPanel>
                    <TextBlock Text="{Binding ReferenceError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,9,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasReferenceError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveReferenceClick"><TextBlock Text="حفظ" Foreground="White" /></Button>
                        <Button Style="{StaticResource SecondaryButton}" Content="إلغاء" Margin="9,0,0,0" Click="CancelReferenceClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:02.5" Dismissed="FeedbackDismissed" Margin="28" Panel.ZIndex="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
