<UserControl x:Class="Eitmad.WindowsShell.Features.RawMaterials.RawMaterialsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ReferenceActionsTemplate">
            <StackPanel Margin="5,3,5,2">
                <Border Height="1" Background="#ECE4DC" Margin="3,2,3,5" />
                <Button Tag="{Binding Tag}" Click="AddReferenceFromDropdownClick" Style="{StaticResource DropdownActionButton}">
                    <TextBlock Foreground="#8B4D17" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="+ إضافة تصنيف جديد" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag}" Value="unit">
                                        <Setter Property="Text" Value="+ إضافة وحدة جديدة" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Tag="{Binding Tag}" Click="ManageReferencesFromDropdownClick" Style="{StaticResource DropdownActionButton}">
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="إدارة التصنيفات" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag}" Value="unit">
                                        <Setter Property="Text" Value="إدارة الوحدات" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ListSurface">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="المواد الخام" Subtitle="بحث سريع وتكاليف واضحة وإدارة بدون حذف دائم"
                                 Padding="28,15" ContainsButton="True" ButtonText="إضافة مادة خام" ButtonType="Primary"
                                 ButtonIcon="{StaticResource IconPlus}" ButtonClick="AddRawMaterialClick" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="28,22,28,28">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" x:Name="FiltersGrid" Margin="0,0,0,14">
                        <StackPanel>
                            <controls:FormField Label="البحث">
                                <TextBox x:Name="RawMaterialsSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ابحث باسم المادة أو الفئة أو الوحدة" automation:AutomationProperties.Name="البحث في المواد الخام" Style="{StaticResource SearchInput}" />
                            </controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الفئة">
                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الفئة" />
                            </controls:FormField>
                        </StackPanel>
                        <StackPanel>
                            <controls:FormField Label="الحالة">
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية الحالة" />
                            </controls:FormField>
                        </StackPanel>
                    </layout:AdaptiveFieldsPanel>
                    <Border Style="{StaticResource Card}" ClipToBounds="True" MinHeight="310">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="42" />
                            </Grid.RowDefinitions>
                            <Grid Grid.RowSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <controls:OperationsTable x:Name="MaterialsTable" Grid.Row="1" ItemsSource="{Binding VisibleMaterials}" SelectedValuePath="Id" FlowDirection="RightToLeft" MaxHeight="460" Cursor="Hand" IsRowInvocationEnabled="True" RowInvoked="RawMaterialRowInvoked" automation:AutomationProperties.Name="اسم المادة">
                                        <controls:OperationsTable.EmptyContent>
                                            <controls:EmptyState Heading="لا توجد مواد مطابقة" Description="جرّب تغيير البحث أو عوامل التصفية." />
                                        </controls:OperationsTable.EmptyContent>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="اسم المادة" Width="2*" MinWidth="160" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <StackPanel VerticalAlignment="Center" Margin="18,8" FlowDirection="LeftToRight">
                                                                <TextBlock x:Name="ContrastCell0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="NoWrap" />
                                                                <TextBlock x:Name="ContrastCell1" Text="مادة خام" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                <Setter TargetName="ContrastCell1" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الفئة" Width="1.2*" MinWidth="120" SortMemberPath="Category">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Category}" Style="{StaticResource TableBody}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الوحدة" Width="0.8*" MinWidth="120" SortMemberPath="Unit">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Unit}" Style="{StaticResource TableBody}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="التكلفة الحالية" Width="1.1*" MinWidth="120" SortMemberPath="CurrentCost">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <controls:AmountDisplay HorizontalAlignment="Center" AmountText="{Binding CostAmountLabel}" UnitText="{Binding CurrencyLabel}" UnitPlacement="Before" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الحالة" Width="0.9*" MinWidth="100" SortMemberPath="StatusLabel">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <controls:StatusBadge x:Name="StatusPill" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Tone="Success"></controls:StatusBadge>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                                <Setter TargetName="StatusPill" Property="Background" Value="#E5E2DF" />
                                                                <Setter TargetName="StatusPill" Property="Foreground" Value="#716B66" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الإجراءات" Width="0.55*" MinWidth="70" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowSurface" MinHeight="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" Background="White">
                                                            <Button HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RowActionButton}" Content="⋮" Click="OpenRowMenuClick" automation:AutomationProperties.Name="إجراءات المادة الخام">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FlowDirection="LeftToRight" Style="{StaticResource ActionMenu}" Placement="Right" HorizontalOffset="6">
                                                                        <MenuItem Header="تعديل" Style="{StaticResource ActionMenuItem}" Click="EditMenuItemClick" />
                                                                        <MenuItem Header="تكرار" Style="{StaticResource ActionMenuItem}" Click="DuplicateMenuItemClick" />
                                                                        <Separator Style="{StaticResource ActionMenuSeparator}" />
                                                                        <MenuItem Header="أرشفة" Style="{StaticResource ActionMenuItem}" IsEnabled="{Binding CanArchive}" Click="ArchiveMenuItemClick" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.52" />
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#F3F1EF" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="#FBF4EC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </controls:OperationsTable>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="2" Background="#FCFAF8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="EditorSurface">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="{Binding EditorTitle}" Subtitle="بيانات تجريبية غير محفوظة">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="العودة إلى القائمة" Click="CancelEditorClick" />
                </StackPanel>
            </controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,24" MaxWidth="860" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Card}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="تفاصيل المادة" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="يمكنك مراجعة البيانات قبل حفظها في المعاينة المحلية." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,24" />
                            <controls:FormField Label="اسم المادة">
                                <TextBox x:Name="EditorNameBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Margin="0,0,0,18" />
                            </controls:FormField>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <controls:FormField Label="الفئة">
                                        <ComboBox Tag="category" ItemsSource="{Binding ActiveCategories}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding EditorCategory, Mode=TwoWay}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصنيف المادة الخام" controls:ControlOptions.FooterTemplate="{StaticResource ReferenceActionsTemplate}" />
                                    </controls:FormField>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <controls:FormField Label="الوحدة">
                                        <ComboBox Tag="unit" ItemsSource="{Binding ActiveUnits}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Name" SelectedValue="{Binding EditorUnit, Mode=TwoWay}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="وحدة المادة الخام" controls:ControlOptions.FooterTemplate="{StaticResource ReferenceActionsTemplate}" />
                                    </controls:FormField>
                                </StackPanel>
                            </Grid>
                            <controls:FormField Label="التكلفة الحالية (ر.س.)" ErrorText="{Binding EditorError}">
                                <TextBox Text="{Binding EditorCost, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextInput}" FontFamily="Segoe UI" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </controls:FormField>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,28,0,0" FlowDirection="LeftToRight">
                                <Button Style="{StaticResource PrimaryButton}" Height="44" Click="SaveEditorClick">
                                    <TextBlock Text="حفظ في المعاينة" Foreground="White" />
                                </Button>
                                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelEditorClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <controls:DialogHost Panel.ZIndex="30" IsOpen="{Binding IsReferenceManagerOpen}" Title="{Binding ReferenceManagerTitle}" PreferredWidth="520" FlowDirection="RightToLeft" CloseRequested="CloseReferenceManagerClick">
            <controls:DialogHost.Footer>
                <Button Content="إغلاق" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CloseReferenceManagerClick" />
            </controls:DialogHost.Footer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="يمكنك تعديل العناصر أو أرشفتها بدون حذف دائم." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,15" />
                <Border Grid.Row="2" BorderBrush="#E6DED6" BorderThickness="1" CornerRadius="8">
                    <Border>
                        <ItemsControl ItemsSource="{Binding ManagedReferences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEE7E0" BorderThickness="0,0,0,1" Padding="10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding ShortName}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="تعديل" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="EditReferenceClick" />
                                            <Button Grid.Column="2" Content="أرشفة" Style="{StaticResource CompactButton}" Foreground="#8B2E1B" BorderBrush="#D5A89E" IsEnabled="{Binding CanArchive}" Click="ArchiveReferenceClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Border>
            </Grid>
        </controls:DialogHost>
        <controls:DialogHost Panel.ZIndex="31" IsOpen="{Binding IsReferenceEditorOpen}" Title="{Binding ReferenceEditorTitle}" PreferredWidth="430" FlowDirection="RightToLeft" CloseRequested="CancelReferenceClick" InitialFocusTarget="{Binding ElementName=ReferenceNameBox}">
            <controls:DialogHost.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <Button Style="{StaticResource PrimaryButton}" Height="43" Click="SaveReferenceClick">
                        <TextBlock Text="حفظ" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="إلغاء" Margin="9,0,0,0" Click="CancelReferenceClick" />
                </StackPanel>
            </controls:DialogHost.Footer>
            <StackPanel>
                <TextBlock Text="يُضاف العنصر إلى هذه المعاينة فقط." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,20" />
                <controls:FormField Label="الاسم">
                    <TextBox x:Name="ReferenceNameBox" Text="{Binding ReferenceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" />
                </controls:FormField>
                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnitReference}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <controls:FormField Label="الاسم المختصر" HelpText="مثال: متر مربع — m²">
                        <TextBox Text="{Binding ReferenceShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Right" />
                    </controls:FormField>
                </StackPanel>
                <TextBlock Text="{Binding ReferenceError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,9,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReferenceError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </controls:DialogHost>
        <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" IsFloating="True" FontSize="11" DisplayDuration="00:00:02.5" Dismissed="FeedbackDismissed" Margin="28" Panel.ZIndex="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
