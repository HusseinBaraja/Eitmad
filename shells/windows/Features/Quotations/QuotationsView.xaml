<UserControl x:Class="Eitmad.WindowsShell.Features.Quotations.QuotationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Language="ar-YE" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="DocumentHeader" TargetType="controls:PageHeader" BasedOn="{StaticResource {x:Type controls:PageHeader}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type reception:ReceptionistHomeView}}}" Value="True">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Padding" Value="32,12,32,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="controls:PageHeader">
                                <Grid Margin="{TemplateBinding Padding}" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel FlowDirection="RightToLeft">
                                        <Button x:Name="HeaderButton" Content="{TemplateBinding ButtonText}" Height="46" FontSize="13"
                                                Style="{StaticResource PrimaryButton}" Visibility="{Binding ContainsButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibility}}"
                                                automation:AutomationProperties.Name="{TemplateBinding ButtonText}" />
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ListSubtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LifecycleBusyNotice" TargetType="controls:FeedbackNotice" BasedOn="{StaticResource {x:Type controls:FeedbackNotice}}">
            <Setter Property="Message" Value="جارٍ تأكيد العملية..." />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LifecycleAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadge" TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraft}" Value="True">
                    <Setter Property="Tone" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tone" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConverted}" Value="True">
                    <Setter Property="Tone" Value="Information" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Style="{StaticResource DocumentHeader}" Title="{Binding ListTitle}" Subtitle="{Binding ListSubtitle}" ContainsButton="{Binding IsReceptionist}" ButtonText="+ عرض سعر جديد" ButtonClick="NewQuotationClick"></controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <CheckBox Content="طلبات الخصم المعلقة فقط" IsChecked="{Binding ApprovalsOnly}" Margin="0,0,0,14" AutomationProperties.Name="عرض طلبات الخصم المعلقة فقط"/>
                    <WrapPanel Margin="0,0,0,16">
                        <controls:FormField Label="البحث" Width="360" Margin="0,0,12,8">
                            <TextBox x:Name="QuotationSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="{Binding SearchName}" Style="{StaticResource SearchInput}" />
                        </controls:FormField>
                        <controls:FormField Label="الحالة" Width="240" Margin="0,0,12,8">
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب الحالة" />
                        </controls:FormField>
                        <controls:FormField Label="التاريخ" Width="220" Margin="0,0,12,8">
                            <ComboBox ItemsSource="{Binding DateOptions}" SelectedItem="{Binding SelectedDate}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب التاريخ" />
                        </controls:FormField>
                    </WrapPanel>
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid FlowDirection="LeftToRight">
                            <StackPanel FlowDirection="RightToLeft">
                                <controls:OperationsTable x:Name="QuotationTable" ItemsSource="{Binding VisibleQuotations}" SelectedValuePath="Id" MaxHeight="460" IsRowInvocationEnabled="True" RowInvoked="QuotationRowInvoked" automation:AutomationProperties.Name="رقم عرض السعر">
                                    <controls:OperationsTable.EmptyContent>
                                        <controls:EmptyState Heading="{Binding EmptyTitle}" />
                                    </controls:OperationsTable.EmptyContent>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="المتابعة" controls:OperationsTable.IsCompactDetail="True" Width="1.3*" MinWidth="145">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBlock Text="{Binding ReceptionActivity}" Style="{StaticResource TableBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="رقم عرض السعر" Width="1.18*" MinWidth="120" SortMemberPath="Number">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Number}" Style="{StaticResource TableBody}" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="العميل" controls:OperationsTable.IsCompactDetail="True" Width="1.45*" MinWidth="160" SortMemberPath="Customer">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Customer}" Style="{StaticResource TableBody}" TextWrapping="Wrap" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="التاريخ" controls:OperationsTable.IsCompactDetail="True" Width="0.95*" MinWidth="120" SortMemberPath="Date">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding DateLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الإجمالي" Width="1.15*" MinWidth="120" SortMemberPath="FinalTotal">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding FinalTotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الخصم" controls:OperationsTable.IsCompactDetail="True" Width="1.08*" MinWidth="120" SortMemberPath="Discount">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding DiscountLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="0.95*" MinWidth="100" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <controls:StatusBadge Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Style="{StaticResource StatusBadge}"></controls:StatusBadge>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="فتح" Width="0.68*" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="78">
                                                        <Button Content="فتح" Style="{StaticResource InlineActionButton}" Click="OpenQuotationClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="فتح عرض السعر" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="18,11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="DetailSurface" Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Style="{StaticResource DocumentHeader}" Title="تفاصيل عرض السعر" ShowSubtitle="False">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackToQuotationsButton" Content="العودة إلى العروض" Style="{StaticResource InlineActionButton}" Height="38" Click="BackToListClick" automation:AutomationProperties.Name="العودة إلى قائمة عروض الأسعار" />
                </StackPanel>
            </controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <Border x:Name="QuotationIdentity" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,0,9">
                                <TextBlock Text="رقم عرض السعر" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.Number}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,0,9">
                                <TextBlock Text="الحالة" Style="{StaticResource MetadataLabel}" />
                                <controls:StatusBadge x:Name="DetailStatusBadge" DataContext="{Binding SelectedQuotation}" Margin="0,5,0,0" Padding="12,3" HorizontalAlignment="Left" Text="{Binding StatusLabel}" Style="{StaticResource StatusBadge}"></controls:StatusBadge>
                            </StackPanel>
                            <StackPanel Width="250" Margin="0,0,0,9">
                                <TextBlock Text="العميل" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.Customer}" Style="{StaticResource MetadataValue}" />
                                <Button Content="تفاصيل العميل" Style="{StaticResource InlineActionButton}" HorizontalAlignment="Left" Click="CustomerClick" Visibility="{Binding IsReceptionist, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="فتح تفاصيل عميل عرض السعر"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,0,9">
                                <TextBlock Text="التاريخ" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.DateLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <controls:FeedbackNotice x:Name="DraftNotice" Message="{Binding SelectedQuotation.DraftNotice}" Visibility="{Binding SelectedQuotation.HasDraft, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12"/>
                    <Grid x:Name="DiscountWorkspace">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border x:Name="QuotationItems" Style="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="20,15" BorderBrush="#EEE9E4" BorderThickness="0,0,0,1">
                                        <TextBlock Text="بنود الأثاث" FontSize="17" FontWeight="SemiBold" />
                                    </Border>
                                    <Grid Grid.Row="1" FlowDirection="LeftToRight">
                                        <StackPanel FlowDirection="RightToLeft">
                                            <controls:OperationsTable ItemsSource="{Binding SelectedQuotation.Items}" MaxHeight="460" automation:AutomationProperties.Name="الأثاث">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="الأثاث" Width="1.4*" MinWidth="160" SortMemberPath="FurnitureName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding FurnitureName}" Style="{StaticResource TableBody}" FontWeight="SemiBold" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="المقاس" controls:OperationsTable.IsCompactDetail="True" Width="1.05*" MinWidth="120" SortMemberPath="Variant">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding Variant}" Style="{StaticResource TableBody}" TextWrapping="Wrap" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="اللون" controls:OperationsTable.IsCompactDetail="True" Width="0.85*" MinWidth="160" SortMemberPath="Color">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding Color}" Style="{StaticResource TableBody}" TextWrapping="Wrap" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="المقبض" controls:OperationsTable.IsCompactDetail="True" Width="1.05*" MinWidth="120" SortMemberPath="Handle">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding Handle}" Style="{StaticResource TableBody}" TextWrapping="Wrap" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="الكمية" Width="0.62*" MinWidth="80" SortMemberPath="Quantity">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="سعر الوحدة" controls:OperationsTable.IsCompactDetail="True" Width="1.05*" MinWidth="120" SortMemberPath="UnitPrice">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding UnitPriceLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="الإجمالي" Width="1.12*" MinWidth="120" SortMemberPath="Total">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                                    <TextBlock x:Name="ContrastCell0" Text="{Binding TotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                        <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </controls:OperationsTable>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="QuotationSummary" Style="{StaticResource Card}" Width="430" HorizontalAlignment="Left" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ملخص عرض السعر" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المجموع الفرعي" Style="{StaticResource SummaryLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.SubtotalLabel}" Style="{StaticResource SummaryValue}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الخصم" Style="{StaticResource SummaryLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.DiscountLabel}" Style="{StaticResource SummaryValue}" Foreground="#9A382B" />
                                    </Grid>
                                    <Separator Background="#DED8D2" Margin="0,1,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="210" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الإجمالي النهائي" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.FinalTotalLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#6E3A0D" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border x:Name="ApprovalSection" Padding="20" VerticalAlignment="Top" Visibility="{Binding ShowManagerApproval, Converter={StaticResource BooleanToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Width" Value="370" />
                                    <Setter Property="Margin" Value="16,0,0,16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(layout:ResponsiveLayout.Mode), RelativeSource={RelativeSource Self}}" Value="Compact">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.Row" Value="1" />
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="MaxWidth" Value="430" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="0,0,0,16" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="مراجعة طلب الخصم" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <StackPanel Width="145" Margin="0,0,0,12">
                                        <TextBlock Text="نسبة الخصم المطلوبة" Style="{StaticResource MetadataLabel}"/>
                                        <TextBlock Text="{Binding SelectedQuotation.DiscountPercentLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,0,12">
                                        <TextBlock Text="قيمة الخصم" Style="{StaticResource MetadataLabel}"/>
                                        <controls:AmountDisplay AmountText="{Binding SelectedQuotation.DiscountAmountLabel}" UnitText="ر.ي" HorizontalAlignment="Left" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedQuotation.ApprovalDecisionLabel}" Style="{StaticResource MetadataLabel}" Margin="0,0,0,16"/>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel IsEnabled="{Binding CanDecideApproval}" Visibility="{Binding SelectedQuotation.HasPendingDiscountApproval, Converter={StaticResource BooleanToVisibility}}">
                                            <Button Content="موافقة على الخصم" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="ApproveDiscountClick" automation:AutomationProperties.Name="الموافقة على خصم عرض السعر"/>
                                            <Expander x:Name="DiscountRejection" Header="رفض الخصم" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="14" Margin="0,16,0,0" automation:AutomationProperties.Name="إظهار سبب رفض الخصم">
                                                <StackPanel Margin="0,12,0,0">
                                                    <controls:FormField Label="سبب الرفض" IsRequired="True">
                                                        <TextBox Text="{Binding ApprovalReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" MinHeight="72" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" MaxLength="240" automation:AutomationProperties.Name="سبب رفض الخصم"/>
                                                    </controls:FormField>
                                                    <Button Content="تأكيد الرفض" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="RejectDiscountClick" automation:AutomationProperties.Name="رفض خصم عرض السعر" Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                        <controls:FeedbackNotice Message="{Binding DecisionNotice}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <controls:FeedbackNotice Message="{Binding SelectedQuotation.ApprovalDecisionLabel}" Visibility="{Binding SelectedQuotation.HasApprovalDecision, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12"/>
                    <controls:FeedbackNotice Message="{Binding LifecycleNotice}" Margin="0,0,0,12"/>
                    <Button Content="إعادة محاولة العملية" Click="RetryLifecycleClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,0,0,16" Visibility="{Binding CanRetryLifecycle, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="إعادة محاولة عملية عرض السعر السابقة"/>
                    <Border x:Name="AcceptanceSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16" Visibility="{Binding SelectedQuotation.CanAccept, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="قبول العميل" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <controls:FeedbackNotice Style="{StaticResource LifecycleBusyNotice}"/>
                            <StackPanel IsEnabled="{Binding LifecycleAvailable}">
                                <controls:FormField Label="طريقة قبول العميل" Margin="0,0,0,12">
                                    <ComboBox ItemsSource="{Binding AcceptanceMethods}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AcceptanceMethod}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="طريقة قبول عرض السعر"/>
                                </controls:FormField>
                                <controls:FormField Label="ملاحظة القبول (اختيارية)">
                                    <TextBox Text="{Binding AcceptanceNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="240" Style="{StaticResource TextInput}" automation:AutomationProperties.Name="ملاحظة قبول العميل"/>
                                </controls:FormField>
                                <Button Content="تسجيل قبول العميل" Click="AcceptClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" automation:AutomationProperties.Name="تأكيد قبول العميل لعرض السعر"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DocumentActionsSection" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16" Visibility="{Binding SelectedQuotation.ShowDocumentActions, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="إصدار العرض وطباعته" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <controls:FeedbackNotice Message="بانتظار موافقة المدير — الطباعة غير متاحة" Tone="Warning" Margin="0,0,0,12" Visibility="{Binding SelectedQuotation.IsWaitingApproval, Converter={StaticResource BooleanToVisibility}}"/>
                            <controls:FeedbackNotice x:Name="DocumentBusyNotice" Style="{StaticResource LifecycleBusyNotice}"/>
                            <WrapPanel IsEnabled="{Binding LifecycleAvailable}">
                                <controls:FormField Label="مدة الصلاحية بالأيام" Width="200" Margin="0,0,16,8" Visibility="{Binding SelectedQuotation.ShowValidityInput, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBox Text="{Binding ValidityInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Right" automation:AutomationProperties.Name="مدة صلاحية عرض السعر بالأيام"/>
                                </controls:FormField>
                                <WrapPanel VerticalAlignment="Bottom">
                                    <Button Content="إصدار عرض السعر" Click="IssueClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="{Binding SelectedQuotation.CanIssue, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="إصدار عرض السعر"/>
                                    <Button Content="تعديل الصلاحية" Click="ValidityClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Visibility="{Binding SelectedQuotation.CanManageValidity, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تعديل صلاحية عرض السعر"/>
                                    <Button Content="إصدار جديد" Click="ReviseClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Visibility="{Binding SelectedQuotation.CanRevise, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="إنشاء إصدار جديد من عرض السعر"/>
                                    <Button Content="طباعة" Click="PrintQuotationClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Visibility="{Binding SelectedQuotation.CanPrintConfirmed, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="طباعة عرض السعر المؤكد"/>
                                </WrapPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="معاينة فقط" Visibility="{Binding SelectedQuotation.IsPreview, Converter={StaticResource BooleanToVisibility}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsReceptionist, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,16">
                        <WrapPanel DataContext="{Binding SelectedQuotation}">
                            <Button Content="تعديل" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="EditQuotationClick" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تعديل عرض السعر"/>
                            <Button Content="طباعة" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="PrintQuotationClick" Visibility="{Binding CanPrintPreview, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="طباعة عرض السعر"/>
                            <Button Content="تحويل إلى طلب" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="ConvertQuotationClick" Visibility="{Binding CanConvert, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تحويل عرض السعر إلى طلب"/>
                            <Button Content="فتح الطلب" Style="{StaticResource PrimaryButton}" Click="OpenLinkedOrderClick" Visibility="{Binding IsConverted, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="فتح الطلب"/>
                        </WrapPanel>
                        <controls:FeedbackNotice Message="تم التحويل إلى طلب" Tone="Information" Visibility="{Binding SelectedQuotation.IsConverted, Converter={StaticResource BooleanToVisibility}}"/>
                        <TextBlock x:Name="ReceptionActionNotice" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border x:Name="CancellationSection" Style="{StaticResource Card}" Width="600" HorizontalAlignment="Left" Padding="16" Margin="0,0,0,16" Visibility="{Binding SelectedQuotation.CanCancel, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="إلغاء عرض السعر" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <controls:FeedbackNotice Style="{StaticResource LifecycleBusyNotice}"/>
                            <StackPanel IsEnabled="{Binding LifecycleAvailable}">
                                <controls:FormField Label="سبب إلغاء العرض" IsRequired="True" Margin="0,0,0,12" Visibility="{Binding SelectedQuotation.ShowCancellationReason, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBox Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" MaxLength="240" automation:AutomationProperties.Name="سبب إلغاء عرض السعر"/>
                                </controls:FormField>
                                <Button Content="إلغاء العرض" Click="CancelQuotationClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" automation:AutomationProperties.Name="إلغاء عرض السعر مع حفظ السجل"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <controls:DialogHost x:Name="ConversionDialog" Panel.ZIndex="20" Title="تحويل إلى طلب" PreferredWidth="520"
                             CloseRequested="CancelConversionClick" InitialFocusTarget="{Binding ElementName=CancelConversionButton}">
            <controls:DialogHost.Footer>
                <WrapPanel>
                    <Button x:Name="ConfirmConversionButton" Content="تأكيد وإنشاء الطلب" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,8" Click="ConfirmConversionClick" automation:AutomationProperties.Name="تأكيد وإنشاء الطلب"/>
                    <Button x:Name="CancelConversionButton" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,8" Click="CancelConversionClick" automation:AutomationProperties.Name="إلغاء"/>
                </WrapPanel>
            </controls:DialogHost.Footer>
            <StackPanel>
                <controls:FormField Label="العميل" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Customer}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
                </controls:FormField>
                <controls:FormField Label="عدد البنود" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Items.Count}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="17"/>
                </controls:FormField>
                <controls:FormField Label="الإجمالي النهائي" Margin="0,0,0,16">
                    <controls:AmountDisplay AmountText="{Binding FinalTotalLabel}" FontSize="24" FontWeight="Bold"/>
                </controls:FormField>
                <controls:FeedbackNotice Message="معاينة فقط" Tone="Information" Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
        </controls:DialogHost>
    </Grid>
</UserControl>
