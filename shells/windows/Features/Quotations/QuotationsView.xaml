<UserControl x:Class="Eitmad.WindowsShell.Features.Quotations.QuotationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Language="ar-YE" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="StatusBadge" TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraft}" Value="True">
                    <Setter Property="Tone" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tone" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConverted}" Value="True">
                    <Setter Property="Tone" Value="Information" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ApprovalButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="105" />
        </Style>
        <Style x:Key="RejectButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#9A382B" />
            <Setter Property="BorderBrush" Value="#C98980" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Grid.Row="0" Title="{Binding ListTitle}" Subtitle="{Binding ListSubtitle}" ContainsButton="{Binding IsReceptionist}" ButtonText="+ عرض سعر جديد" ButtonClick="NewQuotationClick"></controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <CheckBox Content="طلبات الخصم المعلقة فقط" IsChecked="{Binding ApprovalsOnly}" Margin="0,0,0,14" AutomationProperties.Name="عرض طلبات الخصم المعلقة فقط"/>
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,16">
                        <controls:FormField Label="البحث">
                            <TextBox x:Name="QuotationSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="{Binding SearchName}" Style="{StaticResource SearchInput}" />
                        </controls:FormField>
                        <controls:FormField Label="الحالة">
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب الحالة" />
                        </controls:FormField>
                        <controls:FormField Label="التاريخ">
                            <ComboBox ItemsSource="{Binding DateOptions}" SelectedItem="{Binding SelectedDate}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب التاريخ" />
                        </controls:FormField>
                    </layout:AdaptiveFieldsPanel>
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid FlowDirection="LeftToRight">
                            <StackPanel FlowDirection="RightToLeft">
                                <controls:OperationsTable x:Name="QuotationTable" ItemsSource="{Binding VisibleQuotations}" SelectedValuePath="Id" MaxHeight="460" IsRowInvocationEnabled="True" RowInvoked="QuotationRowInvoked" automation:AutomationProperties.Name="رقم عرض السعر">
                                    <controls:OperationsTable.EmptyContent>
                                        <controls:EmptyState Heading="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" />
                                    </controls:OperationsTable.EmptyContent>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="المتابعة" Width="1.3*" MinWidth="145">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBlock Text="{Binding ReceptionActivity}" Style="{StaticResource TableBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="رقم عرض السعر" Width="1.18*" MinWidth="120" SortMemberPath="Number">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Number}" Style="{StaticResource TableBody}" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="العميل" Width="1.45*" MinWidth="160" SortMemberPath="Customer">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Customer}" Style="{StaticResource TableBody}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="التاريخ" Width="0.95*" MinWidth="120" SortMemberPath="Date">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding DateLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الإجمالي" Width="1.15*" MinWidth="120" SortMemberPath="FinalTotal">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding FinalTotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الخصم" Width="1.08*" MinWidth="120" SortMemberPath="Discount">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding DiscountLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="0.95*" MinWidth="100" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <controls:StatusBadge Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}" Style="{StaticResource StatusBadge}"></controls:StatusBadge>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="فتح" Width="0.68*" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="White" MinHeight="65">
                                                        <Button Content="فتح" Style="{StaticResource InlineActionButton}" Click="OpenQuotationClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="فتح عرض السعر" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="18,11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="DetailSurface" Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="تفاصيل عرض السعر" Subtitle="مراجعة بنود العرض والإجماليات">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackToQuotationsButton" Content="العودة إلى العروض" Style="{StaticResource InlineActionButton}" Height="38" Click="BackToListClick" automation:AutomationProperties.Name="العودة إلى قائمة عروض الأسعار" />
                </StackPanel>
            </controls:PageHeader>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <Border x:Name="ApprovalSection" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16" Visibility="{Binding ShowManagerApproval, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="موافقة الخصم مطلوبة" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="طلب من الاستقبال — راجع البنود والإجماليات. القرار مؤقت لهذه المعاينة فقط." TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <TextBlock Text="{Binding SelectedQuotation.DiscountDetailLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="18" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0" Visibility="{Binding SelectedQuotation.HasPendingDiscountApproval, Converter={StaticResource BooleanToVisibility}}">
                                <Button Content="موافقة" Style="{StaticResource PrimaryButton}" Click="ApproveDiscountClick" automation:AutomationProperties.Name="الموافقة على خصم عرض السعر" Margin="0,0,0,6"/>
                                <Button Content="رفض" Style="{StaticResource SecondaryButton}" Click="RejectDiscountClick" automation:AutomationProperties.Name="رفض خصم عرض السعر" Margin="10,0,0,6"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedQuotation.ApprovalDecisionLabel}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <controls:FeedbackNotice Message="{Binding SelectedQuotation.ApprovalDecisionLabel}" Visibility="{Binding SelectedQuotation.HasApprovalDecision, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsReceptionist, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,16">
                        <TextBlock Text="معاينة ببيانات تجريبية — الحفظ والتحويل غير متاحين بعد" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <WrapPanel DataContext="{Binding SelectedQuotation}">
                            <Button Content="تعديل" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="EditQuotationClick" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تعديل عرض السعر"/>
                            <Button Content="طباعة" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="PrintQuotationClick" Visibility="{Binding CanPrint, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="طباعة عرض السعر"/>
                            <Button Content="تحويل إلى طلب" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="ConvertQuotationClick" Visibility="{Binding CanPrint, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تحويل عرض السعر إلى طلب"/>
                            <Button Content="فتح الطلب" Style="{StaticResource PrimaryButton}" Click="OpenLinkedOrderClick" Visibility="{Binding IsConverted, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="فتح الطلب"/>
                        </WrapPanel>
                        <controls:FeedbackNotice Message="بانتظار موافقة المدير — العرض للقراءة فقط. تتاح الطباعة بعد الموافقة." Tone="Warning" Visibility="{Binding SelectedQuotation.IsWaitingApproval, Converter={StaticResource BooleanToVisibility}}"/>
                        <controls:FeedbackNotice Message="تم التحويل إلى طلب" Tone="Information" Visibility="{Binding SelectedQuotation.IsConverted, Converter={StaticResource BooleanToVisibility}}"/>
                        <TextBlock x:Name="ReceptionActionNotice" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20">
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,0,9">
                                <TextBlock Text="رقم عرض السعر" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.Number}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,0,9">
                                <TextBlock Text="الحالة" Style="{StaticResource MetadataLabel}" />
                                <controls:StatusBadge x:Name="DetailStatusBadge" DataContext="{Binding SelectedQuotation}" Margin="0,5,0,0" Padding="12,3" HorizontalAlignment="Right" Text="{Binding StatusLabel}" Style="{StaticResource StatusBadge}"></controls:StatusBadge>
                            </StackPanel>
                            <StackPanel Width="250" Margin="0,0,0,9">
                                <TextBlock Text="العميل" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.Customer}" Style="{StaticResource MetadataValue}" />
                                <Button Content="تفاصيل العميل" Style="{StaticResource InlineActionButton}" HorizontalAlignment="Left" Click="CustomerClick" Visibility="{Binding IsReceptionist, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="فتح تفاصيل عميل عرض السعر"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,0,9">
                                <TextBlock Text="التاريخ" Style="{StaticResource MetadataLabel}" />
                                <TextBlock Text="{Binding SelectedQuotation.DateLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Padding="20,15" BorderBrush="#EEE9E4" BorderThickness="0,0,0,1">
                                <TextBlock Text="بنود الأثاث" FontSize="17" FontWeight="SemiBold" />
                            </Border>
                            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                                <StackPanel FlowDirection="RightToLeft">
                                    <controls:OperationsTable ItemsSource="{Binding SelectedQuotation.Items}" MaxHeight="460" automation:AutomationProperties.Name="الأثاث">
                                        <DataGrid.Columns>

                                            <DataGridTemplateColumn Header="الأثاث" Width="1.4*" MinWidth="160" SortMemberPath="FurnitureName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding FurnitureName}" Style="{StaticResource TableBody}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="المقاس" Width="1.05*" MinWidth="120" SortMemberPath="Variant">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Variant}" Style="{StaticResource TableBody}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="اللون" Width="0.85*" MinWidth="160" SortMemberPath="Color">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Color}" Style="{StaticResource TableBody}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="المقبض" Width="1.05*" MinWidth="120" SortMemberPath="Handle">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding Handle}" Style="{StaticResource TableBody}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الكمية" Width="0.62*" MinWidth="80" SortMemberPath="Quantity">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="سعر الوحدة" Width="1.05*" MinWidth="120" SortMemberPath="UnitPrice">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding UnitPriceLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="الإجمالي" Width="1.12*" MinWidth="120" SortMemberPath="Total">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" MinHeight="58">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding TotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                                <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </controls:OperationsTable>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="430" HorizontalAlignment="Left" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ملخص عرض السعر" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المجموع الفرعي" Style="{StaticResource SummaryLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.SubtotalLabel}" Style="{StaticResource SummaryValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الخصم" Style="{StaticResource SummaryLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.DiscountLabel}" Style="{StaticResource SummaryValue}" Foreground="#9A382B" />
                            </Grid>
                            <Separator Background="#DED8D2" Margin="0,1,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الإجمالي النهائي" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.FinalTotalLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#6E3A0D" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <controls:DialogHost x:Name="ConversionDialog" Panel.ZIndex="20" Title="تحويل إلى طلب" PreferredWidth="520"
                             CloseRequested="CancelConversionClick" InitialFocusTarget="{Binding ElementName=CancelConversionButton}">
            <controls:DialogHost.Footer>
                <WrapPanel>
                    <Button x:Name="ConfirmConversionButton" Content="تأكيد وإنشاء الطلب" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,8" Click="ConfirmConversionClick" automation:AutomationProperties.Name="تأكيد وإنشاء الطلب"/>
                    <Button x:Name="CancelConversionButton" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,8" Click="CancelConversionClick" automation:AutomationProperties.Name="إلغاء"/>
                </WrapPanel>
            </controls:DialogHost.Footer>
            <StackPanel>
                <TextBlock Text="سيتم إنشاء طلب جديد من عرض السعر الحالي." TextWrapping="Wrap" Margin="0,0,0,20"/>
                <controls:FormField Label="العميل" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Customer}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
                </controls:FormField>
                <controls:FormField Label="عدد البنود" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Items.Count}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="17"/>
                </controls:FormField>
                <controls:FormField Label="الإجمالي النهائي" Margin="0,0,0,16">
                    <controls:AmountDisplay AmountText="{Binding FinalTotalLabel}" FontSize="24" FontWeight="Bold"/>
                </controls:FormField>
                <TextBlock Text="تنتقل بيانات العميل والبنود والخيارات والكميات والأسعار والخصم دون إعادة إدخال." TextWrapping="Wrap" Margin="0,0,0,12"/>
                <controls:FeedbackNotice Message="معاينة فقط — ستُعرض تفاصيل طلب تجريبي دون حفظه أو تغيير عرض السعر." Tone="Information"/>
            </StackPanel>
        </controls:DialogHost>
    </Grid>
</UserControl>
