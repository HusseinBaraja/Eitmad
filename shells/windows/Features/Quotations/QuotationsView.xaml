<UserControl x:Class="Eitmad.WindowsShell.Features.Quotations.QuotationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>

        <Style x:Key="StatusBadge" TargetType="Border" BasedOn="{StaticResource StatusSurface}"><Style.Triggers><DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Background" Value="#FFF4D8" /><Setter Property="BorderBrush" Value="#E6C66F" /></DataTrigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#EAF5ED" /><Setter Property="BorderBrush" Value="#B9D9C2" /></DataTrigger><DataTrigger Binding="{Binding IsConverted}" Value="True"><Setter Property="Background" Value="#EAF2F8" /><Setter Property="BorderBrush" Value="#B8D0E1" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusLabel}"><Style.Triggers><DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Foreground" Value="#805D12" /></DataTrigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="#267441" /></DataTrigger><DataTrigger Binding="{Binding IsConverted}" Value="True"><Setter Property="Foreground" Value="#2D617F" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="ApprovalButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="42" /><Setter Property="MinWidth" Value="105" /></Style>
        <Style x:Key="RejectButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="42" /><Setter Property="MinWidth" Value="105" /><Setter Property="Padding" Value="18,8" /><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#9A382B" /><Setter Property="BorderBrush" Value="#C98980" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /></Style>
    </UserControl.Resources>

    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,20">
                <StackPanel><TextBlock Text="عروض الأسعار" FontSize="29" FontWeight="Bold" /><TextBlock Text="راجع عروض العملاء وحالاتها من مكان واحد" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,16">
                        <TextBox x:Name="QuotationSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث برقم عرض السعر أو العميل" Style="{StaticResource SearchInput}" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" Margin="10,0,0,8" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب الحالة" />
                        <ComboBox ItemsSource="{Binding DateOptions}" SelectedItem="{Binding SelectedDate}" Style="{StaticResource SelectInput}" Margin="10,0,0,8" automation:AutomationProperties.Name="تصفية عروض الأسعار حسب التاريخ" />
                    </layout:AdaptiveFieldsPanel>

                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
                            <StackPanel MinWidth="1030" FlowDirection="RightToLeft">
                                <Grid Height="47" Background="#F7F3EF">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="0.68*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="رقم عرض السعر" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="العميل" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="التاريخ" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="الإجمالي" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="الخصم" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="6" Text="فتح" Style="{StaticResource TableHeader}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding VisibleQuotations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE9E4" BorderThickness="0,0,0,1" Background="White" MinHeight="65">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="0.68*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource TableBody}" FontWeight="SemiBold" FlowDirection="LeftToRight" /><TextBlock Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="2" Text="{Binding DateLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="3" Text="{Binding FinalTotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding DiscountLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" Foreground="{StaticResource MutedBrush}" />
                                                    <Border Grid.Column="5" Style="{StaticResource StatusBadge}" CornerRadius="12" Height="27" Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}" /></Border>
                                                    <Button Grid.Column="6" Content="فتح" Style="{StaticResource InlineActionButton}" Click="OpenQuotationClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="فتح عرض السعر" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="18,11" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Margin="0,16,0,0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="28" Visibility="{Binding HasNoVisibleQuotations, Converter={StaticResource BooleanToVisibility}}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="لا توجد عروض أسعار مطابقة" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="غيّر البحث أو عوامل التصفية." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextAlignment="Center" /></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailSurface" Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,17">
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="BackToQuotationsButton" Grid.Column="0" Content="العودة إلى العروض" Style="{StaticResource InlineActionButton}" Height="38" Click="BackToListClick" automation:AutomationProperties.Name="العودة إلى قائمة عروض الأسعار" /><StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تفاصيل عرض السعر" FontSize="25" FontWeight="Bold" /><TextBlock Text="مراجعة بنود العرض والإجماليات" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="32,22,32,30">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,0,9"><TextBlock Text="رقم عرض السعر" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedQuotation.Number}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
                            <StackPanel Width="180" Margin="0,0,0,9"><TextBlock Text="الحالة" Style="{StaticResource MetadataLabel}" /><Border DataContext="{Binding SelectedQuotation}" Style="{StaticResource StatusBadge}" CornerRadius="12" Height="28" Padding="12,3" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}" /></Border></StackPanel>
                            <StackPanel Width="250" Margin="0,0,0,9"><TextBlock Text="العميل" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedQuotation.Customer}" Style="{StaticResource MetadataValue}" /></StackPanel>
                            <StackPanel Width="160" Margin="0,0,0,9"><TextBlock Text="التاريخ" Style="{StaticResource MetadataLabel}" /><TextBlock Text="{Binding SelectedQuotation.DateLabel}" Style="{StaticResource MetadataValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,16,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Padding="20,15" BorderBrush="#EEE9E4" BorderThickness="0,0,0,1"><TextBlock Text="بنود الأثاث" FontSize="17" FontWeight="SemiBold" /></Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
                                <StackPanel MinWidth="980" FlowDirection="RightToLeft">
                                    <Grid Height="43" Background="#F7F3EF"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.62*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الأثاث" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="1" Text="المقاس" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="2" Text="اللون" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="3" Text="المقبض" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="4" Text="الكمية" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="5" Text="سعر الوحدة" Style="{StaticResource TableHeader}" /><TextBlock Grid.Column="6" Text="الإجمالي" Style="{StaticResource TableHeader}" /></Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedQuotation.Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEE9E4" BorderThickness="0,0,0,1" MinHeight="58"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.62*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding FurnitureName}" Style="{StaticResource TableBody}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Variant}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="2" Text="{Binding Color}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="3" Text="{Binding Handle}" Style="{StaticResource TableBody}" /><TextBlock Grid.Column="4" Text="{Binding QuantityLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="5" Text="{Binding UnitPriceLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" /><TextBlock Grid.Column="6" Text="{Binding TotalLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="ApprovalSection" Style="{StaticResource Card}" Background="#FFF9EC" BorderBrush="#E3C980" Padding="20" Margin="0,16,0,0" Visibility="{Binding SelectedQuotation.RequiresDiscountApproval, Converter={StaticResource BooleanToVisibility}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="موافقة الخصم مطلوبة" FontSize="16" FontWeight="Bold" Foreground="#73520D" /><TextBlock Text="يتجاوز هذا الخصم حد الموافقة. راجع الإجماليات قبل اتخاذ القرار." Foreground="#7A6742" FontSize="11" Margin="0,6,0,0" /><TextBlock Text="{Binding SelectedQuotation.DiscountDetailLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="15" FontWeight="SemiBold" Foreground="#73520D" Margin="0,10,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="{Binding SelectedQuotation.HasPendingDiscountApproval, Converter={StaticResource BooleanToVisibility}}"><Button Content="موافقة" Style="{StaticResource ApprovalButton}" Click="ApproveDiscountClick" automation:AutomationProperties.Name="الموافقة على خصم عرض السعر" /><Button Content="رفض" Style="{StaticResource RejectButton}" Margin="9,0,0,0" Click="RejectDiscountClick" automation:AutomationProperties.Name="رفض خصم عرض السعر" /></StackPanel><Border Grid.Column="1" Background="#F4EBD6" CornerRadius="8" Padding="14,9" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="{Binding SelectedQuotation.HasApprovalDecision, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding SelectedQuotation.ApprovalDecisionLabel}" Foreground="#654A17" FontSize="10" /></Border></Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Width="430" HorizontalAlignment="Left" Padding="22" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="ملخص عرض السعر" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" /><Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="المجموع الفرعي" Style="{StaticResource SummaryLabel}" /><TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.SubtotalLabel}" Style="{StaticResource SummaryValue}" /></Grid><Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الخصم" Style="{StaticResource SummaryLabel}" /><TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.DiscountLabel}" Style="{StaticResource SummaryValue}" Foreground="#9A382B" /></Grid><Separator Background="#DED8D2" Margin="0,1,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="الإجمالي النهائي" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding SelectedQuotation.FinalTotalLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#6E3A0D" /></Grid></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
