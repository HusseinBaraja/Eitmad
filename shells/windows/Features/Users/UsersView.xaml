<UserControl x:Class="Eitmad.WindowsShell.Features.Users.UsersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
 xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
 FlowDirection="RightToLeft" Language="ar-YE" Background="{StaticResource CanvasBrush}">
 <Grid>
 <Grid x:Name="ListSurface" Visibility="{Binding IsListVisible, Converter={StaticResource BooleanToVisibility}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <controls:PageHeader Title="المستخدمون">
   <Button Content="+ إضافة مستخدم" Style="{StaticResource PrimaryButton}" Click="AddClick" AutomationProperties.Name="إضافة مستخدم"/>
  </controls:PageHeader>
  <Grid Grid.Row="1" Margin="28,22,28,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="معاينة فقط — بيانات تجريبية لا تغيّر صلاحية الدخول." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
   <layout:AdaptiveFieldsPanel Grid.Row="1" MinItemWidth="210" Margin="0,0,0,18">
    <controls:FormField Label="البحث"><TextBox x:Name="UsersSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInput}" controls:ControlOptions.Placeholder="ابحث باسم المستخدم" AutomationProperties.Name="البحث عن مستخدم"/></controls:FormField>
    <controls:FormField Label="الدور"><ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource SelectInput}" AutomationProperties.Name="تصفية الدور"/></controls:FormField>
    <controls:FormField Label="الحالة"><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource SelectInput}" AutomationProperties.Name="تصفية الحالة"/></controls:FormField>
   </layout:AdaptiveFieldsPanel>
   <controls:OperationsTable x:Name="UsersTable" Grid.Row="2" ItemsSource="{Binding VisibleUsers}" AutomationProperties.Name="قائمة المستخدمين" VerticalAlignment="Top" RowHeight="68">
    <controls:OperationsTable.EmptyContent><controls:EmptyState Heading="لا يوجد مستخدمون مطابقون" Description="جرّب تغيير البحث أو عوامل التصفية."/></controls:OperationsTable.EmptyContent>
    <DataGrid.Columns>
     <DataGridTextColumn Header="المستخدم" Binding="{Binding Name}" Width="2*" MinWidth="180" ElementStyle="{StaticResource TableBody}"/>
     <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="*" MinWidth="160" ElementStyle="{StaticResource TableBody}"/>
     <DataGridTemplateColumn Header="الحالة" Width="*" MinWidth="115" SortMemberPath="Status">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <controls:StatusBadge Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:StatusBadge.Style><Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}"><Setter Property="Tone" Value="Neutral"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Tone" Value="Success"/></DataTrigger></Style.Triggers></Style></controls:StatusBadge.Style>
       </controls:StatusBadge>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="الإجراءات" Width="*" MinWidth="175" CanUserSort="False">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button Content="تعديل" Style="{StaticResource InlineActionButton}" Click="EditClick" AutomationProperties.Name="{Binding Name, StringFormat=تعديل المستخدم {0}}"/>
       <Button Content="تعطيل" Style="{StaticResource InlineActionButton}" Margin="12,0,0,0" Click="DeactivateClick" IsEnabled="{Binding IsActive}" AutomationProperties.Name="{Binding Name, StringFormat=تعطيل المستخدم {0}}"/>
      </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </controls:OperationsTable>
  </Grid>
 </Grid>
 <Grid x:Name="EditorSurface" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.Resources>
   <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,28,28,32" HorizontalContentAlignment="Stretch" Grid.RowSpan="2">
   <StackPanel x:Name="EditorContent" MaxWidth="640" HorizontalAlignment="Stretch">
    <controls:PageHeader Title="{Binding EditorTitle}" Height="Auto" MinHeight="64" Padding="0,0,0,16" Background="Transparent" BorderThickness="0"/>
    <TextBlock Text="معاينة فقط — لا يتم إنشاء حساب أو تغيير صلاحية الدخول." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <Border Style="{StaticResource Card}" Padding="24">
     <StackPanel>
      <controls:FormField Label="الاسم" ErrorText="{Binding EditorError}"><TextBox x:Name="UserNameInput" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" AutomationProperties.Name="الاسم"/></controls:FormField>
      <controls:FormField Margin="0,20,0,0">
       <controls:FormField.Style>
        <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}">
         <Setter Property="Label" Value="اسم المستخدم"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Label" Value="اسم المستخدم (للقراءة فقط)"/></DataTrigger></Style.Triggers>
        </Style>
       </controls:FormField.Style>
       <TextBox x:Name="UsernameInput" Text="{Binding EditorUsername, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditing}" FlowDirection="LeftToRight" Style="{StaticResource TextInput}" AutomationProperties.Name="اسم المستخدم"/>
      </controls:FormField>
      <layout:AdaptiveFieldsPanel MinItemWidth="260" Spacing="20" Margin="0,20,0,0">
       <controls:FormField Label="الدور"><ComboBox x:Name="UserRoleInput" ItemsSource="{Binding Roles}" SelectedItem="{Binding EditorRole}" Style="{StaticResource SelectInput}" AutomationProperties.Name="دور المستخدم"/></controls:FormField>
       <controls:FormField Label="الحالة"><ComboBox x:Name="UserStatusInput" ItemsSource="{Binding EditorStatuses}" SelectedItem="{Binding EditorStatus}" Style="{StaticResource SelectInput}" AutomationProperties.Name="حالة المستخدم"/></controls:FormField>
      </layout:AdaptiveFieldsPanel>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
       <StackPanel Orientation="Horizontal">
        <Button Content="حفظ" MinWidth="104" Style="{StaticResource PrimaryButton}" Click="ApplyClick" AutomationProperties.Name="حفظ"/>
        <Button Content="إلغاء" MinWidth="88" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelEditClick" AutomationProperties.Name="إلغاء تعديل المستخدم"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
  <controls:DialogHost Grid.RowSpan="2" IsOpen="{Binding IsDeactivationOpen}" Title="تعطيل المستخدم" PreferredWidth="460" Padding="28" CloseRequested="CancelDeactivateClick" InitialFocusTarget="{Binding ElementName=CancelDeactivateButton}">
   <StackPanel><TextBlock Text="{Binding DeactivationName}" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="تعطيل هذا المستخدم في المعاينة؟ سيبقى في القائمة بحالة غير نشط. لن تتغير صلاحية الدخول الفعلية."/></StackPanel>
   <controls:DialogHost.Footer><StackPanel Orientation="Horizontal">
    <Button Content="تعطيل في المعاينة" Style="{StaticResource PrimaryButton}" Click="ConfirmDeactivateClick" AutomationProperties.Name="تأكيد التعطيل في المعاينة"/>
    <Button x:Name="CancelDeactivateButton" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelDeactivateClick" AutomationProperties.Name="إلغاء تعطيل المستخدم"/>
   </StackPanel></controls:DialogHost.Footer>
  </controls:DialogHost>
 </Grid>
</UserControl>
