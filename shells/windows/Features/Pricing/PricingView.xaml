<UserControl x:Class="Eitmad.WindowsShell.Features.Pricing.PricingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Grid.Row="0" Title="التسعير" ShowSubtitle="False">
            <WrapPanel>
                <TextBlock Text="{Binding AvailabilityMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,12,0" />
                <Button Content="إعادة تحميل الأسعار" Click="ReloadClick" Style="{StaticResource SecondaryButton}" automation:AutomationProperties.Name="إعادة تحميل الأسعار" />
            </WrapPanel>
        </controls:PageHeader>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="32,24,32,30">
                <Expander x:Name="CatalogSyncReview" Margin="0,0,0,12" FontSize="13"
                          Visibility="{Binding HasSyncIssues, Converter={StaticResource BooleanToVisibility}}"
                          automation:AutomationProperties.Name="مراجعة تعريفات المزامنة">
                    <Expander.Header>
                        <TextBlock x:Name="CatalogSyncIssueNotice" Text="{Binding SyncIssueMessage}" Foreground="{StaticResource DangerBrush}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding SyncIssues}" Margin="0,8,0,0" Focusable="False" KeyboardNavigation.IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="780" VerticalAlignment="Center" />
                                    <controls:StatusBadge Grid.Column="1" Margin="12,0" Tone="Danger" Focusable="False" KeyboardNavigation.IsTabStop="False">
                                        <controls:StatusBadge.Style>
                                            <Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
                                                <Setter Property="Text" Value="مرفوض" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Conflicted}" Value="True">
                                                        <Setter Property="Text" Value="تعارض" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:StatusBadge.Style>
                                    </controls:StatusBadge>
                                    <Button Grid.Column="2" Content="مراجعة التعريف" Style="{StaticResource SecondaryButton}" Click="ReviewDefinitionClick" automation:AutomationProperties.Name="{Binding Name, StringFormat=مراجعة تعريف {0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <WrapPanel Margin="0,0,0,17">
                    <controls:FormField Label="البحث" Width="360" Margin="0,0,12,8">
                        <TextBox x:Name="PricingSearchBox" Height="46" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن منتج أو مقاس" Style="{StaticResource SearchInput}" />
                    </controls:FormField>
                    <controls:FormField Label="الفئة" Width="240" Margin="0,0,12,8">
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية حسب الفئة" />
                    </controls:FormField>
                </WrapPanel>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PricingTableScroll" Grid.Row="0" Grid.RowSpan="2" FlowDirection="RightToLeft">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:OperationsTable x:Name="PricingRows" Grid.Row="1" ItemsSource="{Binding VisiblePrices}" SelectedValuePath="Id" FlowDirection="RightToLeft" MaxHeight="460" IsRowInvocationEnabled="True" RowInvoked="PriceRowInvoked" automation:AutomationProperties.Name="المنتج">
                                    <controls:OperationsTable.EmptyContent>
                                        <controls:EmptyState Heading="لا توجد أسعار مطابقة" Description="جرّب كلمة بحث أو فئة أخرى." />
                                    </controls:OperationsTable.EmptyContent>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="المنتج" Width="1.55*" MinWidth="160" SortMemberPath="Product">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Product}" Style="{StaticResource TableBody}" TextWrapping="Wrap" FontWeight="SemiBold" FlowDirection="RightToLeft" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="المقاس" controls:OperationsTable.IsCompactDetail="True" Width="1.05*" MinWidth="120" SortMemberPath="Variant">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding Variant}" Style="{StaticResource TableBody}" TextWrapping="Wrap" FlowDirection="RightToLeft" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="التكلفة" controls:OperationsTable.IsCompactDetail="True" Width="1.12*" MinWidth="120" SortMemberPath="Cost">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding CostLabel}" Style="{StaticResource TableBody}" FlowDirection="LeftToRight" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="سعر البيع" Width="1.42*" MinWidth="120" SortMemberPath="SellingPrice">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <Border x:Name="ContrastCell2" Background="#FFF8F0" CornerRadius="9" Margin="10,9" BorderBrush="#EAD3BC" BorderThickness="1">
                                                            <TextBlock x:Name="ContrastCell0" Text="{Binding SellingPriceLabel}" Style="{StaticResource TableBody}" FontSize="15" FontWeight="Bold" Foreground="#713B08" FlowDirection="LeftToRight" />
                                                        </Border>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                            <Setter TargetName="ContrastCell2" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الهامش" controls:OperationsTable.IsCompactDetail="True" Width="1.12*" MinWidth="120" SortMemberPath="Margin">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell1" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <TextBlock x:Name="ContrastCell0" Text="{Binding MarginLabel}" FlowDirection="LeftToRight">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableBody}">
                                                                    <Setter Property="Foreground" Value="#20723D" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNegativeMargin}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                            <Setter TargetName="ContrastCell1" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="0.9*" MinWidth="100" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <controls:StatusBadge Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}">
                                                            <controls:StatusBadge.Style>
                                                                <Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
                                                                    <Setter Property="Tone" Value="Success" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NeedsPublication}" Value="True">
                                                                            <Setter Property="Tone" Value="Warning" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:StatusBadge.Style>
                                                        </controls:StatusBadge>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="تعديل" Width="0.78*" MinWidth="70" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ContrastCell0" BorderBrush="#EEE9E4" BorderThickness="0" Background="Transparent" MinHeight="78">
                                                        <Button Content="تعديل" Style="{StaticResource InlineActionButton}" Click="EditPriceClick" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="تعديل سعر البيع" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource AncestorType=controls:OperationsTable}}" Value="True">
                                                            <Setter TargetName="ContrastCell0" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:OperationsTable>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="18,12" Orientation="Horizontal">
                            <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>
                <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:03" Dismissed="FeedbackDismissed" Margin="0,18,0,0" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
        <controls:DialogHost Grid.RowSpan="2" Panel.ZIndex="20" IsOpen="{Binding IsEditorOpen}" Title="تعديل سعر البيع" PreferredWidth="440" Padding="28" FontSize="22" FooterMargin="0" FlowDirection="RightToLeft" CloseRequested="CancelPriceClick" InitialFocusTarget="{Binding ElementName=PriceInput}">
            <controls:DialogHost.Footer>
                <WrapPanel>
                    <Button Content="{Binding SaveActionLabel}" Style="{StaticResource PrimaryButton}" Height="44" MinWidth="116" Click="SavePriceClick" IsEnabled="{Binding CanSave}" automation:AutomationProperties.Name="حفظ سعر البيع" />
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelPriceClick" IsEnabled="{Binding CanEdit}" automation:AutomationProperties.Name="إلغاء تعديل السعر" />
                    <TextBlock Text="{Binding EditorPublicationState}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" />
                </WrapPanel>
            </controls:DialogHost.Footer>
            <StackPanel>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorProduct}" Grid.Column="0" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="المنتج" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                </Grid>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorVariant}" Grid.Column="0" FontSize="13" />
                    <TextBlock Text="المقاس" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                </Grid>
                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorCost}" Grid.Column="0" FontSize="13" FlowDirection="LeftToRight" TextAlignment="Right" />
                    <TextBlock Text="التكلفة" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                </Grid>
                <controls:FormField Label="سعر البيع" Margin="0,0,0,0" ErrorText="{Binding EditorError}">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F2ECE6" CornerRadius="9,0,0,9" BorderBrush="#D8CFC6" BorderThickness="1,1,0,1">
                            <TextBlock Text="ر.ي" FontSize="14" FontWeight="SemiBold" Foreground="#704A2A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBox x:Name="PriceInput" Grid.Column="1" controls:ControlOptions.CornerRadius="0,9,9,0" IsEnabled="{Binding CanEdit}" Text="{Binding EditorSellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="17" FontWeight="SemiBold" automation:AutomationProperties.Name="سعر البيع الجديد" />
                    </Grid>
                </controls:FormField>
                <CheckBox Style="{StaticResource FormCheckBox}" Content="أؤكد نشر سعر أقل من التكلفة" IsChecked="{Binding ConfirmBelowCost}" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasNegativeEditorMargin, Converter={StaticResource BooleanToVisibility}}" automation:AutomationProperties.Name="تأكيد نشر سعر أقل من التكلفة" Margin="0,16,0,0" />
                <Border Background="#F7F4F1" CornerRadius="9" Padding="14,11" Margin="0,16,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EditorMargin}" Grid.Column="0" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#20723D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNegativeEditorMargin}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="الهامش المحسوب" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </controls:DialogHost>
    </Grid>
</UserControl>
