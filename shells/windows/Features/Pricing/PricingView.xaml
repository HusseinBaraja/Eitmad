<UserControl x:Class="Eitmad.WindowsShell.Features.Pricing.PricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FlowDirection="RightToLeft"
             Background="{StaticResource CanvasBrush}">
    <Grid layout:ResponsiveLayout.IsEnabled="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="التسعير" Subtitle="راجع أسعار البيع وحدّثها بسرعة من مكان واحد"></controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="32,24,32,30">
                <layout:AdaptiveFieldsPanel MinItemWidth="220" Margin="0,0,0,17">

                    <TextBox x:Name="PricingSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="البحث عن منتج أو مقاس" Style="{StaticResource SearchInput}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SelectInput}" automation:AutomationProperties.Name="تصفية حسب الفئة" />
                </layout:AdaptiveFieldsPanel>

                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <ScrollViewer x:Name="PricingTableScroll" Grid.Row="0" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="RightToLeft"><Grid MinWidth="920"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid x:Name="PricingTableHeader" Background="#F7F3EF" Height="48" MinWidth="920" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="1.42*" /><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.78*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المنتج" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="1" Text="المقاس" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="2" Text="التكلفة" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="3" Text="سعر البيع" Foreground="#7B410F" FontSize="12" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="4" Text="الهامش" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="6" Text="تعديل" Style="{StaticResource TableHeader}" />
                        </Grid>
                            <ItemsControl x:Name="PricingRows" Grid.Row="1" ItemsSource="{Binding VisiblePrices}" MinWidth="920" FlowDirection="RightToLeft">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE9E4" BorderThickness="0,0,0,1" Background="White" MinHeight="68">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="1.42*" /><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.78*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Product}" Style="{StaticResource TableBody}" FontWeight="SemiBold" FlowDirection="RightToLeft" />
                                                <TextBlock Grid.Column="1" Text="{Binding Variant}" Style="{StaticResource TableBody}" FlowDirection="RightToLeft" />
                                                <TextBlock Grid.Column="2" Text="{Binding CostLabel}" Style="{StaticResource TableBody}" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                                <Border Grid.Column="3" Background="#FFF8F0" CornerRadius="9" Margin="10,9" BorderBrush="#EAD3BC" BorderThickness="1">
                                                    <TextBlock Text="{Binding SellingPriceLabel}" Style="{StaticResource TableBody}" FontSize="15" FontWeight="Bold" Foreground="#713B08" FlowDirection="LeftToRight" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding MarginLabel}" FlowDirection="LeftToRight">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TableBody}"><Setter Property="Foreground" Value="#20723D" /><Style.Triggers><DataTrigger Binding="{Binding HasNegativeMargin}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <controls:StatusBadge Grid.Column="5" Padding="11,3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StatusLabel}"><controls:StatusBadge.Style><Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}"><Setter Property="Tone" Value="Success"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Tone" Value="Neutral"/></DataTrigger></Style.Triggers></Style></controls:StatusBadge.Style></controls:StatusBadge>
                                                <Button Grid.Column="6" Content="تعديل" Style="{StaticResource InlineActionButton}" Click="EditPriceClick" HorizontalAlignment="Center" VerticalAlignment="Center" automation:AutomationProperties.Name="تعديل سعر البيع" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid></ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="18,12" Orientation="Horizontal">
                            <TextBlock Text="{Binding VisibleCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:FeedbackNotice x:Name="Feedback" Message="{Binding FeedbackMessage}" Tone="Success" DisplayDuration="00:00:03" Dismissed="FeedbackDismissed" Margin="0,18,0,0" Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}"/>
                <controls:EmptyState Margin="0,18,0,0" Visibility="{Binding HasNoVisiblePrices, Converter={StaticResource BooleanToVisibility}}" Heading="لا توجد أسعار مطابقة" Description="جرّب كلمة بحث أو فئة أخرى."></controls:EmptyState>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.RowSpan="2" Panel.ZIndex="20" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibility}}" FlowDirection="LeftToRight">
            <Border Background="#7A201A17" />
            <Border Width="440" MaxWidth="440" Background="White" BorderBrush="#D8C8B9" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" FlowDirection="RightToLeft">
                <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.28" Color="#3D2513" /></Border.Effect>
                <StackPanel>
                    <TextBlock Text="تعديل سعر البيع" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="تغيير سريع لهذا المقاس فقط" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,21" />

                    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBlock Text="{Binding EditorProduct}" Grid.Column="0" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="المنتج" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Grid>
                    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBlock Text="{Binding EditorVariant}" Grid.Column="0" FontSize="13" /><TextBlock Text="المقاس" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Grid>
                    <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBlock Text="{Binding EditorCost}" Grid.Column="0" FontSize="13" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBlock Text="التكلفة" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Grid>

                    <TextBlock Text="سعر البيع" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F2ECE6" CornerRadius="9,0,0,9" BorderBrush="#D8CFC6" BorderThickness="1,1,0,1"><TextBlock Text="YER" FontSize="11" FontWeight="SemiBold" Foreground="#704A2A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBox x:Name="PriceInput" Grid.Column="1" Text="{Binding EditorSellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="17" FontWeight="SemiBold" automation:AutomationProperties.Name="سعر البيع الجديد" />
                    </Grid>
                    <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,7,0,0" Visibility="{Binding HasEditorError, Converter={StaticResource BooleanToVisibility}}" />

                    <Border Background="#F7F4F1" CornerRadius="9" Padding="14,11" Margin="0,16,0,22">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding EditorMargin}" Grid.Column="0" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#20723D" /><Style.Triggers><DataTrigger Binding="{Binding HasNegativeEditorMargin}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="الهامش المحسوب" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Height="44" MinWidth="116" Click="SavePriceClick" automation:AutomationProperties.Name="حفظ سعر البيع" />
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="CancelPriceClick" automation:AutomationProperties.Name="إلغاء تعديل السعر" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
