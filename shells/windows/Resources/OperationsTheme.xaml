<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Color x:Key="CanvasColor">#FBFAF8</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#201A17</Color>
    <Color x:Key="MutedColor">#746E69</Color>
    <Color x:Key="LineColor">#E7E2DD</Color>
    <Color x:Key="CopperColor">#A35E1E</Color>
    <Color x:Key="SuccessColor">#238A43</Color>
    <Color x:Key="WarningColor">#E18419</Color>
    <Color x:Key="DangerColor">#E33F3F</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ForestBrush" Color="#1F6F3D" />
    <SolidColorBrush x:Key="CopperBrush" Color="{StaticResource CopperColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CopperTintBrush" Color="#F6EEE6" />
    <SolidColorBrush x:Key="StatusDotBrush" Color="#A35E1E" />
    <LinearGradientBrush x:Key="NavSelectedBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#9A5C22" />
        <GradientStop Color="#693705" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI Variable Text, Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.055" Color="#5A3514" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" FlowDirection="LeftToRight">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Path=(controls:ControlOptions.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="HoverShade" Background="{Binding Path=(controls:ControlOptions.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{Binding Path=(controls:ControlOptions.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" CornerRadius="{Binding Path=(controls:ControlOptions.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid FlowDirection="{TemplateBinding FlowDirection}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ActionIcon" Data="{Binding Path=(controls:ControlOptions.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" Stretch="Uniform" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            <Border x:Name="IconGap" Grid.Column="1" Width="8" />
                            <ContentPresenter x:Name="ActionText" Grid.Column="2" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Margin="3" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="controls:ControlOptions.Icon" Value="{x:Null}">
                            <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconGap" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.ShowText" Value="False">
                            <Setter TargetName="ActionText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconGap" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconGap" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverShade" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="Opacity" Value="{Binding Path=(controls:ControlOptions.HoverOpacity), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="{Binding Path=(controls:ControlOptions.PressedOpacity), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="controls:ControlOptions.ShowFocusRing" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            <Setter TargetName="ActionText" Property="Opacity" Value="0.48" />
                            <Setter TargetName="ActionIcon" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.HighContrast" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            <Setter TargetName="ActionText" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            <Setter TargetName="ActionIcon" Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#9A5C22" />
                    <GradientStop Color="#693705" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="controls:ControlOptions.HoverOpacity" Value="0.88" />
        <Setter Property="controls:ControlOptions.PressedOpacity" Value="0.74" />
        <Setter Property="controls:ControlOptions.CornerRadius" Value="9" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="controls:ControlOptions.ShowFocusRing" Value="False" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5DDD5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="controls:ControlOptions.CornerRadius" Value="21" />
        <Setter Property="controls:ControlOptions.HoverBackground" Value="{StaticResource CopperTintBrush}" />
        <Setter Property="controls:ControlOptions.HoverBorderBrush" Value="#C99A6C" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        <Setter Property="automation:AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="NavItem" TargetType="Border">
        <Setter Property="Height" Value="51" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="51" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
        <Setter Property="automation:AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Chrome">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0.08" />
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.08" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.48" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" />
                        <Border x:Name="HoverShade" Background="#30703A08" CornerRadius="10" IsHitTestVisible="False" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="Padding" Value="8,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E9E3DD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="controls:ControlOptions.HoverBackground" Value="#FBF4EC" />
        <Setter Property="controls:ControlOptions.HoverBorderBrush" Value="#C99A6C" />
        <Setter Property="controls:ControlOptions.PressedOpacity" Value="0.7" />
        <Setter Property="controls:ControlOptions.CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#1F579D" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="#713B08" />
        <Setter Property="Background" Value="#DEDAD5" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
