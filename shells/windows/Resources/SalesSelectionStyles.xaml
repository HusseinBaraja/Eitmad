<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout">
  <Style x:Key="SelectionWorkspace" TargetType="Grid">
   <Setter Property="MaxWidth" Value="1040"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="20,12"/>
   <Setter Property="layout:ResponsiveLayout.IsEnabled" Value="True"/>
  </Style>
  <Style x:Key="SelectionPriceSummary" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="16"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style x:Key="SelectionSupportingAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style x:Key="OptionCard" TargetType="ListBoxItem" BasedOn="{StaticResource FilterChip}">
   <Setter Property="MinWidth" Value="160"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,10,10"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
  </Style>
  <DataTemplate x:Key="OptionTitle">
   <StackPanel Orientation="Horizontal" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="✓" Margin="0,0,8,0" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibility}}"/>
    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" reception:SalesText.Value="{Binding Name}" FontSize="16"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="Options" TargetType="ListBox">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <!-- The page owns scrolling. A nested ScrollViewer consumes wheel events even with disabled scrollbars. -->
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ItemsPresenter/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle" Value="{StaticResource OptionCard}"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
