<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="OptionCard" TargetType="ListBoxItem" BasedOn="{StaticResource FilterChip}">
   <Setter Property="MinWidth" Value="180"/><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,10,10"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
  </Style>
  <DataTemplate x:Key="OptionTitle">
   <StackPanel Orientation="Horizontal" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="✓" Margin="0,0,8,0" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibility}}"/>
    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Name}" FontSize="18"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="Options" TargetType="ListBox">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <!-- The page owns scrolling. A nested ScrollViewer consumes wheel events even with disabled scrollbars. -->
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ItemsPresenter/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle" Value="{StaticResource OptionCard}"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
