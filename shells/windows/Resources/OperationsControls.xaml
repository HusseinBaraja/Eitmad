                            <Setter TargetName="Step" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Circle" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Number" Property="Foreground" Value="White" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}" />
