        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="controls:ControlOptions.HoverBackground" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="controls:ControlOptions.HoverBorderBrush" Value="#A39B93" />
