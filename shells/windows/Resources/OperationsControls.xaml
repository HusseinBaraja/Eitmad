    </Style>
    <Style TargetType="controls:PageHeader">
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="Height" Value="{StaticResource PageHeaderHeight}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="28,16" />
        <Setter Property="DescriptionFontSize" Value="{StaticResource PageHeaderDescriptionSize}" />
        <Setter Property="FontSize" Value="{StaticResource PageHeaderTitleSize}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="#FEFDFC" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Border x:Name="ContrastPart2" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" FlowDirection="RightToLeft">
                                <Button x:Name="HeaderButton" Visibility="Collapsed" Height="{TemplateBinding ButtonHeight}"
                                        Style="{StaticResource PrimaryButton}" FontSize="13"
                                        Command="{TemplateBinding ButtonCommand}" CommandParameter="{TemplateBinding ButtonCommandParameter}"
                                        AutomationProperties.Name="{TemplateBinding ButtonText}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <Path x:Name="ButtonIcon" Data="{TemplateBinding ButtonIcon}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, ElementName=HeaderButton}" />
                                        <TextBlock x:Name="ButtonLabel" Text="{TemplateBinding ButtonText}" Foreground="{Binding Foreground, ElementName=HeaderButton}" FontSize="{Binding FontSize, ElementName=HeaderButton}" Margin="9,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" FlowDirection="RightToLeft">
                                    <ContentPresenter Content="{TemplateBinding BackAction}" />
                                    <TextBlock x:Name="ContrastPart0" Text="{TemplateBinding Title}" ToolTip="{TemplateBinding Title}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
