<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="TextInput" TargetType="TextBox">
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#DED6CE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Path=(controls:ControlOptions.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="InputIcon" Data="{Binding Path=(controls:ControlOptions.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" Stretch="Uniform" Fill="{TemplateBinding Foreground}" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{Binding Path=(controls:ControlOptions.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="controls:ControlOptions.Icon" Value="{x:Null}">
                            <Setter TargetName="InputIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" />
                            <Setter TargetName="InputChrome" Property="Background" Value="#FFFEFC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputChrome" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" />
                            <Setter TargetName="InputChrome" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.HighContrast" Value="True">
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" FlowDirection="LeftToRight" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter FlowDirection="{TemplateBinding FlowDirection}" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#F3E5D7" />
                            <Setter Property="Foreground" Value="#6C390D" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#FBF2E9" />
                            <Setter Property="Foreground" Value="#7A4314" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.HighContrast" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="controls:ControlOptions.HighContrast" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SelectInput" TargetType="ComboBox">
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#DED6CE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MaxDropDownHeight" Value="300" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid FlowDirection="LeftToRight">
                        <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Path=(controls:ControlOptions.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ChevronSurface" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F6EEE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="Chevron" Data="M3,7 L8,12 L13,7" Stroke="#8B4D17" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                                </Border>
                                <ContentPresenter x:Name="SelectionContent" Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="{TemplateBinding FlowDirection}" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Style="{StaticResource TextInput}" Margin="42,0,0,0" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" FlowDirection="{TemplateBinding FlowDirection}" VerticalContentAlignment="Center" />
                        <Popup x:Name="PART_Popup" FlowDirection="{TemplateBinding FlowDirection}" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" Focusable="False">
                            <Border x:Name="PopupSurface" Width="{Binding ActualWidth, ElementName=InputChrome}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                    <ContentPresenter x:Name="ReferenceActions" Grid.Row="1" Content="{Binding RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding Path=(controls:ControlOptions.FooterTemplate), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="#C69A70" />
                            <Setter TargetName="InputChrome" Property="Background" Value="#FFFEFC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" />
                            <Setter TargetName="InputChrome" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="#A35E1E" />
                            <Setter TargetName="InputChrome" Property="Background" Value="#FFFCF8" />
                            <Setter TargetName="Chevron" Property="Data" Value="M3,12 L8,7 L13,12" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="50" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputChrome" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.FooterTemplate" Value="{x:Null}">
                            <Setter TargetName="ReferenceActions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.HighContrast" Value="True">
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter TargetName="PopupSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter TargetName="PopupSurface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter TargetName="PopupSurface" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="ChevronSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(controls:ControlOptions.HighContrast), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="ActionMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="White" BorderBrush="#DCCFC2" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="154">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#4A2B12" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActionMenuItem" TargetType="MenuItem">
        <Setter Property="controls:ControlOptions.HighContrast" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuSurface" FlowDirection="LeftToRight" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter FlowDirection="{TemplateBinding FlowDirection}" ContentSource="Header" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuSurface" Property="Background" Value="#FBF0E5" />
                            <Setter Property="Foreground" Value="#783F0D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.36" />
                        </Trigger>
                        <Trigger Property="controls:ControlOptions.HighContrast" Value="True">
                            <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="controls:ControlOptions.HighContrast" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActionMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#ECE4DC" Margin="9,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="TableBody" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderBrush" Value="#B79A80" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="InlineActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="66" />
        <Setter Property="Padding" Value="13,5" />
        <Setter Property="Background" Value="#F7EEE5" />
        <Setter Property="Foreground" Value="#76400F" />
        <Setter Property="BorderBrush" Value="#DAB997" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="DropdownActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Height" Value="35" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#7B410F" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SearchInput" TargetType="TextBox" BasedOn="{StaticResource TextInput}">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="controls:ControlOptions.Icon" Value="{StaticResource IconSearch}" />
        <Setter Property="controls:ControlOptions.Placeholder" Value="{Binding Path=(automation:AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="MetadataLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="MetadataValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="StatusSurface" TargetType="Border">
        <Setter Property="Background" Value="#F0EEEC" />
        <Setter Property="BorderBrush" Value="#DED8D2" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#625C57" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Noto Kufi Arabic, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>