<Window x:Class="Eitmad.WindowsShell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Eitmad.WindowsShell" xmlns:home="clr-namespace:Eitmad.WindowsShell.Features.Home" xmlns:authentication="clr-namespace:Eitmad.WindowsShell.Features.Authentication" xmlns:reception="clr-namespace:Eitmad.WindowsShell.Features.Reception" xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout" xmlns:furniture="clr-namespace:Eitmad.WindowsShell.Features.Furniture" xmlns:orders="clr-namespace:Eitmad.WindowsShell.Features.Orders" xmlns:parts="clr-namespace:Eitmad.WindowsShell.Features.Parts" xmlns:pricing="clr-namespace:Eitmad.WindowsShell.Features.Pricing" xmlns:products="clr-namespace:Eitmad.WindowsShell.Features.Products" xmlns:quotations="clr-namespace:Eitmad.WindowsShell.Features.Quotations" xmlns:rawMaterials="clr-namespace:Eitmad.WindowsShell.Features.RawMaterials" xmlns:users="clr-namespace:Eitmad.WindowsShell.Features.Users" xmlns:workOrders="clr-namespace:Eitmad.WindowsShell.Features.WorkOrders" Title="الاعتماد · تسجيل الدخول" Width="1338" Height="753" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{StaticResource CanvasBrush}" FlowDirection="RightToLeft" Language="ar-YE" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Alt" Command="{x:Static local:MainWindow.SwitchAccountCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.SwitchAccountCommand}" Executed="SwitchAccountExecuted" CanExecute="CanSwitchAccount" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="SmallMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="ResponsivePageMargin" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="32,17,32,24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}">
                    <Setter Property="Padding" Value="24,16,24,24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                    <Setter Property="Padding" Value="16,14,16,20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResponsiveMetricsGrid" TargetType="UniformGrid">
            <Setter Property="Columns" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}">
                    <Setter Property="Columns" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                    <Setter Property="Columns" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResponsiveQuickActionsGrid" TargetType="UniformGrid">
            <Setter Property="Columns" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}">
                    <Setter Property="Columns" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                    <Setter Property="Columns" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="ShellHost">
    <Grid x:Name="ResponsiveRoot" FlowDirection="LeftToRight" layout:ResponsiveLayout.IsEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="DashboardSurface" Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <controls:ShellTitleBar x:Name="ManagerTitleBar" Title="لوحة التحكم" PrimaryActionLabel="الموافقات"
                SearchPlaceholder="ابحث عن عرض سعر أو طلب أو عميل أو صنف..."
                SwitchAccountHint="تسجيل الخروج وتبديل الحساب · Alt+K"
                AccountSwitchRequested="ManagerTitleBarAccountSwitchRequested"
                ActionRequested="ManagerTitleBarActionRequested" SearchSubmitted="ManagerTitleBarSearchSubmitted"/>
            <ScrollViewer Grid.Row="1" Style="{StaticResource ResponsivePageMargin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="لوحة التحكم" FontSize="25" FontWeight="Bold" Margin="0,0,0,16"/>
                    <UniformGrid x:Name="QuickActionsGrid" Style="{StaticResource ResponsiveQuickActionsGrid}" Margin="-6,0">
                        <Button Content="الموافقات" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="الموافقات" Click="HomeActionClick" AutomationProperties.Name="فتح موافقات الخصم"/>
                        <Button Content="قائمة الأسعار" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="التسعير" Click="HomeActionClick"/>
                        <Button Content="الأثاث" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="الأثاث" Click="HomeActionClick"/>
                        <Button Content="الطلبات" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="الطلبات" Click="HomeActionClick"/>
                        <Button Content="إدارة القطع" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="القطع" Click="HomeActionClick"/>
                        <Button Content="إدارة الخامات" Style="{StaticResource QuickActionButton}" Margin="6" Padding="12" Tag="الخامات" Click="HomeActionClick"/>
                    </UniformGrid>
                    <home:HomeView x:Name="ManagerHome" Margin="0,16,0,0"/>
                    <TextBlock Text="غير متاح: البحث الشامل في عملاء المؤسسة وتحصيل المدفوعات والمخزون والتركيبات والرسائل وتقارير الأقسام." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <controls:FeedbackNotice x:Name="InteractionToast" Grid.Row="1" Margin="30" Padding="18,11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="40" Tone="Information" IsFloating="True" DisplayDuration="00:00:02.5" Dismissed="DismissToast"/>
        </Grid>
        <rawMaterials:RawMaterialsView x:Name="RawMaterialsSurface" Grid.Column="0" Visibility="Collapsed" />
        <users:UsersView x:Name="UsersSurface" Grid.Column="0" Visibility="Collapsed" />
        <parts:PartsView x:Name="PartsSurface" Grid.Column="0" Visibility="Collapsed" />
        <furniture:FurnitureView x:Name="FurnitureSurface" Grid.Column="0" Visibility="Collapsed" />
        <pricing:PricingView x:Name="PricingSurface" Grid.Column="0" Visibility="Collapsed" />
        <products:ProductsView x:Name="ProductsSurface" Grid.Column="0" Visibility="Collapsed" />
        <quotations:QuotationsView x:Name="QuotationsSurface" Grid.Column="0" Visibility="Collapsed" />
        <orders:OrdersView x:Name="OrdersSurface" Grid.Column="0" Visibility="Collapsed" />
        <workOrders:WorkOrdersView x:Name="WorkOrdersSurface" Grid.Column="0" Visibility="Collapsed" />
        <!-- Right navigation -->
        <controls:ShellSidebar x:Name="ManagerSidebar" Grid.Column="1" NavigationRequested="ManagerSidebarNavigationRequested" />
        <TextBlock Visibility="Collapsed" Text="CNC-04 · Windows / Rust · مرجع REF-١٢" />
    </Grid>
        <reception:ReceptionistHomeView x:Name="ReceptionistSurface"
                                        Panel.ZIndex="20"
                                        Visibility="Collapsed"
                                        AccountSwitchRequested="ReceptionistAccountSwitchRequested" />
        <authentication:SignInView x:Name="SignInSurface"
                                   Panel.ZIndex="50"
                                   SignedIn="SessionSignedIn" />
    </Grid>
</Window>
