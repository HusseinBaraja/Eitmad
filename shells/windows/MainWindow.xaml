<Window x:Class="Eitmad.WindowsShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الاعتماد · لوحة التحكم" Width="1338" Height="753" MinWidth="1080" MinHeight="608"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" FlowDirection="RightToLeft" Language="ar-YE"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="27" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,5,0,0" /></Style>
        <Style x:Key="SmallMuted" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
        <Style x:Key="NavText" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FlowDirection" Value="RightToLeft" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style x:Key="TableCell" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
            <Grid Width="1670" Height="939" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1377" /><ColumnDefinition Width="293" /></Grid.ColumnDefinitions>

                <!-- Main toolbar and dashboard -->
                <Grid Grid.Column="0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions><RowDefinition Height="108" /><RowDefinition Height="831" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="32,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="196" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DashboardTitle" Grid.Column="0" Text="لوحة التحكم" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" FlowDirection="LeftToRight" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="43" HorizontalAlignment="Stretch" Margin="0,0,16,0" CornerRadius="8" Background="#FEFDFC" BorderBrush="#E9E4DF" BorderThickness="1">
                                    <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Grid.Column="0" Data="{StaticResource IconSearch}" Style="{StaticResource ToolbarVectorIcon}" /><TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="13" Foreground="#8D8781" Padding="10,11,0,8" TextAlignment="Left" FlowDirection="RightToLeft" Text="ابحث عن عروض أسعار، عملاء، منتجات، أو أوامر عمل..." GotKeyboardFocus="SearchGotFocus" LostKeyboardFocus="SearchLostFocus" KeyDown="SearchKeyDown" /></Grid>
                                </Border>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Grid Margin="0,0,12,0"><Button Style="{StaticResource IconButton}" Tag="التنبيهات" Click="PreviewActionClick"><Path Data="{StaticResource IconBell}" Style="{StaticResource ToolbarVectorIcon}" /></Button><Border IsHitTestVisible="False" Background="#703A08" CornerRadius="10" MinWidth="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"><TextBlock Text="7" Foreground="White" FontSize="9" TextAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                                    <Grid Margin="0,0,12,0"><Button Style="{StaticResource IconButton}" Tag="الرسائل" Click="PreviewActionClick"><Path Data="{StaticResource IconMessage}" Style="{StaticResource ToolbarVectorIcon}" /></Button><Border IsHitTestVisible="False" Background="#703A08" CornerRadius="10" MinWidth="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"><TextBlock Text="3" Foreground="White" FontSize="9" TextAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                                    <Button Style="{StaticResource IconButton}" Tag="الملف الشخصي" Click="PreviewActionClick"><Path Data="{StaticResource IconProfile}" Style="{StaticResource ToolbarVectorIcon}" /></Button>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="2" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><Button Grid.Column="0" Width="180" Height="44" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Tag="عرض سعر جديد" Click="OpenPreviewPanelClick"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Data="{StaticResource IconPlus}" Width="20" Height="20" Fill="White" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="عرض سعر جديد" Foreground="White" FontSize="14" VerticalAlignment="Center" /></StackPanel></Button><Border x:Name="ToolbarGap" Grid.Column="1" Width="16" /></Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="32,17,46,6">
                        <Grid.RowDefinitions><RowDefinition Height="123" /><RowDefinition Height="15" /><RowDefinition Height="132" /><RowDefinition Height="14" /><RowDefinition Height="162" /><RowDefinition Height="14" /><RowDefinition Height="351" /></Grid.RowDefinitions>
                        <!-- Hero -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="405" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="9,0,0,9">
                                    <Border.Background><ImageBrush ImageSource="/Eitmad.WindowsShell;component/Resources/ShowroomHero.png" Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Center" /></Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="30,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="👋" FontSize="25" Margin="0,0,13,0" /><TextBlock Text="مرحباً، مدير النظام" FontSize="25" FontWeight="Bold" /></StackPanel>
                                    <TextBlock Text="إليك نظرة عامة على عمليات اليوم - تابع التقدم وراجع المهام الهامة." FontSize="14" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Metrics -->
                        <Grid Grid.Row="2" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="13" /><ColumnDefinition /><ColumnDefinition Width="13" /><ColumnDefinition /><ColumnDefinition Width="13" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="إجمالي المبيعات التقديرية" Style="{StaticResource MetricLabel}" /><TextBlock Text="1,245,780 ر.س" Style="{StaticResource MetricValue}" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBlock Text="↗ +12.6% عن أمس" Foreground="{StaticResource ForestBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Width="66" Height="66" CornerRadius="33" Background="{StaticResource CopperTintBrush}" VerticalAlignment="Center"><Path Data="{StaticResource IconTrend}" Style="{StaticResource MetricVectorIcon}" /></Border></Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="المنتجات النشطة" Style="{StaticResource MetricLabel}" /><TextBlock Text="128" Style="{StaticResource MetricValue}" /><TextBlock Text="منتج نشط" Style="{StaticResource SmallMuted}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Width="66" Height="66" CornerRadius="33" Background="{StaticResource CopperTintBrush}" VerticalAlignment="Center"><Path Data="{StaticResource IconProducts}" Style="{StaticResource MetricVectorIcon}" /></Border></Grid></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="22"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="طلبات قيد التنفيذ" Style="{StaticResource MetricLabel}" /><TextBlock Text="23" Style="{StaticResource MetricValue}" /><TextBlock Text="طلب" Style="{StaticResource SmallMuted}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Width="66" Height="66" CornerRadius="33" Background="{StaticResource CopperTintBrush}" VerticalAlignment="Center"><Path Data="{StaticResource IconWorkOrder}" Style="{StaticResource MetricVectorIcon}" /></Border></Grid></Border>
                            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="22"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="عروض الأسعار اليوم" Style="{StaticResource MetricLabel}" /><TextBlock Text="14" Style="{StaticResource MetricValue}" /><TextBlock Text="عرض سعر" Style="{StaticResource SmallMuted}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Width="66" Height="66" CornerRadius="33" Background="{StaticResource CopperTintBrush}" VerticalAlignment="Center"><Path Data="{StaticResource IconQuote}" Style="{StaticResource MetricVectorIcon}" /></Border></Grid></Border>
                        </Grid>

                        <!-- Quick actions -->
                        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="25,12">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="اختصارات سريعة" Style="{StaticResource SectionTitle}" />
                                <Grid Grid.Row="1" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource QuickActionButton}" Tag="الموافقات" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconTasks}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="الموافقات" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                    <Button Grid.Column="2" Style="{StaticResource QuickActionButton}" Tag="قائمة الأسعار" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconPricing}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="قائمة الأسعار" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                    <Button Grid.Column="4" Style="{StaticResource QuickActionButton}" Tag="إعداد الربح" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconTrend}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="إعداد الربح" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                    <Button Grid.Column="6" Style="{StaticResource QuickActionButton}" Tag="قوالب المنتجات" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconFurniture}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="قوالب المنتجات" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                    <Button Grid.Column="8" Style="{StaticResource QuickActionButton}" Tag="إدارة القطع" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconCut}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="إدارة القطع" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                    <Button Grid.Column="10" Style="{StaticResource QuickActionButton}" Tag="إدارة الخامات" Click="PreviewActionClick"><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconMaterials}" Style="{StaticResource MetricVectorIcon}" /><TextBlock Text="إدارة الخامات" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Bottom dashboard -->
                        <Grid Grid.Row="6" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="640" /><ColumnDefinition Width="14" /><ColumnDefinition Width="300" /><ColumnDefinition Width="14" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="38" /><RowDefinition Height="250" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid x:Name="LatestQuotesHeader" Margin="20,0" FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="آخر عروض الأسعار" Style="{StaticResource SectionTitle}" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" /><Border Grid.Column="1" Width="88" Height="31" BorderBrush="#DED8D2" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="عرض الكل" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                                <Grid Grid.Row="1" Background="#FAF9F7" FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="رقم العرض" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="العميل" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="المنتج" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="3" Text="الحالة" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="4" Text="الإجمالي" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="التاريخ" Style="{StaticResource TableCell}" /></Grid>
                                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Q-2025-0518" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="شركة ديكور المنزل" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="مطبخ مودرن خشب بلوط" Style="{StaticResource TableCell}" /><Border Grid.Column="3" Background="#EEF4FB" CornerRadius="8" Margin="10,9"><TextBlock Text="جديد" Foreground="#2369B4" Style="{StaticResource TableCell}" /></Border><TextBlock Grid.Column="4" Text="24,560 ر.س" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="2025/05/18" Style="{StaticResource TableCell}" /></Grid>
                                    <Grid Grid.Row="1" Background="#FCFBFA"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Q-2025-0517" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="أبواب الخليج" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="غرفة نوم كلاسيك" Style="{StaticResource TableCell}" /><Border Grid.Column="3" Background="#FFF2E4" CornerRadius="8" Margin="10,9"><TextBlock Text="قيد المراجعة" Foreground="#CA6813" Style="{StaticResource TableCell}" /></Border><TextBlock Grid.Column="4" Text="18,750 ر.س" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="2025/05/18" Style="{StaticResource TableCell}" /></Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Q-2025-0516" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="مؤسسة الواجهة" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="دولاب ملابس 6 أبواب" Style="{StaticResource TableCell}" /><Border Grid.Column="3" Background="#FFF5D9" CornerRadius="8" Margin="10,9"><TextBlock Text="بانتظار الموافقة" Foreground="#C68719" Style="{StaticResource TableCell}" /></Border><TextBlock Grid.Column="4" Text="32,900 ر.س" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="2025/05/17" Style="{StaticResource TableCell}" /></Grid>
                                    <Grid Grid.Row="3" Background="#FCFBFA"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Q-2025-0515" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="أحمد السليم" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="وحدة تلفاز حديثة" Style="{StaticResource TableCell}" /><Border Grid.Column="3" Background="#EAF7E9" CornerRadius="8" Margin="10,9"><TextBlock Text="مكتمل" Foreground="#2C8242" Style="{StaticResource TableCell}" /></Border><TextBlock Grid.Column="4" Text="15,300 ر.س" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="2025/05/17" Style="{StaticResource TableCell}" /></Grid>
                                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="118" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="93" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Q-2025-0514" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="1" Text="نورة العتيبي" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="2" Text="تسريحة مع مرآة" Style="{StaticResource TableCell}" /><Border Grid.Column="3" Background="#FDEAEA" CornerRadius="8" Margin="10,9"><TextBlock Text="مرفوض" Foreground="#D93434" Style="{StaticResource TableCell}" /></Border><TextBlock Grid.Column="4" Text="9,800 ر.س" Style="{StaticResource TableCell}" /><TextBlock Grid.Column="5" Text="2025/05/16" Style="{StaticResource TableCell}" /></Grid>
                                </Grid>
                                <Button Grid.Row="3" Content="عرض جميع عروض الأسعار  ←" Style="{StaticResource LinkButton}" Tag="جميع عروض الأسعار" Click="PreviewActionClick" Margin="18,8" VerticalAlignment="Center" />
                            </Grid></Border>

                            <Border x:Name="NotificationsCard" Grid.Column="2" Style="{StaticResource Card}"><Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="42" /></Grid.RowDefinitions><Grid Margin="18,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="31" /></Grid.ColumnDefinitions><TextBlock Text="تنبيهات ومهام" Style="{StaticResource SectionTitle}" FlowDirection="RightToLeft" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" /><Path Grid.Column="2" Data="{StaticResource IconBell}" Style="{StaticResource NotificationVectorIcon}" /></Grid>
                                <Grid Grid.Row="1" Margin="12,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconAlert}" Style="{StaticResource NotificationVectorIcon}" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" TextBlock.TextAlignment="Left" VerticalAlignment="Center"><TextBlock Text="خامات منخفضة" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="5 خامات وصلت للحد الأدنى" Style="{StaticResource SmallMuted}" /></StackPanel><Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource StatusDotBrush}" /></Grid>
                                <Grid Grid.Row="2" Margin="12,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconClock}" Style="{StaticResource NotificationVectorIcon}" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" TextBlock.TextAlignment="Left" VerticalAlignment="Center"><TextBlock Text="عروض أسعار بانتظار المراجعة" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="7 عروض أسعار تحتاج لمراجعتك" Style="{StaticResource SmallMuted}" /></StackPanel><Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource StatusDotBrush}" /></Grid>
                                <Grid Grid.Row="3" Margin="12,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconCalendar}" Style="{StaticResource NotificationVectorIcon}" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" TextBlock.TextAlignment="Left" VerticalAlignment="Center"><TextBlock Text="تركيبات مجدولة اليوم" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="3 تركيبات مجدولة" Style="{StaticResource SmallMuted}" /></StackPanel><Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource StatusDotBrush}" /></Grid>
                                <Grid Grid.Row="4" Margin="12,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CopperTintBrush}"><Path Data="{StaticResource IconWorkOrder}" Style="{StaticResource NotificationVectorIcon}" /></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" TextBlock.TextAlignment="Left" VerticalAlignment="Center"><TextBlock Text="أوامر عمل متأخرة" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="4 أوامر عمل تجاوزت التاريخ المحدد" Style="{StaticResource SmallMuted}" /></StackPanel><Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource StatusDotBrush}" /></Grid>
                                <Button Grid.Row="5" Content="عرض جميع التنبيهات  ←" Style="{StaticResource LinkButton}" Tag="جميع التنبيهات" Click="PreviewActionClick" Margin="18,0" VerticalAlignment="Center" />
                            </Grid></Border>

                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="37" /></Grid.RowDefinitions><StackPanel x:Name="WorkDistributionHeader" FlowDirection="RightToLeft" TextBlock.TextAlignment="Left"><TextBlock Text="توزيع الأعمال  ↗" Style="{StaticResource SectionTitle}" /><TextBlock Text="نسبة الإنجاز حسب القسم" Style="{StaticResource SmallMuted}" Margin="0,5,0,0" /></StackPanel>
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBlock Text="72%" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight" /><StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock FlowDirection="RightToLeft" TextAlignment="Left" HorizontalAlignment="Stretch" Text="نجارة الورشة" FontSize="12" /><ProgressBar FlowDirection="LeftToRight" Value="72" Maximum="100" Margin="0,6,0,0" /></StackPanel><Path Grid.Column="3" Data="{StaticResource IconCut}" Style="{StaticResource NotificationVectorIcon}" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBlock Text="58%" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight" /><StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock FlowDirection="RightToLeft" TextAlignment="Left" HorizontalAlignment="Stretch" Text="التشطيب" FontSize="12" /><ProgressBar FlowDirection="LeftToRight" Value="58" Maximum="100" Margin="0,6,0,0" /></StackPanel><Path Grid.Column="3" Data="{StaticResource IconMaterials}" Style="{StaticResource NotificationVectorIcon}" /></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBlock Text="85%" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight" /><StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock FlowDirection="RightToLeft" TextAlignment="Left" HorizontalAlignment="Stretch" Text="التركيبات" FontSize="12" /><ProgressBar FlowDirection="LeftToRight" Value="85" Maximum="100" Margin="0,6,0,0" /></StackPanel><Path Grid.Column="3" Data="{StaticResource IconWorkOrder}" Style="{StaticResource NotificationVectorIcon}" /></Grid>
                                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBlock Text="65%" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight" /><StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock FlowDirection="RightToLeft" TextAlignment="Left" HorizontalAlignment="Stretch" Text="التصميم" FontSize="12" /><ProgressBar FlowDirection="LeftToRight" Value="65" Maximum="100" Margin="0,6,0,0" /></StackPanel><Path Grid.Column="3" Data="{StaticResource IconFurniture}" Style="{StaticResource NotificationVectorIcon}" /></Grid>
                                <Button Grid.Row="5" Content="عرض تفاصيل سير العمل  ←" Style="{StaticResource LinkButton}" Tag="تفاصيل سير العمل" Click="PreviewActionClick" HorizontalContentAlignment="Left" VerticalAlignment="Bottom" />
                            </Grid></Border>
                        </Grid>

                    </Grid>
                    <Border x:Name="InteractionPanel" Grid.Row="1" Width="390" Margin="0,24,28,24" HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="30" Visibility="Collapsed" Background="White" BorderBrush="#D8C5B1" BorderThickness="1" CornerRadius="14" Padding="25">
                        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#3B210E" /></Border.Effect>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
