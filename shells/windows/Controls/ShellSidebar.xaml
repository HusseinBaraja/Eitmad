<UserControl x:Class="Eitmad.WindowsShell.Controls.ShellSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             FlowDirection="RightToLeft"
             Language="ar-YE">
    <UserControl.Resources>
        <Style x:Key="SidebarNavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ManagerOnlyNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReceptionist, RelativeSource={RelativeSource AncestorType=controls:ShellSidebar}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Sidebar" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="258" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}"><Setter Property="Width" Value="224" /></DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Width" Value="78" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="77" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" FlowDirection="LeftToRight">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="31,0,23,7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Standard}"><Setter Property="Margin" Value="16,0,12,7" /></DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Margin" Value="3,0,3,7" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="64" Height="51" VerticalAlignment="Center" Stretch="Uniform">
                    <Canvas Width="76" Height="62">
                        <Path Fill="#4B260B" Data="M 4,50 L 21,8 L 34,50 L 23,42 L 17,60 Z" /><Path Fill="#8A572A" Data="M 23,50 L 39,1 L 51,50 L 40,42 L 33,61 Z" /><Path Fill="#B08051" Data="M 44,50 L 59,12 L 73,50 L 61,43 L 55,61 Z" />
                        <Path Fill="#D2AA7E" Data="M 21,8 L 23,42 L 34,50 Z" /><Path Fill="#6B3A16" Data="M 39,1 L 40,42 L 51,50 Z" /><Path Fill="#70421D" Data="M 59,12 L 61,43 L 73,50 Z" />
                    </Canvas>
                </Viewbox>
                <Grid Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="الاعتماد" FontSize="28" FontWeight="Bold" Foreground="#704019" HorizontalAlignment="Left" TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="لصناعة الأثاث" FontSize="12" Foreground="#704019" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,-2,2,0" />
                </Grid>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel x:Name="SidebarNavigation" Margin="0,16,0,8">
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Tag="الرئيسية" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="الرئيسية" FontWeight="SemiBold" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconHome}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="QuotationsNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="عروض الأسعار" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="عروض الأسعار" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconQuote}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="OrdersNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="الطلبات" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="الطلبات" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconOrder}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="MaterialsNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="الخامات" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="الخامات" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconMaterials}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="PartsNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="القطع" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="القطع" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconCut}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="FurnitureNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="الأثاث" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="الأثاث" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconFurniture}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="PricingNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="التسعير" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="التسعير" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconPricing}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="ProductsNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="المنتجات" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="المنتجات" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconProducts}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="WorkOrdersNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="أوامر العمل" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="أوامر العمل" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconWorkOrder}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button Style="{StaticResource ManagerOnlyNavButton}" Tag="المهام" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="المهام" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconTasks}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button Style="{StaticResource ManagerOnlyNavButton}" Tag="التقارير" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="التقارير" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconReports}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button x:Name="UsersNavButton" Style="{StaticResource ManagerOnlyNavButton}" Tag="المستخدمون" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="المستخدمون" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconUsers}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                    <Button Style="{StaticResource ManagerOnlyNavButton}" Tag="الإعدادات" Click="NavigationClick"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="الإعدادات" Style="{StaticResource SidebarNavText}" /><Path Grid.Column="2" Data="{StaticResource IconSettings}" Style="{StaticResource NavVectorIcon}" /></Grid></Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
