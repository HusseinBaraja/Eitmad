<UserControl x:Class="Eitmad.WindowsShell.Controls.DiagnosticReportButton"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" Language="ar-YE">
 <DockPanel LastChildFill="True" Margin="12,6">
  <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="تنزيل السجلات" Click="SaveClick"
   Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="تنزيل تقرير السجلات إلى مجلد التنزيلات"/>
  <Button x:Name="OpenDownloadsButton" DockPanel.Dock="Right" Content="فتح التنزيلات" Click="OpenDownloadsClick"
   Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="فتح مجلد التنزيلات للوصول إلى تقرير السجلات"/>
  <TextBlock x:Name="Notice" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0" FontSize="12"
   AutomationProperties.LiveSetting="Polite"/>
 </DockPanel>
</UserControl>
