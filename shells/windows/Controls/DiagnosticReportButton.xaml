<UserControl x:Class="Eitmad.WindowsShell.Controls.DiagnosticReportButton"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" Language="ar-YE">
 <!-- A slim native status bar: support actions stay reachable on every screen without taking work space. -->
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
  <DockPanel LastChildFill="True" Margin="12,2">
   <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="تنزيل السجلات" Click="SaveClick"
    Style="{DynamicResource DropdownActionButton}" MinHeight="28" Padding="8,2" FontSize="12"
    AutomationProperties.Name="تنزيل تقرير السجلات إلى مجلد التنزيلات"/>
   <Button x:Name="OpenDownloadsButton" DockPanel.Dock="Right" Content="فتح التنزيلات" Click="OpenDownloadsClick"
    Style="{DynamicResource DropdownActionButton}" MinHeight="28" Padding="8,2" FontSize="12" Margin="4,0,0,0" Visibility="Collapsed"
    AutomationProperties.Name="فتح مجلد التنزيلات للوصول إلى تقرير السجلات"/>
   <TextBlock x:Name="Notice" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0" FontSize="12"
    Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Border>
</UserControl>
