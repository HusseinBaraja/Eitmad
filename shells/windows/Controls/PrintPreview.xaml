<UserControl x:Class="Eitmad.WindowsShell.Controls.PrintPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Language="ar-YE">
 <UserControl.Resources>
  <Style x:Key="PreviewAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style x:Key="PreviewIcon" TargetType="Button" BasedOn="{StaticResource PreviewAction}">
   <Setter Property="Width" Value="36"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style x:Key="PreviewArrow" TargetType="Path">
   <Setter Property="Width" Value="14"/>
   <Setter Property="Height" Value="14"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="FlowDirection" Value="LeftToRight"/>
   <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
  <!-- Retain WPF's native search items and handlers, without toolbar grippers or overflow chrome. -->
  <ControlTemplate x:Key="PreviewSearchBar" TargetType="ToolBar">
   <Border Background="{TemplateBinding Background}" Padding="12,8"><ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True"/></Border>
  </ControlTemplate>
 </UserControl.Resources>
 <DockPanel Background="{DynamicResource CanvasBrush}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,12,12,6">
   <StackPanel>
    <WrapPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
      <Button x:Name="PrintButton" IsEnabled="False" Content="طباعة" ToolTip="طباعة المستند" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,6" Click="PrintClick" AutomationProperties.Name="طباعة"/>
      <Button x:Name="BackButton" Content="رجوع" Style="{StaticResource PreviewAction}" Click="BackClick" AutomationProperties.Name="رجوع"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
      <Button Tag="الصفحة الأولى" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.FirstPage" CommandTarget="{Binding ElementName=Pages}"><Path Style="{StaticResource PreviewArrow}" Data="M4,3 11,9 4,15Z M12,3 14,3 14,15 12,15Z"/></Button>
      <Button Tag="الصفحة السابقة" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.PreviousPage" CommandTarget="{Binding ElementName=Pages}"><Path Style="{StaticResource PreviewArrow}" Data="M4,3 12,9 4,15Z"/></Button>
      <TextBlock Text="صفحة" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBlock Text="{Binding MasterPageNumber, ElementName=Pages}" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBlock Text="{Binding PageCount, ElementName=Pages}" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <Button Tag="الصفحة التالية" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.NextPage" CommandTarget="{Binding ElementName=Pages}"><Path Style="{StaticResource PreviewArrow}" Data="M12,3 4,9 12,15Z"/></Button>
      <Button Tag="الصفحة الأخيرة" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.LastPage" CommandTarget="{Binding ElementName=Pages}"><Path Style="{StaticResource PreviewArrow}" Data="M12,3 5,9 12,15Z M2,3 4,3 4,15 2,15Z"/></Button>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
      <Button Content="−" Tag="تصغير" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.DecreaseZoom" CommandTarget="{Binding ElementName=Pages}"/>
      <TextBlock Text="{Binding Zoom, ElementName=Pages, StringFormat={}{0:0}%}" FlowDirection="LeftToRight" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <Button Content="+" Tag="تكبير" Style="{StaticResource PreviewIcon}" Command="NavigationCommands.IncreaseZoom" CommandTarget="{Binding ElementName=Pages}"/>
     </StackPanel>
     <Button Content="عرض الصفحة" Style="{StaticResource PreviewAction}" Command="DocumentViewer.FitToWidthCommand" CommandTarget="{Binding ElementName=Pages}"/>
     <Button Content="صفحة كاملة" Style="{StaticResource PreviewAction}" Command="DocumentViewer.FitToHeightCommand" CommandTarget="{Binding ElementName=Pages}"/>
     <Button Content="صفحتان" Style="{StaticResource PreviewAction}" Command="DocumentViewer.FitToMaxPagesAcrossCommand" CommandParameter="2" CommandTarget="{Binding ElementName=Pages}"/>
     <Button Content="مصغرات" Style="{StaticResource PreviewAction}" Command="DocumentViewer.ViewThumbnailsCommand" CommandTarget="{Binding ElementName=Pages}"/>
     <Button Content="بحث" Style="{StaticResource PreviewAction}" Command="ApplicationCommands.Find" CommandTarget="{Binding ElementName=Pages}"/>
    </WrapPanel>
    <TextBlock x:Name="PrintStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
       <Setter Property="Margin" Value="0,2,0,6"/>
       <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Border>
  <DocumentViewer x:Name="Pages" Background="{DynamicResource CanvasBrush}" AutomationProperties.Name="معاينة المستند">
   <DocumentViewer.ContextMenu>
    <ContextMenu FlowDirection="RightToLeft" Language="ar-YE">
     <MenuItem Header="نسخ" Command="ApplicationCommands.Copy"/>
     <MenuItem Header="تحديد الكل" Command="ApplicationCommands.SelectAll"/>
     <MenuItem Header="بحث" Command="ApplicationCommands.Find"/>
    </ContextMenu>
   </DocumentViewer.ContextMenu>
   <DocumentViewer.Template>
    <ControlTemplate TargetType="DocumentViewer">
     <DockPanel Background="{TemplateBinding Background}">
      <ContentControl x:Name="PART_FindToolBarHost" DockPanel.Dock="Bottom" Focusable="False" Loaded="NativeSearchLoaded"/>
      <ScrollViewer x:Name="PART_ContentHost" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"/>
     </DockPanel>
    </ControlTemplate>
   </DocumentViewer.Template>
  </DocumentViewer>
 </DockPanel>
</UserControl>
