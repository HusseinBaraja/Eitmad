<UserControl x:Class="Eitmad.WindowsShell.Controls.PrintPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Language="ar-YE">
 <DockPanel Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <StackPanel DockPanel.Dock="Top" Margin="20,12">
   <WrapPanel>
    <Button x:Name="PrintButton" Content="طباعة" Style="{DynamicResource PrimaryButton}" Click="PrintClick" AutomationProperties.Name="طباعة"/>
    <Button Content="رجوع" Style="{DynamicResource SecondaryButton}" Margin="12,0,0,0" Click="BackClick" AutomationProperties.Name="رجوع"/>
   </WrapPanel>
   <TextBlock x:Name="PrintStatus" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
  </StackPanel>
  <FlowDocumentPageViewer x:Name="Pages" AutomationProperties.Name="معاينة المستند"/>
 </DockPanel>
</UserControl>
