<UserControl x:Class="Eitmad.WindowsShell.Controls.ShellTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             FlowDirection="RightToLeft"
             Language="ar-YE">
    <Border Height="{StaticResource PageHeaderHeight}" Background="#FEFDFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid x:Name="ToolbarLayout" Margin="28,16" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Grid.Column" Value="3" />
                        <Setter Property="FontSize" Value="{StaticResource PageHeaderTitleSize}" />
                        <Setter Property="Margin" Value="20,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Margin" Value="16,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Height="43" HorizontalAlignment="Stretch" CornerRadius="8" Background="#FEFDFC" BorderBrush="#E9E4DF" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Margin" Value="20,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="4" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" MinHeight="0" Background="Transparent" BorderThickness="0" FontFamily="Noto Kufi Arabic, Segoe UI" FontSize="13" Padding="10,11,0,8" TextAlignment="Left" FlowDirection="RightToLeft" controls:ControlOptions.Placeholder="{Binding SearchPlaceholder, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" automation:AutomationProperties.Name="البحث في الاعتماد" KeyDown="SearchKeyDown" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Grid Margin="0,0,12,0">
                    <Button Style="{StaticResource IconButton}" Tag="التنبيهات" Click="ActionClick">
                        <Path Data="{StaticResource IconBell}" Style="{StaticResource ToolbarVectorIcon}" />
                    </Button>
                    <Border IsHitTestVisible="False" Background="#703A08" CornerRadius="10" MinWidth="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                        <TextBlock Text="7" Foreground="White" FontSize="9" TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,12,0">
                    <Button Style="{StaticResource IconButton}" Tag="الرسائل" Click="ActionClick">
                        <Path Data="{StaticResource IconMessage}" Style="{StaticResource ToolbarVectorIcon}" />
                    </Button>
                    <Border IsHitTestVisible="False" Background="#703A08" CornerRadius="10" MinWidth="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                        <TextBlock Text="3" Foreground="White" FontSize="9" TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button x:Name="SwitchAccountButton" Style="{StaticResource IconButton}" Tag="{Binding SwitchAccountHint, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Click="SwitchAccountClick" automation:AutomationProperties.Name="{Binding SwitchAccountHint, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}">
                    <Path Data="{StaticResource IconUsers}" Style="{StaticResource ToolbarVectorIcon}" />
                </Button>
            </StackPanel>
            <Button x:Name="PrimaryActionButton" Grid.Column="0" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Tag="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Click="PrimaryActionClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Width" Value="180" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Width" Value="48" />
                                <Setter Property="Padding" Value="12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Path Data="{StaticResource IconPlus}" Width="20" Height="20" Fill="White" Stretch="Uniform" />
                    <TextBlock x:Name="PrimaryActionText" Text="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
