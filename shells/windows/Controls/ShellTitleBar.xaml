<UserControl x:Class="Eitmad.WindowsShell.Controls.ShellTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls"
             xmlns:layout="clr-namespace:Eitmad.WindowsShell.Layout"
             FlowDirection="RightToLeft"
             Language="ar-YE">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MinHeight="64">
        <Grid x:Name="ToolbarLayout" Margin="24,12" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Grid.Column" Value="3" />
                        <Setter Property="FontSize" Value="{StaticResource ShellTitleSize}" />
                        <Setter Property="Margin" Value="20,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Margin" Value="16,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Height="38" MaxWidth="560" HorizontalAlignment="Stretch" CornerRadius="6" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Margin" Value="20,0,0,0" />
                        <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="4" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" MinHeight="0" Background="Transparent" BorderThickness="0" FontSize="{StaticResource FontSizeBody}" Padding="10,0,0,0" VerticalContentAlignment="Center" TextAlignment="Left" FlowDirection="RightToLeft" controls:ControlOptions.Placeholder="{Binding SearchPlaceholder, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" automation:AutomationProperties.Name="البحث في الاعتماد" KeyDown="SearchKeyDown" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Grid Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}" Tag="التنبيهات" Click="ActionClick" automation:AutomationProperties.Name="الموافقات والطلبات الجاهزة">
                        <Path Data="{StaticResource IconBell}" Style="{StaticResource ToolbarVectorIcon}" />
                    </Button>
                    <Border IsHitTestVisible="False" Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource PanelBrush}" BorderThickness="2" CornerRadius="9" MinWidth="18" Height="18" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
                        <TextBlock Text="{Binding ApprovalCount, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="الرسائل غير متاحة" automation:AutomationProperties.Name="الرسائل غير متاحة" Tag="الرسائل" Click="ActionClick">
                        <Path Data="{StaticResource IconMessage}" Style="{StaticResource ToolbarVectorIcon}" />
                    </Button>
                </Grid>
                <Button x:Name="SwitchAccountButton" Content="تبديل الحساب" controls:ControlOptions.Icon="{StaticResource IconSwitchAccount}" Tag="{Binding SwitchAccountHint, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Click="SwitchAccountClick" automation:AutomationProperties.Name="{Binding SwitchAccountHint, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                    <Setter Property="Width" Value="38" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="controls:ControlOptions.ShowText" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip FlowDirection="RightToLeft" Language="ar-YE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="تسجيل الخروج لتبديل الحساب" />
                                <TextBlock Text="Alt+K" FlowDirection="LeftToRight" Margin="12,0,0,0" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
            <Button x:Name="PrimaryActionButton" Grid.Column="0" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Tag="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Click="PrimaryActionClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="MinWidth" Value="150" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(layout:ResponsiveLayout.Mode)}" Value="{x:Static layout:ResponsiveLayoutMode.Compact}">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Padding" Value="12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Path Data="{Binding PrimaryActionIcon, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Width="17" Height="17" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="PrimaryActionText" Text="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Foreground="White" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock x:Name="PrimaryActionCountText" Text="{Binding PrimaryActionCount, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}, StringFormat='({0})'}" FlowDirection="LeftToRight" Foreground="White" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="عدد بنود عرض السعر">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryActionCount, RelativeSource={RelativeSource AncestorType=controls:ShellTitleBar}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
