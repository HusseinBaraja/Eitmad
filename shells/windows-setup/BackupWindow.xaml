<Window x:Class="Eitmad.WindowsSetup.BackupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Eitmad.WindowsShell.Controls;assembly=Eitmad.WindowsShell"
 Title="النسخ الاحتياطي · الاعتماد" Width="1338" Height="753" MinWidth="720" MinHeight="560"
 WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Language="ar-YE"
 Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="النسخ الاحتياطي" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button x:Name="RefreshButton" Grid.Column="1" Content="تحديث الحالة" Style="{StaticResource SecondaryButton}" Click="RefreshClick" AutomationProperties.Name="تحديث حالة النسخ الاحتياطي بموافقة مسؤول Windows"/>
  </Grid>
  <ScrollViewer x:Name="BackupScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="900" Margin="0,0,0,12">
    <TextBlock Text="إدارة نسخ خادم الورشة على هذا الجهاز. تتطلب القراءة والتغييرات موافقة مسؤول Windows؛ حساب مالك المنشأة لا يمنح هذه الصلاحية." Margin="0,0,0,16"/>
    <TextBlock x:Name="Notice" Text="اضغط تحديث الحالة لقراءة النتيجة من الخادم." FontSize="14" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,16"/>
    <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="تنفيذ إجراء النسخ الاحتياطي" Margin="0,0,0,12"/>
    <StackPanel x:Name="StatePanel" Visibility="Collapsed">
     <Border BorderBrush="{DynamicResource CopperBrush}" BorderThickness="4,0,0,0" Padding="16,4" Margin="0,0,0,18">
      <StackPanel>
       <TextBlock Text="آخر التقاط ناجح" FontSize="15"/>
       <TextBlock x:Name="LastCapture" FontSize="25" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,6,0,6"/>
       <TextBlock x:Name="ProtectionText"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="حالة النسخ والجدولة" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
       <TextBlock Text="النسخة المحلية" FontWeight="Bold"/>
       <TextBlock x:Name="LocalStatus" Margin="0,4,0,12"/>
       <TextBlock Text="النسخة الخارجية" FontWeight="Bold"/>
       <TextBlock x:Name="ExternalStatus" Margin="0,4,0,12"/>
       <TextBlock x:Name="ExternalCapture" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,12"/>
       <TextBlock Text="الجدولة التلقائية" FontWeight="Bold"/>
       <TextBlock x:Name="ScheduleStatus" Margin="0,4,0,8"/>
       <TextBlock x:Name="PolicyText"/>
       <TextBlock Text="موعد الالتقاط التالي" Margin="0,6,0,0"/>
       <TextBlock x:Name="DueText" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,4,0,0"/>
       <Button x:Name="ScheduleButton" Content="إصلاح الجدولة" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="ScheduleClick" AutomationProperties.Name="طلب إصلاح الجدولة بموافقة مسؤول Windows"/>
      </StackPanel>
     </Border>
     <Expander Header="تغيير وجهات النسخ" IsExpanded="False" AutomationProperties.Name="تغيير وجهات النسخ الاحتياطي">
      <StackPanel x:Name="DestinationPanel" Margin="0,12,0,16">
       <TextBlock Text="اختر مجلدًا محميًا على قرص NTFS مشفّر ومفتوح. يجب أن يكون القرص الخارجي قرصًا فعليًا مختلفًا. يفحص الخادم الوجهات قبل الحفظ." Margin="0,0,0,12"/>
       <controls:FormField Label="مجلد النسخة المحلية"><TextBox x:Name="LocalDestination" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" AutomationProperties.Name="مسار مجلد النسخة المحلية"/></controls:FormField>
       <controls:FormField Label="مجلد النسخة الخارجية · اختياري" Margin="0,12,0,0"><TextBox x:Name="ExternalDestination" Style="{StaticResource TextInput}" FlowDirection="LeftToRight" AutomationProperties.Name="مسار مجلد النسخة الخارجية، اتركه فارغًا لإلغاء الوجهة"/></controls:FormField>
       <TextBlock Text="تبقى الأجيال السابقة في وجهاتها. تغيير الوجهة لا ينقلها ولا يحذفها. تحتاج الوجهة الجديدة إلى نسخة ناجحة جديدة." Margin="0,10,0,12"/>
       <Button x:Name="SaveButton" Content="حفظ الوجهات" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="SaveClick" AutomationProperties.Name="فحص وحفظ وجهات النسخ بموافقة مسؤول Windows"/>
      </StackPanel>
     </Expander>
    </StackPanel>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
     <StackPanel>
      <TextBlock Text="النسخة على القرص نفسه لا تحمي من تلف القرص." FontWeight="Bold"/>
      <TextBlock Text="نجاح الالتقاط وفحص الملفات لا يثبت نجاح الاستعادة. اختبر الاستعادة في بيئة معزولة وفق دليل الاسترداد. نسخ الخادم لا تشمل العمل غير المرسل وهويات أجهزة الموظفين." Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,14,0,0">
   <Button x:Name="CaptureButton" Content="إنشاء نسخة الآن" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="CaptureClick" AutomationProperties.Name="إنشاء نسخة احتياطية الآن بموافقة مسؤول Windows"/>
   <TextBlock Text="اترك النافذة مفتوحة حتى تظهر النتيجة." VerticalAlignment="Center" Margin="14,6,0,6"/>
  </WrapPanel>
 </Grid>
</Window>
